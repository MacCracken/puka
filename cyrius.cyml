[package]
name = "puka"
version = "${file:VERSION}"
description = "puka — sovereign Cyrius-native terminal emulator (Ghostty-class: VT/escape parser, cell grid, scrollback, font raster). Hawaiian: opening/doorway into the machine. Foundation for a future worktree coding-agent command center."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.5.5"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "puka"

[deps]
# Base set + the extras mabda's amalgam needs (args/hashmap/tagged/fnptr/mmap/
# dynlib/sakshi) so `dist/mabda.cyr` resolves its stdlib globals (MAP_SHARED,
# O_RDWR, the Result/fnptr types, the GTT mmap helpers, sakshi logging).
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "args", "hashmap", "tagged", "fnptr", "mmap", "dynlib", "sakshi", "result", "net", "chrono"]

# kashi — AGNOS console-font subsystem. M3 sources bitmap glyphs from its
# FREESTANDING font-data core only (zero stdlib: store8/load8 + arithmetic).
# Pinned git dep on the v1.0.2 tag (kashi's 1.x API is frozen; 1.0.2 tracks the
# 6.2.22 language), so `cyrius deps` resolves it identically on a devbox and in CI
# — no sibling checkout required. The full library face (PSF/BDF/PCF loaders) is
# deliberately NOT pulled in; the built-in CP437 fonts (VGA 8x16 / CGA 8x8 /
# VGA 9x16) cover the renderer's needs.
[deps.kashi]
git     = "https://github.com/MacCracken/kashi.git"
tag     = "1.0.4"
modules = ["src/font_data.cyr"]

# mabda — sovereign GPU foundation crate (native AMD GFX9 backend; the wgpu FFI
# backend is FORBIDDEN). M6 bite 7: GPU plumbing (context → offscreen render
# target → CPU readback → wl_shm present). Pinned to 3.2.11 (texture sampling +
# the SPIR-V→GFX9 compiler are HW-verified on Cezanne at this tag). The amalgam
# `dist/mabda.cyr` resolves to lib/mabda.cyr; consume only the @public gpu_* API.
[deps.mabda]
git     = "https://github.com/MacCracken/mabda.git"
tag     = "3.2.11"
modules = ["dist/mabda.cyr"]

# setu — the AGNOS native display-protocol + its reference CLIENT transport. The
# sovereign replacement for the Wayland windowing backend: puka's win_* seam
# (src/platform/setu/window_setu.cyr) fills the identical contract over setu's
# persistent client (setu_client_*), so the terminal engine runs unchanged and
# puka becomes the compositor's first resident app. Pinned to the 0.3.0 tag (the
# CROSS-PLATFORM TCP transport — item 3b; puka ↔ aethersafha proven e2e over TCP
# loopback:7700 on Linux). Consume the dist.
# ⛔ RETIRED 2026-08-03 — TCP-on-loopback is the WRONG PRIMITIVE for local display IPC, and that,
# not a failure, is why it is gone. Scope: "and the same wire now runs on agnos" was NOT YET TRUE
# when written — before `net_src_for` (agnos 1.56.34) the handshake could not complete on an
# ordinary boot, and the one passing test of that era ran under the `AETHERSAFHA_SETU_SELFTEST`
# kernel hook (`net_ip = 0x7F000001`); hook and smoke are deleted. After `net_src_for` it DID
# connect and present un-rigged (2026-08-02, `aethersafha-clients-test.py`, "connected: 2,
# presented: 2", one client being `/bin/puka` — QEMU `-smp 1`, never on iron). Replacement is the
# agnos socket (`anu`), agnos `docs/development/planning/ipc.md` §9/§10. The Linux e2e stands
# independently; Linux is a different target.
[deps.setu]
git     = "https://github.com/MacCracken/setu.git"
tag     = "0.7.4"
modules = ["dist/setu.cyr"]
---
