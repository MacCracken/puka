[package]
name = "puka"
version = "${file:VERSION}"
description = "puka — sovereign Cyrius-native terminal emulator (Ghostty-class: VT/escape parser, cell grid, scrollback, font raster). Hawaiian: opening/doorway into the machine. Foundation for a future worktree coding-agent command center."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "puka"

# `cyrius distlib` -> dist/puka.cyr, the embeddable terminal engine. Order is src/main.cyr's include order.
[lib]
modules = [
    "src/parser.cyr",
    "src/grid.cyr",
    "src/unicode.cyr",
    "src/terminal.cyr",
    "src/render/pixfmt.cyr",
    "src/render/atlas.cyr",
    "src/render/fb.cyr",
]

# Why each dependency is declared the way it is, and why mabda is not: docs/architecture/001-dependencies.md
# `path` is a dev override: uncomment one and build with CYRIUS_LOCAL=<name> to use an unpushed sibling.
[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "args", "hashmap", "tagged", "fnptr", "result", "net", "chrono"]

# The engine bundle needs kashi and nothing else; the rest is the app half. `app` is on by default, so
# every build resolves everything. Regenerate dist/ with `cyrius distlib --no-default-features`: see
# "`dist/puka.cyr` needs kashi" in docs/architecture/001-dependencies.md for what a plain run breaks.
[features]
default = ["app"]
app = ["setu", "dhancha", "sadish", "rupa", "rekha"]

[deps.kashi]
git = "https://github.com/MacCracken/kashi.git"
# path = "../kashi"
tag = "1.3.0"
# The freestanding core, not the library face: docs/adr/0004-kashi-freestanding-core-over-library-face.md
modules = ["src/font_data.cyr"]

[deps.setu]
optional = true
git = "https://github.com/MacCracken/setu.git"
# path = "../setu"
tag = "0.9.1"
modules = ["dist/setu.cyr"]

[deps.dhancha]
optional = true
git = "https://github.com/MacCracken/dhancha.git"
# path = "../dhancha"
tag = "0.10.4"
modules = ["dist/dhancha.cyr"]

# puka calls none of the next three. dhancha 0.10.4 declares them, and puka's tags override its tags:
# dhancha has no tag on puka's cyrius pin, and each of these does. Drop all three when dhancha catches up.
[deps.sadish]
optional = true
git = "https://github.com/MacCracken/sadish.git"
# path = "../sadish"
tag = "0.12.1"
modules = ["dist/sadish.cyr"]

[deps.rupa]
optional = true
git = "https://github.com/MacCracken/rupa.git"
# path = "../rupa"
tag = "0.2.1"
modules = ["dist/rupa.cyr"]

[deps.rekha]
optional = true
git = "https://github.com/MacCracken/rekha.git"
# path = "../rekha"
tag = "1.1.2"
modules = ["dist/rekha.cyr"]
