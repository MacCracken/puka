# --- error.cyr ---

# @public — stable API surface for dhancha error handling.
# error.cyr — dhancha widget-toolkit error codes + Result helpers.
#
# DhanchaErr is a 16-byte record: a consumer (a desktop app, or a
# higher toolkit layer) can map a toolkit failure cleanly onto its own
# error domain. Error codes are integer constants; for errors that
# carry context (a message pointer), use dhancha_err_new(code, msg).
#
# DhanchaErr struct layout (16 bytes):
#   +0: code    — error code constant (one of the DHANCHA_* below)
#   +8: detail  — pointer to detail string (or 0)

# ================================================================
# Error code constants
# ================================================================

enum DhanchaErrCode {
    DHANCHA_OK              = 0;   # no error
    DHANCHA_ERR_OOM        = 1;   # allocation failed
    DHANCHA_ERR_BAD_WIDGET = 2;   # null / malformed widget handle or kind
    DHANCHA_ERR_NO_SURFACE = 3;   # no client surface / present target
    DHANCHA_ERR_LAYOUT     = 4;   # layout measure/arrange could not resolve
    DHANCHA_ERR_UNSUPPORTED = 5;  # valid request dhancha can't service yet
    # ⚠ 0.9.17 — added for `dh_surface_resize`, which must distinguish "no surface" from "a surface,
    # and a size that is not a size". Folding a degenerate extent into `_NO_SURFACE` would tell a
    # caller to check its handle when the handle was fine.
    DHANCHA_ERR_BAD_ARG    = 6;   # a well-formed call carrying an out-of-range value
    DHANCHA_ERR_OTHER      = 99;  # catch-all
}

# ================================================================
# DhanchaErr struct
# ================================================================

# Create a DhanchaErr with code and an optional detail string (0 = none).
fn dhancha_err_new(code, detail): i64 {
    var e = alloc(16);
    store64(e, code);
    store64(e + 8, detail);
    return e;
}

# Create a DhanchaErr with code only (no detail).
fn dhancha_err(code): i64 {
    return dhancha_err_new(code, 0);
}

# Get the error code.
fn dhancha_err_code(e): i64 {
    return load64(e);
}

# Get the detail string pointer (or 0).
fn dhancha_err_detail(e): i64 {
    return load64(e + 8);
}

# ================================================================
# Error name lookup — returns a cstring (never null).
# ================================================================

fn dhancha_err_name(code): i64 {
    if (code == DHANCHA_OK)              { return "ok"; }
    if (code == DHANCHA_ERR_OOM)         { return "out of memory"; }
    if (code == DHANCHA_ERR_BAD_WIDGET)  { return "bad widget"; }
    if (code == DHANCHA_ERR_NO_SURFACE)  { return "no surface"; }
    if (code == DHANCHA_ERR_LAYOUT)      { return "layout failed"; }
    if (code == DHANCHA_ERR_UNSUPPORTED) { return "unsupported feature"; }
    if (code == DHANCHA_ERR_BAD_ARG)     { return "bad argument"; }
    if (code == DHANCHA_ERR_OTHER)       { return "other error"; }
    return "unknown error";
}

# Print an error name to stderr (fd 2).
fn dhancha_err_print_name(code): i64 {
    var name = dhancha_err_name(code);
    syscall(1, 2, name, strlen(name));
    return 0;
}

# --- widget.cyr ---

# @public — dhancha widget-tree model.
# widget.cyr — DhWidget: the retained-mode widget node.
#
# A DhWidget is the unit of the UI tree. Nodes form a first-child /
# next-sibling tree (the classic space-efficient n-ary tree encoding),
# so a parent holds one child pointer and children chain via siblings.
# Layout (layout.cyr) walks the tree to assign bounds; event dispatch
# (event.cyr) hit-tests it; the surface (surface.cyr) draws it.
#
# DhWidget struct layout (288 bytes, 36 u64 slots — see `DH_WIDGET_SIZE` below):
# ⚠ THIS HEADER READ "144 bytes, 18 u64 slots" UNTIL 0.9.22 while the field list below it already
# ran past +168. It contradicted itself and understated the record by 112 bytes, which is exactly
# how a reader sizing a NEW field off the header picks an offset that collides with a live one.
# ⇒ Re-derive it from the enum, not from this line, and update it when the enum grows.
#   +0:   id            — monotonic widget id (debug / focus routing)
#   +8:   kind          — one of DhWidgetKind
#   +16:  x             — resolved x (layout output)
#   +24:  y             — resolved y
#   +32:  w             — resolved width
#   +40:  h             — resolved height
#   +48:  parent        — parent DhWidget* (0 = root)
#   +56:  first_child   — first child DhWidget* (0 = leaf)
#   +64:  next_sibling  — next sibling under the same parent (0 = last)
#   +72:  layout        — DhLayout mode applied to this node's children
#   +80:  bg            — background color 0x00RRGGBB, or -1 = none
#   +88:  text          — cstring ptr for LABEL / BUTTON, or 0
#   +96:  pref_w        — requested width (layout hint)
#   +104: pref_h        — requested height
#   +112: handler       — bubble-phase handler fnptr `handler(wgt, ev) -> consumed`, or 0
#   +120: userdata      — opaque app context the handler reads back, or 0
#   +128: capture_h     — capture-phase handler fnptr (fires root->target first), or 0
#   +136: flags         — bitmask: DH_FLAG_DRAGGABLE | DH_FLAG_DROP_TARGET
#   +144: flex          — flex weight for BOX layout (0 = fixed, use pref size)
#   +152: pad           — uniform padding inside this container (px)
#   +160: gap           — spacing between this container's children (px)
#   +168: align         — cross-axis align-self (DhAlign; 0 = STRETCH)

enum DhWidgetKind {
    WINDOW    = 0;
    BOX       = 1;
    LABEL     = 2;
    BUTTON    = 3;
    TEXTINPUT = 4;
    LIST      = 5;   # ⭐ 0.9.7 — a SCROLLING, SELECTABLE container. See list.cyr.
    CANVAS    = 6;   # ⭐ 0.9.9 — APP-DRAWN content in a widget-tree slot. See canvas.cyr.
    PROGRESS  = 7;   # ⭐ 0.9.22 — a DETERMINATE-or-INDETERMINATE bar. See progress.cyr.
    # ⭐⭐ 0.9.25 — a WRAPPING, SELECTABLE grid of fixed-size cells. See grid.cyr.
    # ⛔ IT EARNS A KIND BY THIS REPO'S OWN RULE, stated in `progress.cyr`'s header and applied when
    # MENU and SHEET were REFUSED one in 0.9.23: *a kind earns itself only when composing it would
    # force the APP to name a theme colour, or when it expresses state no existing kind can hold.*
    # A grid composed from BOXes clears both bars — the app would have to paint the selected cell's
    # highlight itself, which means naming `accent`, which crab's ADR 0001 forbids outright; and the
    # wrapping arithmetic (how many cells fit this width) is the rule that "lived in three apps"
    # which is why LIST exists at all.
    # ⚠ Deliberately NOT a new DhLayout mode. Wrapping is inseparable from the cell size and the
    # selection here, and a BOX that wrapped would change what every existing BOX means.
    GRID      = 8;
}

# Field offsets (bytes) into a DhWidget record.
enum DhWidgetField {
    DH_W_ID           = 0;
    DH_W_KIND         = 8;
    DH_W_X            = 16;
    DH_W_Y            = 24;
    DH_W_W            = 32;
    DH_W_H            = 40;
    DH_W_PARENT       = 48;
    DH_W_FIRST_CHILD  = 56;
    DH_W_NEXT_SIBLING = 64;
    DH_W_LAYOUT       = 72;    # DhLayout mode applied to this node's children
    DH_W_BG           = 80;    # background color 0x00RRGGBB, or -1 = none
    DH_W_TEXT         = 88;    # cstring ptr for LABEL / BUTTON, or 0
    DH_W_PREF_W       = 96;    # requested width (layout hint)
    DH_W_PREF_H       = 104;   # requested height
    DH_W_HANDLER      = 112;   # bubble-phase handler fnptr, or 0
    DH_W_USERDATA     = 120;   # opaque app context for the handler, or 0
    DH_W_CAPTURE_H    = 128;   # capture-phase handler fnptr, or 0
    DH_W_FLAGS        = 136;   # bitmask (DH_FLAG_*)
    DH_W_FLEX         = 144;   # flex weight (0 = fixed)
    DH_W_PAD          = 152;   # uniform content padding (px)
    DH_W_GAP          = 160;   # spacing between children (px)
    DH_W_ALIGN        = 168;   # cross-axis align-self (DhAlign)
    # ⭐⭐ PER-WIDGET MOTION OVERRIDE (0.9.6). The system GRANTS a vocabulary in rupa; a widget may ask
    # for something else, and rupa's clamp decides what it actually gets. Storing the ASK rather than
    # the resolved value is deliberate: the answer depends on the reduced-motion switch, which can flip
    # at runtime, so resolving at set-time would freeze an accessibility decision into every widget.
    DH_W_MO_ROLE      = 176;   # RupaMotion role this widget moves with (default RU_MO_QUICK)
    DH_W_MO_MS        = 184;   # requested duration override, 0 = none (take the grant)
    DH_W_MO_EASE      = 192;   # requested easing override, -1 = none
    # ⭐ SCROLL + SELECTION (0.9.7). On ANY container, not just LIST — a scrolled BOX is the same
    # arithmetic, and gating it on kind would mean a second code path for "a box that happens to
    # scroll". `list.cyr` adds the policy (clamping, keep-selected-visible); these are just the state.
    DH_W_SCROLL_Y     = 200;   # px this container's content is shifted UP by. >= 0. 0 = at the top.
    DH_W_SEL          = 208;   # selected child index, or -1 = nothing selected
    # ⭐ EDITABLE TEXT (0.9.7). The buffer itself is `DH_W_TEXT` — the SAME field a LABEL uses — so
    # the existing draw path renders a TEXTINPUT's contents with no new painting code. These three
    # are what make it editable rather than static.
    DH_W_TEXT_CAP     = 216;   # buffer capacity in BYTES, including the NUL. 0 = not editable.
    DH_W_TEXT_LEN     = 224;   # bytes currently used, excluding the NUL
    DH_W_CARET        = 232;   # caret position as a BYTE offset into the buffer, 0..len
    # ⭐ CANVAS DRAW CALLBACK (0.9.9) — `draw(wgt, sds, clx, cly, clw, clh)`, or 0.
    DH_W_DRAW         = 240;
    # ⭐ PER-WIDGET TEXT COLOUR (0.9.20). -1 = inherit from the parent, which is what every widget
    # did unconditionally before. Appended at the end so every offset above is unchanged.
    # ⛔ IT DOES NOT OUTRANK THE SELECTION HIGHLIGHT. A cell's colour is a PREFERENCE; on-accent on a
    # selected row is a LEGIBILITY GUARANTEE, and a table that let a column set its own colour would
    # otherwise be able to make the selected row unreadable again — the exact defect 0.9.20 fixed.
    DH_W_FG           = 248;
    # ⭐ PROGRESS FILL (0.9.22). How full the bar is, in PERMILLE (0..1000), or -1 = INDETERMINATE.
    # Appended at the end so every offset above is unchanged — consumers read these offsets straight
    # out of the fold, and inserting in the middle would silently re-point every field after it.
    # ⛔ SEEDED TO -1, NOT 0, AND IT IS THE SAME TRAP AS `DH_W_SEL`: 0 is a VALID fill ("started,
    # nothing done yet"), so a zeroed field would make every bar in the system claim a real 0%
    # rather than admit it has not been told anything. And the allocation is NOT guaranteed zeroed:
    # under the frame arena the memory is RECYCLED from a previous frame's widgets, so an unseeded
    # field carries a *plausible* stale permille instead of an obvious zero.
    DH_W_FILL         = 256;
    # ⭐ OVERLAY OFFSET (0.9.23). How far this child sits from its NONE container's PADDED CONTENT
    # ORIGIN, in px. 0,0 is the origin — exactly where every child sat before — so every existing
    # NONE container is bit-identical.
    # ⛔ NONE CONTAINERS ONLY, DELIBERATELY. An offset honoured inside a BOX_H/BOX_V would be a
    # MARGIN wearing the wrong name: the flex distributor does not account for it, so the child would
    # overlap its neighbour and the container's measured size would be a lie. Same reasoning that
    # keeps `DH_W_SCROLL_Y` vertical-only — a field that means one thing.
    # ⛔ SEEDED EXPLICITLY EVEN THOUGH 0 IS THE DEFAULT. Under the frame arena the memory is
    # RECYCLED, so an unseeded offset carries a previous frame's value — and that value is a SMALL
    # PLAUSIBLE NUMBER, which is the worst kind of wrong: a popup 40 px from where it was asked for
    # reads as a design decision, not a fault.
    DH_W_OFF_X        = 264;
    DH_W_OFF_Y        = 272;
    # ⭐ PER-WIDGET BORDER (0.9.23). A sadish colour, or one of the two sentinels in `DhBorder`.
    # ⛔ WHY TWO SENTINELS. -1 cannot mean "none", because -1 is also what a BUTTON has by default and
    # a BUTTON's default is `line`. A single sentinel would make `set_border(btn, -1)` mean "restore
    # the border" when the caller plainly meant "remove it".
    # ⛔ THE COLOUR IS RESOLVED AT DRAW TIME, NEVER AT CONSTRUCTION. Storing `dh_theme_line()` here
    # would freeze the palette into every widget, so a theme switch would leave already-built widgets
    # on the old colour — and it would make widget.cyr call into theme.cyr, which sits AFTER it in
    # the fold.
    DH_W_BORDER       = 280;
    # ⭐⭐ THE STABLE KEY (0.9.24) — a caller-supplied identity that survives a frame arena rewind.
    #
    # ⛔⛔ THE PROBLEM IT SOLVES: dhancha identified a widget by its POINTER, and a per-frame arena
    # invalidates every pointer at `dh_frame_begin`. Four features are built on retained widget
    # pointers — focus, hover, press and drag — so all four were unreachable from an immediate-mode
    # app that rebuilds its tree each frame. `dh_dispatch`, drag and `TEXTINPUT` were each worked
    # around separately in crab before anyone noticed the three had **one** cause.
    # ⇒ A key is an ordinary integer, so `arena_reset` cannot invalidate it. The app labels the
    # widgets it wants remembered, dhancha remembers KEYS instead of pointers, and
    # `dh_surface_set_root` re-resolves key → widget against the newly built tree each frame.
    #
    # ⚠ **0 MEANS "NO STABLE IDENTITY", AND THAT IS WHY THIS IS ADDITIVE.** Every widget that exists
    # today has key 0, retained state falls back to raw pointers exactly as before, and no shipped
    # app changes behaviour. A key is opt-in per widget, not per app.
    # ⚠ KEYS ARE THE APP'S NAMESPACE, NOT dhancha's. `DH_W_ID` is a monotonic counter minted per
    # allocation — it is *fresh every frame* under an arena and therefore useless as identity. The
    # key is whatever the app can re-derive: a pane index, a row index, a hash of a path.
    # ⛔ UNIQUENESS IS THE APP'S CONTRACT. `dh_widget_find_key` returns the FIRST match in
    # depth-first order; two widgets sharing a key is a bug in the app and dhancha cannot detect it
    # cheaply. Said here rather than enforced, because the check is O(n²) on every frame.
    DH_W_KEY          = 288;
    # ⭐ GRID cell geometry (0.9.25). ⛔ NOT folded onto `DH_W_PREF_W` / `_PREF_H`: those are the
    # grid's OWN preferred size, which layout reads and writes, so a grid that stored its cell size
    # there could not also be sized by its parent. ⚠ LIST overloads `DH_W_PREF_H` as its row height
    # and gets away with it because a list has no cross-axis cell size to keep; a grid has both.
    DH_W_CELL_W       = 296;
    DH_W_CELL_H       = 304;
    # ⭐⭐ HORIZONTAL SCROLL (0.9.25+1). ⛔ ITS OWN FIELD, EXACTLY AS `layout.cyr` PROMISED. That file
    # has said since 0.9.7: *"Horizontal scrolling is not implemented; when it is, it gets its own
    # field rather than a reinterpretation of this one."* Reusing `DH_W_SCROLL_Y` for a row would be
    # a horizontal scroll wearing a field named `scroll_y` — a silent lie at every call site.
    DH_W_SCROLL_X     = 312;
}
# ⚠ 256 -> 264 at 0.9.22. A consumer with a FIXED-size arena sized against the old footprint will
# now spill to the global allocator, and `dh_falloc` degrades to a leak rather than to a null — so
# it passes every functional test and shows up only in an `alloc_used()` convergence check. crab is
# safe (`arena_new_growable`, which chains); check any other consumer before shipping.
# ⚠ 320 as of 0.9.26 (288 at 0.9.23, 296 at 0.9.24, 312 at 0.9.25) — `DH_W_KEY`, `DH_W_CELL_W` /
# `_CELL_H`, then `DH_W_SCROLL_X`.
# ⛔ This constant and the layout above must move together; the header comment has been stale before,
# so re-derive it from the last field rather than trusting either. ⭐ `progress_test` pins the value
# as a literal precisely so a change here has to be confirmed by a human — it has fired three times.
var DH_WIDGET_SIZE = 320;

# ============================================================================================
# ⭐⭐ MOTION — the app's half of "the compositor grants, apps override per widget"
# ============================================================================================
# ⛔ EVERY READ GOES THROUGH rupa's CLAMP. These accessors deliberately expose no way to get the raw
# request back out for use: `dh_widget_motion_ms` is the only path to a number a caller can animate
# with, and it calls `rupa_motion_duration`, which enforces the flash-band floor and lets the
# reduced-motion switch outrank the widget. A convenience getter returning the unclamped ask would be
# used by accident and would route around the guards — which is why one does not exist.
fn dh_widget_set_motion(w, role, want_ms, want_ease): i64 {
    if (w == 0) { return 0 - 1; }
    store64(w + DH_W_MO_ROLE, role);
    store64(w + DH_W_MO_MS, want_ms);
    store64(w + DH_W_MO_EASE, want_ease);
    return 0;
}
fn dh_widget_motion_role(w): i64 { if (w == 0) { return RupaMotion.RU_MO_QUICK; } return load64(w + DH_W_MO_ROLE); }

# The duration this widget must actually animate with, in ms. -> already clamped; use it as given.
fn dh_widget_motion_ms(w): i64 {
    if (w == 0) { return 0; }
    return rupa_motion_duration(load64(w + DH_W_MO_ROLE), load64(w + DH_W_MO_MS));
}
# The easing this widget must actually use.
fn dh_widget_motion_ease(w): i64 {
    if (w == 0) { return RupaEase.RU_EASE_LINEAR; }
    return rupa_motion_ease(load64(w + DH_W_MO_ROLE), load64(w + DH_W_MO_EASE));
}
# How far through, at `elapsed_ms`. Periodic roles cycle; the rest run once and finish.
# ⚠ ROUTED BY ROLE, not by a caller's guess: a consumer choosing `progress` for a BUSY widget would get
# a spinner that completes once and stops, which reads as the work having finished.
fn dh_widget_motion_at(w, elapsed_ms): i64 {
    if (w == 0) { return 255; }
    var d = dh_widget_motion_ms(w);
    var e = dh_widget_motion_ease(w);
    if (rupa_motion_is_periodic(load64(w + DH_W_MO_ROLE)) == 1) { return rupa_motion_cycle(d, elapsed_ms, e); }
    return rupa_motion_progress(d, elapsed_ms, e);
}

# Widget behavior flags (DH_W_FLAGS bitmask).
enum DhWidgetFlag {
    DH_FLAG_DRAGGABLE   = 1;    # a press + drag on this widget starts a drag
    DH_FLAG_DROP_TARGET = 2;    # a drag released over this widget drops onto it
    # ⭐ 0.9.23 — PAINT ONLY, no input meaning. This widget's rect is SCANLINE-DIMMED with
    # `dh_theme_bg()` before its children draw. See `dh_draw_scrim`, and the ⛔ there about what
    # sadish can and cannot actually do.
    DH_FLAG_SCRIM       = 4;
    # ⭐ 0.9.23 — INPUT + SELECTION ONLY, no paint. A container child that cannot be selected and
    # cannot be hit AS A ROW: a menu separator, a section heading inside a list.
    # ⚠ Additive — no widget that exists today sets this bit, so every shipped LIST is unchanged.
    DH_FLAG_INERT       = 8;
}

# Border sentinels. ⛔ TWO, NOT ONE — see the ⛔ at `DH_W_BORDER`.
enum DhBorder {
    DH_BORDER_INHERIT = -1;      # take this KIND's default (BUTTON -> line; everything else -> none)
    DH_BORDER_NONE    = -2;      # draw nothing, whatever the kind
}

# Cross-axis alignment of a child within its BOX container's cross size
# (align-self). STRETCH (the default) fills the cross axis; the others use
# the child's preferred cross size and position it.
enum DhAlign {
    ALIGN_STRETCH = 0;
    ALIGN_START   = 1;
    ALIGN_CENTER  = 2;
    ALIGN_END     = 3;
}

# ============================================================================================
# ⭐⭐ THE PER-FRAME ARENA (0.9.15) — how an immediate-mode toolkit stops leaking a tree a frame
# ============================================================================================
# ⛔ THE PROBLEM IS THE SUBSTRATE, NOT THE TOOLKIT'S STYLE. `lib/alloc.cyr` is a bump allocator with
# **no `free()`**; `alloc_reset` rewinds the WHOLE arena and would take the caller's own long-lived
# objects with it. So an app that rebuilds its widget tree every frame — which is what immediate-mode
# means, and what makes toolkit-owned selection and scroll work at all — retains every widget it has
# ever built, for the life of the process. Measured against crab at 380x220 with 114 entries per pane:
# **~236 widgets x 288 B = 67,968 B per frame**, permanently. (248 B until 0.9.22; the figure moves
# with `DH_WIDGET_SIZE` and has been stale before — re-derive it rather than trusting it.)
#
# ⇒ Route the PER-FRAME allocations through a caller-supplied arena. `arena_reset` is a bump back to
# base with no free list, and a GROW arena keeps its chunks across resets — so a render loop converges
# on its high-water mark and then **allocates nothing at all**.
#
# ⛔⛔ WHAT IS AND IS NOT ROUTED HERE IS A SAFETY BOUNDARY, NOT A COMPLETENESS ONE. dhancha calls
# `alloc()` at 19 sites and only the per-frame ones may move:
#   ROUTED  — `dh_widget_new` (this file) and layout's measure scratch (`layout.cyr`). Both die with
#             the frame by construction.
#   NOT     — `dh_surface_new` and its pixels, the setu client's shared buffer, event records and
#             queues, textinput text buffers, canvas surfaces, error records. **Every one of these
#             outlives a frame**, and a caller holds pointers to them across resets. Routing
#             `dh_surface_new` in particular would free crab's session surface out from under it on
#             the first reset — a use-after-free that the bump allocator would then hand back out,
#             so it would corrupt silently rather than fault.
#
# ⚠ EXHAUSTION DEGRADES TO A LEAK, NEVER TO A NULL DEREF. `dh_falloc` falls back to the global
# allocator when the arena refuses. The stdlib's own arena notes diagnose why this matters: a 0 from
# `arena_alloc` is indistinguishable from a valid pointer and faults several layers away, so
# "adopting the feature made the failure worse and quieter". A dropped widget is a corrupted frame;
# a spilled one is merely the cost we had before. ⭐ Callers should still prefer
# `arena_new_growable`, which chains a chunk instead of refusing and never reaches this fallback.
#
# ⛔ RESETTING INVALIDATES EVERY WIDGET POINTER — INCLUDING THE FOUR DHANCHA ITSELF HOLDS.
# `_dh_focus`, `_dh_hover`, `_dh_press` and `_dh_drag_src` (event.cyr) are raw widget pointers kept
# across calls. After a reset they address memory the arena is about to hand out again, so a
# `dh_focus_within` walk would follow recycled parent links. That is why the reset entry point is
# `dh_frame_begin` (event.cyr) — it resets the arena AND clears those four, and the two halves cannot
# be done separately. **Do not call `arena_reset` on a frame arena directly.**
var _dh_frame_arena = 0;

# @public — route dhancha's per-frame allocations through arena `a`. Pass 0 to go back to the global
# allocator, which is the default and is exactly the pre-0.9.15 behaviour.
fn dh_frame_arena_set(a): i64 { _dh_frame_arena = a; return DHANCHA_OK; }

# @public — the arena currently backing per-frame allocations, or 0 for the global allocator.
fn dh_frame_arena_get(): i64 { return _dh_frame_arena; }

# @public — allocate `size` bytes that live only until the next `dh_frame_begin`. Consumers may use
# this for their own per-frame scratch: a row's display string handed to `dh_widget_set_text` MUST
# share the widget's lifetime, because `set_text` stores the pointer and does not copy.
# ⚠ Falls back to the global allocator when no arena is set or the arena refuses — see the ⛔ above.
fn dh_falloc(size): i64 {
    if (_dh_frame_arena == 0) { return alloc(size); }
    var p = arena_alloc(_dh_frame_arena, size);
    if (p == 0) { return alloc(size); }
    return p;
}

# Monotonic widget-id source. A plain module-global SCALAR (not a `[1]` array —
# module-global `var X[N]` sizing is non-uniform in cyrius, so an 8-byte
# load64/store64 on a `[1]` can read/write out of bounds). A scalar i64 is a
# reliable 8-byte cell accessed directly.
var _dh_next_widget_id = 0;

# @public — give this widget a stable identity that survives a frame-arena rewind. See `DH_W_KEY`.
# ⚠ `key == 0` clears it, which is the default and means "not remembered across frames".
fn dh_widget_set_key(w, key): i64 {
    if (w == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(w + DH_W_KEY, key);
    return DHANCHA_OK;
}

# @public — this widget's stable key, or 0 if it has none.
fn dh_widget_key(w): i64 {
    if (w == 0) { return 0; }
    return load64(w + DH_W_KEY);
}

# @public — find the widget carrying `key` in the subtree rooted at `root`. -> DhWidget*, or 0.
#
# ⛔ DEPTH-FIRST, FIRST MATCH WINS, AND IT DOES NOT PRUNE. This is deliberately unlike
# `dh_hit_test`, which prunes any subtree whose root does not contain the point: a key is an
# identity, not a location, so a keyed widget laid out anywhere — scrolled out of view, offset into
# an overlay, sized to nothing — must still be findable. Pruning here would make focus silently
# unrecoverable for exactly the widgets an app is most likely to key.
# ⚠ `key == 0` finds nothing, because 0 is the "no identity" sentinel and every unkeyed widget in
# the tree carries it. Answering with the first unkeyed widget would be worse than answering none.
fn dh_widget_find_key(root, key): i64 {
    if (root == 0) { return 0; }
    if (key == 0) { return 0; }
    if (load64(root + DH_W_KEY) == key) { return root; }
    var c = load64(root + DH_W_FIRST_CHILD);
    while (c != 0) {
        var hit = dh_widget_find_key(c, key);
        if (hit != 0) { return hit; }
        c = load64(c + DH_W_NEXT_SIBLING);
    }
    return 0;
}

# Allocate + zero-init a widget of the given kind. Returns a DhWidget*.
# All bounds start at 0 (layout fills them in); tree links start null.
fn dh_widget_new(kind): i64 {
    # ⚠ `dh_falloc`, not `alloc` (0.9.15) — the widget tree is the per-frame allocation. See the ⛔
    # block above `_dh_frame_arena` for what may and may not move onto the arena, and why.
    var wgt = dh_falloc(DH_WIDGET_SIZE);
    var id = _dh_next_widget_id;
    _dh_next_widget_id = id + 1;
    store64(wgt + DH_W_ID, id);
    store64(wgt + DH_W_KIND, kind);
    # ⭐ MOTION DEFAULTS: inherit the system's QUICK grant, override nothing. ⛔ `DH_W_MO_EASE` must be
    # **-1**, not 0 — 0 is `RU_EASE_LINEAR`, a real value, so a zeroed field would silently mean "this
    # widget overrides the easing to linear" and every widget would lose its role's curve. The alloc is
    # not guaranteed zeroed anyway; this is the explicit seed either way.
    store64(wgt + DH_W_MO_ROLE, RupaMotion.RU_MO_QUICK);
    store64(wgt + DH_W_MO_MS, 0);
    store64(wgt + DH_W_MO_EASE, 0 - 1);
    # ⛔ AND `DH_W_SEL` IS THE SAME TRAP AS THE EASE ABOVE: 0 is a VALID selection (the first child),
    # so a zeroed field would mean every list in the system boots with row 0 highlighted and a
    # `dh_list_selected` that lies about the operator having chosen anything. -1 is "nothing selected".
    store64(wgt + DH_W_SEL, 0 - 1);
    store64(wgt + DH_W_SCROLL_Y, 0);
    store64(wgt + DH_W_TEXT_CAP, 0);
    store64(wgt + DH_W_TEXT_LEN, 0);
    store64(wgt + DH_W_CARET, 0);
    store64(wgt + DH_W_DRAW, 0);
    store64(wgt + DH_W_FG, 0 - 1);         # inherit
    store64(wgt + DH_W_X, 0);
    store64(wgt + DH_W_Y, 0);
    store64(wgt + DH_W_W, 0);
    store64(wgt + DH_W_H, 0);
    store64(wgt + DH_W_PARENT, 0);
    store64(wgt + DH_W_FIRST_CHILD, 0);
    store64(wgt + DH_W_NEXT_SIBLING, 0);
    store64(wgt + DH_W_LAYOUT, 0);         # NONE
    store64(wgt + DH_W_BG, 0 - 1);         # -1 = no background
    store64(wgt + DH_W_TEXT, 0);
    store64(wgt + DH_W_PREF_W, 0);
    store64(wgt + DH_W_PREF_H, 0);
    store64(wgt + DH_W_HANDLER, 0);        # no bubble handler
    store64(wgt + DH_W_USERDATA, 0);
    store64(wgt + DH_W_CAPTURE_H, 0);      # no capture handler
    store64(wgt + DH_W_FLAGS, 0);          # no flags
    store64(wgt + DH_W_FLEX, 0);           # fixed (not flexible)
    store64(wgt + DH_W_PAD, 0);            # no padding
    store64(wgt + DH_W_GAP, 0);            # no gap
    store64(wgt + DH_W_ALIGN, 0);          # ALIGN_STRETCH
    store64(wgt + DH_W_FILL, 0 - 1);       # -1 = indeterminate (see the ⛔ at the field)
    store64(wgt + DH_W_OFF_X, 0);          # ⛔ seeded: arena memory is RECYCLED, not zero
    store64(wgt + DH_W_OFF_Y, 0);
    store64(wgt + DH_W_BORDER, DH_BORDER_INHERIT);
    # ⛔ SEEDED, LIKE EVERY FIELD ABOVE, BECAUSE ARENA MEMORY IS RECYCLED AND NOT ZERO. A widget that
    # inherited the previous frame's key at this address would be silently adopted as the focused or
    # dragged widget — the exact failure this field exists to prevent, caused by the field itself.
    store64(wgt + DH_W_KEY, 0);
    # ⛔ SEEDED, like every field above — arena memory is RECYCLED and not zero. A widget inheriting
    # the previous frame's cell size here would lay a grid out to a geometry nothing asked for.
    store64(wgt + DH_W_CELL_W, 0);
    store64(wgt + DH_W_CELL_H, 0);
    store64(wgt + DH_W_SCROLL_X, 0);      # ⛔ seeded: arena memory is RECYCLED, not zero
    return wgt;
}

# Append `child` as the last child of `parent`. Sets child.parent and
# links it onto the sibling chain. Returns DHANCHA_OK / an error code.
fn dh_widget_add_child(parent, child): i64 {
    if (parent == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (child == 0)  { return DHANCHA_ERR_BAD_WIDGET; }
    store64(child + DH_W_PARENT, parent);
    var head = load64(parent + DH_W_FIRST_CHILD);
    if (head == 0) {
        store64(parent + DH_W_FIRST_CHILD, child);
        return DHANCHA_OK;
    }
    # walk to the last sibling and append
    var cur = head;
    while (load64(cur + DH_W_NEXT_SIBLING) != 0) {
        cur = load64(cur + DH_W_NEXT_SIBLING);
    }
    store64(cur + DH_W_NEXT_SIBLING, child);
    return DHANCHA_OK;
}

# ---- accessors ----------------------------------------------------

fn dh_widget_id(wgt): i64          { return load64(wgt + DH_W_ID); }
fn dh_widget_kind(wgt): i64        { return load64(wgt + DH_W_KIND); }
fn dh_widget_x(wgt): i64           { return load64(wgt + DH_W_X); }
fn dh_widget_y(wgt): i64           { return load64(wgt + DH_W_Y); }
fn dh_widget_w(wgt): i64           { return load64(wgt + DH_W_W); }
fn dh_widget_h(wgt): i64           { return load64(wgt + DH_W_H); }
fn dh_widget_parent(wgt): i64      { return load64(wgt + DH_W_PARENT); }
fn dh_widget_first_child(wgt): i64 { return load64(wgt + DH_W_FIRST_CHILD); }
fn dh_widget_next_sibling(wgt): i64 { return load64(wgt + DH_W_NEXT_SIBLING); }

# Set the resolved bounds (called by the layout pass).
fn dh_widget_set_bounds(wgt, x, y, w, h): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_X, x);
    store64(wgt + DH_W_Y, y);
    store64(wgt + DH_W_W, w);
    store64(wgt + DH_W_H, h);
    return DHANCHA_OK;
}

# ---- style + layout properties ------------------------------------

fn dh_widget_layout(wgt): i64 { return load64(wgt + DH_W_LAYOUT); }
fn dh_widget_bg(wgt): i64     { return load64(wgt + DH_W_BG); }
fn dh_widget_text(wgt): i64   { return load64(wgt + DH_W_TEXT); }
fn dh_widget_pref_w(wgt): i64 { return load64(wgt + DH_W_PREF_W); }
fn dh_widget_pref_h(wgt): i64 { return load64(wgt + DH_W_PREF_H); }

# Set the child-layout mode (DhLayout: NONE / BOX_H / BOX_V / FLEX).
fn dh_widget_set_layout(wgt, mode): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_LAYOUT, mode);
    return DHANCHA_OK;
}

# Set the background color (0x00RRGGBB), or -1 for no background.
fn dh_widget_set_bg(wgt, color): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_BG, color);
    return DHANCHA_OK;
}

# Set the widget's text (a borrowed cstring pointer, or 0).
fn dh_widget_set_text(wgt, text): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_TEXT, text);
    return DHANCHA_OK;
}

# Set the preferred (requested) size, a layout hint.
fn dh_widget_set_pref(wgt, w, h): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_PREF_W, w);
    store64(wgt + DH_W_PREF_H, h);
    return DHANCHA_OK;
}

# ---- event handler + userdata -------------------------------------

fn dh_widget_handler(wgt): i64  { return load64(wgt + DH_W_HANDLER); }
fn dh_widget_userdata(wgt): i64 { return load64(wgt + DH_W_USERDATA); }

# Attach an event-handler function pointer. Take the address with
# `&fn_name` (the fn must be `handler(wgt, ev): i64` returning 1 to
# consume the event, 0 to let it bubble). Pass 0 to clear.
fn dh_widget_set_handler(wgt, fp): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_HANDLER, fp);
    return DHANCHA_OK;
}

# Attach opaque app context the handler can read back via
# dh_widget_userdata (dispatch passes only the widget + event).
fn dh_widget_set_userdata(wgt, ud): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_USERDATA, ud);
    return DHANCHA_OK;
}

# Can this widget take keyboard focus? BUTTON / TEXTINPUT do; structural
# nodes (WINDOW / BOX / LABEL) do not. Click-to-focus consults this.
fn dh_widget_focusable(wgt): i64 {
    if (wgt == 0) { return 0; }
    var k = dh_widget_kind(wgt);
    if (k == BUTTON)    { return 1; }
    if (k == TEXTINPUT) { return 1; }
    # ⭐ A LIST TAKES FOCUS (0.9.8). Arrow keys have to reach it, and Tab has to be able to land on
    # it — a scrollable list the keyboard cannot enter is a mouse-only control, which is the
    # accessibility failure that matches painted-but-inert on the input side.
    if (k == LIST)      { return 1; }
    return 0;
}

# ---- capture-phase handler ----------------------------------------

fn dh_widget_capture_handler(wgt): i64 { return load64(wgt + DH_W_CAPTURE_H); }

# Attach a capture-phase handler (fires root -> target, BEFORE the bubble
# handlers). Same `handler(wgt, ev): i64` shape; return 1 to consume the
# event (which also cancels the bubble pass). Pass 0 to clear.
fn dh_widget_set_capture_handler(wgt, fp): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_CAPTURE_H, fp);
    return DHANCHA_OK;
}

# ---- behavior flags (drag source / drop target) -------------------

fn dh_widget_flags(wgt): i64 { return load64(wgt + DH_W_FLAGS); }

# Set/clear one flag bit without touching the others.
fn dh_widget_set_flag(wgt, flag, on): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var f = load64(wgt + DH_W_FLAGS);
    if (on == 0) {
        f = f & (0 - 1 - flag);            # clear: AND with ~flag (two's complement)
    } else {
        f = f | flag;
    }
    store64(wgt + DH_W_FLAGS, f);
    return DHANCHA_OK;
}

# @public — place this child `dx, dy` px from its NONE container's padded content origin.
# ⚠ NONE CONTAINERS ONLY (see the ⛔ at `DH_W_OFF_X`). Set on a BOX child it is stored and ignored —
# deliberately: silently ignoring beats a half-honoured margin, and refusing would mean the setter
# had to know the parent, which a child may not have yet.
fn dh_widget_set_offset(wgt, dx, dy): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_OFF_X, dx);
    store64(wgt + DH_W_OFF_Y, dy);
    return DHANCHA_OK;
}

fn dh_widget_off_x(wgt): i64 { if (wgt == 0) { return 0; } return load64(wgt + DH_W_OFF_X); }
fn dh_widget_off_y(wgt): i64 { if (wgt == 0) { return 0; } return load64(wgt + DH_W_OFF_Y); }

# @public — border colour, `DH_BORDER_INHERIT`, or `DH_BORDER_NONE`.
fn dh_widget_set_border(wgt, col): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_BORDER, col);
    return DHANCHA_OK;
}

fn dh_widget_border(wgt): i64 {
    if (wgt == 0) { return DH_BORDER_INHERIT; }
    return load64(wgt + DH_W_BORDER);
}

# @public — is this widget inert (unselectable, unhittable as a row)? 1 = yes.
fn dh_widget_inert(wgt): i64 {
    if (wgt == 0) { return 0; }
    if ((load64(wgt + DH_W_FLAGS) & DH_FLAG_INERT) != 0) { return 1; }
    return 0;
}

fn dh_widget_set_inert(wgt, on): i64 { return dh_widget_set_flag(wgt, DH_FLAG_INERT, on); }
fn dh_widget_set_scrim(wgt, on): i64 { return dh_widget_set_flag(wgt, DH_FLAG_SCRIM, on); }

fn dh_widget_set_draggable(wgt, on): i64   { return dh_widget_set_flag(wgt, DH_FLAG_DRAGGABLE, on); }
fn dh_widget_set_drop_target(wgt, on): i64 { return dh_widget_set_flag(wgt, DH_FLAG_DROP_TARGET, on); }

fn dh_widget_is_draggable(wgt): i64 {
    if (wgt == 0) { return 0; }
    if ((dh_widget_flags(wgt) & DH_FLAG_DRAGGABLE) != 0) { return 1; }
    return 0;
}

fn dh_widget_is_drop_target(wgt): i64 {
    if (wgt == 0) { return 0; }
    if ((dh_widget_flags(wgt) & DH_FLAG_DROP_TARGET) != 0) { return 1; }
    return 0;
}

# ---- flex / box layout properties ---------------------------------

fn dh_widget_flex(wgt): i64    { return load64(wgt + DH_W_FLEX); }

# @public — this widget's own text colour, or -1 to inherit from its parent.
fn dh_widget_fg(wgt): i64 { if (wgt == 0) { return 0 - 1; } return load64(wgt + DH_W_FG); }

# @public — set this widget's text colour (and its subtree's, unless a child overrides). -1 inherits.
fn dh_widget_set_fg(wgt, col): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_FG, col);
    return 0;
}
fn dh_widget_padding(wgt): i64 { return load64(wgt + DH_W_PAD); }
fn dh_widget_gap(wgt): i64     { return load64(wgt + DH_W_GAP); }
fn dh_widget_align(wgt): i64   { return load64(wgt + DH_W_ALIGN); }

# Is screen point (px, py) inside this widget's box? The half-open convention (x <= p < x + w) is
# the same one `dh_hit_test` and the painter's clip use — three places agreeing that a widget owns
# its top-left edge and not its bottom-right is what stops a 1px seam between adjacent widgets
# from being either dead or claimed twice.
fn dh_widget_contains(wgt, px, py): i64 {
    if (wgt == 0) { return 0; }
    var x = load64(wgt + DH_W_X);
    var y = load64(wgt + DH_W_Y);
    if (px < x) { return 0; }
    if (py < y) { return 0; }
    if (px >= x + load64(wgt + DH_W_W)) { return 0; }
    if (py >= y + load64(wgt + DH_W_H)) { return 0; }
    return 1;
}

# ⚠ RAW STATE ACCESSORS — no clamping. A caller that wants "scroll, but not past the end" wants
# `dh_list_scroll_to` in list.cyr, which knows the content height. This pair exists because layout
# and draw need the stored number, and a clamping getter would make them depend on the policy layer.
fn dh_widget_scroll_y(wgt): i64 { if (wgt == 0) { return 0; } return load64(wgt + DH_W_SCROLL_Y); }
fn dh_widget_scroll_x(wgt): i64 { if (wgt == 0) { return 0; } return load64(wgt + DH_W_SCROLL_X); }
fn dh_widget_sel(wgt): i64      { if (wgt == 0) { return 0 - 1; } return load64(wgt + DH_W_SEL); }

# Flex weight: 0 = fixed (takes its pref main-axis size); > 0 = flexible
# (grows to share the container's leftover main-axis space by weight).
fn dh_widget_set_flex(wgt, weight): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_FLEX, weight);
    return DHANCHA_OK;
}

# Uniform padding inset applied to this container's content box.
fn dh_widget_set_padding(wgt, pad): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_PAD, pad);
    return DHANCHA_OK;
}

# Spacing inserted between consecutive children in BOX_H / BOX_V.
fn dh_widget_set_gap(wgt, gap): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_GAP, gap);
    return DHANCHA_OK;
}

# Cross-axis alignment of this child within its container (a DhAlign).
fn dh_widget_set_align(wgt, align): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_ALIGN, align);
    return DHANCHA_OK;
}

# --- layout.cyr ---

# @public — dhancha layout engine.
# layout.cyr — flexbox-style box layout over a DhWidget tree.
#
# The arrange pass walks the tree top-down: each node is assigned a box
# (x, y, w, h), then it arranges its children within its PADDED content
# box according to its DhLayout mode, and recurses. BOX_V (column) and
# BOX_H (row) are flex containers: a child with flex weight 0 takes its
# preferred main-axis size, and children with flex > 0 split the leftover
# main-axis space in proportion to their weights. `gap` separates
# children; `pad` insets the content box; each child's DhAlign positions
# it on the cross axis (STRETCH fills it). NONE is absolute overlay.
#
# Intrinsic measure (dh_measure / dh_layout_fit) computes a widget's
# natural content size bottom-up; inside a flex box a fixed child with no
# preferred main size auto-sizes to its measured content.

# Layout modes a container applies to its children.
enum DhLayout {
    NONE  = 0;   # children keep their own bounds (absolute overlay)
    BOX_H = 1;   # flex row: stack children left→right
    BOX_V = 2;   # flex column: stack children top→bottom
    FLEX  = 3;   # alias of BOX_V (a flex column)
}

# DhRect struct layout (32 bytes): x, y, w, h.
enum DhRectField {
    DH_R_X = 0;
    DH_R_Y = 8;
    DH_R_W = 16;
    DH_R_H = 24;
}

# Allocate a DhRect.
fn dh_rect_new(x, y, w, h): i64 {
    var r = alloc(32);
    store64(r + DH_R_X, x);
    store64(r + DH_R_Y, y);
    store64(r + DH_R_W, w);
    store64(r + DH_R_H, h);
    return r;
}

fn dh_rect_x(r): i64 { return load64(r + DH_R_X); }
fn dh_rect_y(r): i64 { return load64(r + DH_R_Y); }
fn dh_rect_w(r): i64 { return load64(r + DH_R_W); }
fn dh_rect_h(r): i64 { return load64(r + DH_R_H); }

# ---- intrinsic measure --------------------------------------------

# @public — compute `wgt`'s natural content size bottom-up, writing
# (width, height) into the 16-byte `out` buffer. A CHILDLESS widget
# measures to its preferred size — so padding on an empty widget adds
# nothing; use a pref for a spacer. A container's content size derives
# from its measured children per mode (BOX_V: max width, summed heights +
# gaps; BOX_H: summed widths + gaps, max height; NONE: bounding box) plus
# 2*padding; an explicit pref on an axis is an EXACT size and overrides the
# computed content on that axis, so dh_measure and the dh_child_main layout
# path agree — dh_layout_fit never sizes a parent smaller than a pref-
# bearing child (which would otherwise overflow it).
fn dh_measure(wgt, out): i64 {
    if (wgt == 0) {
        store64(out, 0);
        store64(out + 8, 0);
        return DHANCHA_OK;
    }
    var child = dh_widget_first_child(wgt);
    if (child == 0) {
        store64(out, dh_widget_pref_w(wgt));
        store64(out + 8, dh_widget_pref_h(wgt));
        return DHANCHA_OK;
    }
    var pad = dh_widget_padding(wgt);
    var gap = dh_widget_gap(wgt);
    var mode = dh_widget_layout(wgt);
    var cbuf = dh_falloc(16);        # per-frame measure scratch (0.9.15) — never retained
    var count = 0;
    var sum_w = 0;
    var sum_h = 0;
    var max_w = 0;
    var max_h = 0;
    while (child != 0) {
        dh_measure(child, cbuf);
        var cw = load64(cbuf);
        var chn = load64(cbuf + 8);
        count = count + 1;
        sum_w = sum_w + cw;
        sum_h = sum_h + chn;
        if (cw > max_w) { max_w = cw; }
        if (chn > max_h) { max_h = chn; }
        child = dh_widget_next_sibling(child);
    }
    var gap_total = 0;
    if (count > 1) { gap_total = (count - 1) * gap; }
    var nat_w = max_w;              # default (NONE = bounding box)
    var nat_h = max_h;
    if (mode == BOX_H) {
        nat_w = sum_w + gap_total;
        nat_h = max_h;
    }
    if (mode == BOX_V) {
        nat_w = max_w;
        nat_h = sum_h + gap_total;
    }
    if (mode == FLEX) {
        nat_w = max_w;
        nat_h = sum_h + gap_total;
    }
    var out_w = nat_w + pad + pad;
    var out_h = nat_h + pad + pad;
    # an explicit pref on an axis is an exact size — it wins over content,
    # matching dh_child_main so measure and layout agree (no fit overflow)
    var pw = dh_widget_pref_w(wgt);
    var ph = dh_widget_pref_h(wgt);
    if (pw != 0) { out_w = pw; }
    if (ph != 0) { out_h = ph; }
    store64(out, out_w);
    store64(out + 8, out_h);
    return DHANCHA_OK;
}

# Convenience: natural width / height only.
fn dh_measure_w(wgt): i64 {
    var m = dh_falloc(16);           # per-frame measure scratch (0.9.15) — never retained
    dh_measure(wgt, m);
    return load64(m);
}
fn dh_measure_h(wgt): i64 {
    var m = dh_falloc(16);           # per-frame measure scratch (0.9.15) — never retained
    dh_measure(wgt, m);
    return load64(m + 8);
}

# The main-axis size a FIXED child occupies in a box: its preferred main
# size, or — when that is 0 — its measured content size. This is what lets
# a nested container with no explicit size auto-fit its content inside a
# flex parent.
fn dh_child_main(child, vertical): i64 {
    var pm = dh_widget_pref_w(child);
    if (vertical == 1) { pm = dh_widget_pref_h(child); }
    if (pm != 0) { return pm; }
    var m = dh_falloc(16);           # per-frame measure scratch (0.9.15) — never retained
    dh_measure(child, m);
    var mm = load64(m);
    if (vertical == 1) { mm = load64(m + 8); }
    return mm;
}

# Arrange a NONE container: children overlay the padded content box, each
# at its preferred size (a 0 dimension fills the content box).
fn dh_layout_none(wgt, x, y, w, h): i64 {
    var pad = dh_widget_padding(wgt);
    var cx = x + pad;
    var cy = y + pad;
    var cw = w - pad - pad;
    var chh = h - pad - pad;
    if (cw < 0) { cw = 0; }
    if (chh < 0) { chh = 0; }
    var child = dh_widget_first_child(wgt);
    while (child != 0) {
        var pw = dh_widget_pref_w(child);
        var ph = dh_widget_pref_h(child);
        if (pw == 0) { pw = cw; }
        if (ph == 0) { ph = chh; }
        # ⭐ THE OVERLAY OFFSET (0.9.23) — the three lines the whole popup layer rests on. A child of
        # a NONE container sits at the padded content origin PLUS its own offset, so a menu can be
        # placed at the pointer and a sheet pinned to an edge without either escaping the tree.
        # ⚠ 0,0 is the origin, which is exactly where every child sat before this existed, so every
        # NONE container that predates 0.9.23 lays out bit-identically.
        # ⛔ NONE ONLY. In a BOX the same field would be a MARGIN the flex distributor does not know
        # about, so the child would overlap its neighbour and the measured size would be a lie.
        dh_layout_at(child, cx + dh_widget_off_x(child), cy + dh_widget_off_y(child), pw, ph);
        child = dh_widget_next_sibling(child);
    }
    return DHANCHA_OK;
}

# Arrange a flex BOX container. `vertical` = 1 for a column (BOX_V: main
# axis = height, cross = width), 0 for a row (BOX_H: main = width, cross =
# height). Fixed children (flex 0) take their pref main size; flex > 0
# children split the leftover main space by weight (the last flex child
# gets the exact remainder so rounding never loses a pixel). `gap`
# separates children; each child is placed on the cross axis per its
# DhAlign (STRETCH fills the cross size).
fn dh_layout_box(wgt, x, y, w, h, vertical): i64 {
    var pad = dh_widget_padding(wgt);
    var gap = dh_widget_gap(wgt);
    var cx = x + pad;
    var cy = y + pad;
    var cw = w - pad - pad;
    var chh = h - pad - pad;
    if (cw < 0) { cw = 0; }
    if (chh < 0) { chh = 0; }

    # main-axis available space
    var main_avail = cw;
    if (vertical == 1) { main_avail = chh; }

    # pass 1: count children, sum fixed main sizes + flex weights
    var count = 0;
    var fixed = 0;
    var flex_total = 0;
    var child = dh_widget_first_child(wgt);
    while (child != 0) {
        count = count + 1;
        var cflex = dh_widget_flex(child);
        if (cflex > 0) {
            flex_total = flex_total + cflex;
        } else {
            fixed = fixed + dh_child_main(child, vertical);
        }
        child = dh_widget_next_sibling(child);
    }
    var total_gap = 0;
    if (count > 1) { total_gap = (count - 1) * gap; }
    var free = main_avail - fixed - total_gap;
    if (free < 0) { free = 0; }

    # pass 2: place children along the main axis
    var pos = cy;
    if (vertical == 0) { pos = cx; }
    # ⭐ SCROLL (0.9.7). The offset shifts the CONTENT, and it is applied here — at placement — rather
    # than at draw time, so a scrolled child's `x/y` are its REAL on-screen coordinates. That is what
    # lets hit-testing keep working with no knowledge of scrolling at all: `dh_hit_test` compares the
    # pointer against the same bounds the painter used. A draw-time-only offset would have moved the
    # pixels and left the clickable regions behind — painted-but-inert rows, the failure this whole
    # container exists to avoid.
    # ⭐ EACH AXIS HAS ITS OWN FIELD (0.9.26), which is what this comment promised when it read
    # *"Horizontal scrolling is not implemented; when it is, it gets its own field rather than a
    # reinterpretation of this one."* Subtracting `scroll_y` in a row would have been a horizontal
    # scroll wearing a vertical field's name — a silent lie at every call site — so `DH_W_SCROLL_X`
    # exists and this is the one place either is applied.
    if (vertical == 1) { pos = pos - dh_widget_scroll_y(wgt); }
    else { pos = pos - dh_widget_scroll_x(wgt); }
    var flex_used = 0;
    var flex_seen = 0;
    child = dh_widget_first_child(wgt);
    while (child != 0) {
        var cflex = dh_widget_flex(child);
        var msize = 0;
        if (cflex > 0) {
            flex_seen = flex_seen + cflex;
            # proportional share; the LAST flex child gets the exact
            # remainder so integer rounding never leaves/overshoots pixels
            if (flex_seen == flex_total) {
                msize = free - flex_used;
            } else {
                msize = free * cflex / flex_total;
                flex_used = flex_used + msize;
            }
        } else {
            msize = dh_child_main(child, vertical);
        }
        # cross axis: available + this child's pref cross size
        var cross_avail = cw;
        if (vertical == 0) { cross_avail = chh; }
        var cross_pref = dh_widget_pref_w(child);
        if (vertical == 0) { cross_pref = dh_widget_pref_h(child); }
        var align = dh_widget_align(child);
        var csize = cross_avail;             # STRETCH fills the cross size
        var coff = 0;
        if (align != ALIGN_STRETCH) {
            if (cross_pref == 0) { cross_pref = cross_avail; }
            csize = cross_pref;
            if (csize > cross_avail) { csize = cross_avail; }
            if (align == ALIGN_CENTER) { coff = (cross_avail - csize) / 2; }
            if (align == ALIGN_END) { coff = cross_avail - csize; }
            if (coff < 0) { coff = 0; }
        }
        if (vertical == 1) {
            dh_layout_at(child, cx + coff, pos, csize, msize);
        } else {
            dh_layout_at(child, pos, cy + coff, msize, csize);
        }
        pos = pos + msize + gap;
        child = dh_widget_next_sibling(child);
    }
    return DHANCHA_OK;
}

# Assign `wgt` the box (x, y, w, h), then arrange its children per its
# DhLayout mode and recurse. BOX_V / FLEX = flex column, BOX_H = flex row
# (both honor pad / gap / per-child flex + align); NONE = overlay. A fixed
# child with no pref main size auto-sizes to its measured content.
fn dh_layout_at(wgt, x, y, w, h): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    dh_widget_set_bounds(wgt, x, y, w, h);
    var mode = dh_widget_layout(wgt);
    if (mode == BOX_V) { return dh_layout_box(wgt, x, y, w, h, 1); }
    if (mode == FLEX)  { return dh_layout_box(wgt, x, y, w, h, 1); }
    if (mode == BOX_H) { return dh_layout_box(wgt, x, y, w, h, 0); }
    # ⭐ GRID (0.9.25) — dispatched on the KIND, not on a layout mode. Wrapping is inseparable from
    # the cell size and the selection, and a BOX mode that wrapped would change what every existing
    # BOX means. A grid's declared mode is NONE so nothing else claims its children.
    if (dh_widget_kind(wgt) == GRID) { return dh_layout_grid(wgt, x, y, w, h); }
    return dh_layout_none(wgt, x, y, w, h);
}

# Place a GRID's children in a wrapping row-major flow, honouring pad, gap and the scroll offset.
#
# ⛔ THE SCROLL OFFSET IS APPLIED HERE, exactly as `dh_layout_box` applies a LIST's — so hit-testing
# needs no knowledge of scrolling and `dh_grid_index_at` can simply walk the laid-out cells. A grid
# that scrolled at PAINT time would draw in one place and answer the mouse in another, which is the
# disagreement `dh_hit_test`'s clipping fix existed to end.
# ⚠ EVERY CELL IS LAID OUT, including those scrolled out of view. `dh_surface_render` clips them and
# `dh_hit_test` prunes them, and a cell that had no bounds could not be found by `dh_grid_cell_at`
# or scrolled back to.
fn dh_layout_grid(wgt, x, y, w, h): i64 {
    var pad = dh_widget_padding(wgt);
    var gap = dh_widget_gap(wgt);
    var cw = dh_grid_cell_w(wgt);
    var ch = dh_grid_cell_h(wgt);
    if (cw < 1) { cw = 1; }
    if (ch < 1) { ch = 1; }
    var cols = dh_grid_cols_for(wgt, w - pad - pad);
    var off = load64(wgt + DH_W_SCROLL_Y);
    var i = 0;
    var c = dh_widget_first_child(wgt);
    while (c != 0) {
        var col = i - (i / cols) * cols;
        var row = i / cols;
        var cx = x + pad + col * (cw + gap);
        var cy = y + pad + row * (ch + gap) - off;
        dh_layout_at(c, cx, cy, cw, ch);
        i = i + 1;
        c = dh_widget_next_sibling(c);
    }
    return DHANCHA_OK;
}

# @public — lay out `root` within an (avail_w × avail_h) box at origin (0,0).
fn dh_layout_apply(root, avail_w, avail_h): i64 {
    return dh_layout_at(root, 0, 0, avail_w, avail_h);
}

# @public — measure `root`'s natural size, then lay it out at that size
# (origin 0,0). Convenience for a window that shrinks to fit its content.
fn dh_layout_fit(root): i64 {
    var m = dh_falloc(16);           # per-frame measure scratch (0.9.15) — never retained
    dh_measure(root, m);
    return dh_layout_at(root, 0, 0, load64(m), load64(m + 8));
}

# --- list.cyr ---

# @public — dhancha LIST: a scrolling, selectable container.
# list.cyr — the POLICY over the scroll/selection state that widget.cyr stores.
#
# ⭐ WHY THIS EXISTS AS A WIDGET AND NOT AS APP CODE: every client in this stack had already
# hand-rolled it. crab's pane, puka's buffer, aethersafha's own launcher panel — three separate
# implementations of "rows, a highlight, an offset", each with its own off-by-one at the bottom
# edge. A scrolling list is the second-most-common container in a desktop after a box; a toolkit
# that does not have one is a toolkit whose users are all writing the same 60 lines.
#
# ⛔ THIS FILE OWNS NO PIXELS AND NO STATE. The offset and the selection live on the widget
# (`DH_W_SCROLL_Y` / `DH_W_SEL`); layout.cyr applies the offset when it places children; surface.cyr
# clips them. What lives here is the arithmetic that keeps those two numbers COHERENT with the
# content — which is the part that is actually easy to get wrong.
#
# ⚠ ROWS MUST BE FIXED-HEIGHT (flex 0). A flex child grows to share the container's leftover space,
# so a list of flex rows has content exactly as tall as its viewport and NOTHING EVER SCROLLS. That
# is not a bug to fix here — it is what flex means — but it is the first thing to check when a list
# refuses to move. `dh_list_add` sets flex 0 for you.

# @public — a new LIST container. Vertical box layout; `row_h` is the height every row gets.
# ⛔⛔ THE ROW HEIGHT IS `DH_W_CELL_H`, NOT `DH_W_PREF_H` (0.9.26) — AND THE OLD FORM WAS A REAL BUG.
# `DH_W_PREF_H` is the LIST'S OWN preferred height, which layout reads and any caller may set. So
# `dh_widget_set_pref(lst, 100, 50)` on a list built with `dh_list_new(20)` silently changed its row
# height from 20 to 50, and every piece of scroll arithmetic — content extent, max offset,
# keep-visible — then described a layout that never happened. Nothing failed; the list just scrolled
# wrong.
# ⚠ Found by the horizontal list's own first test run, which set a pref on the container and watched
# `dh_list_row_h` answer with it. GRID had already avoided this exact collision by giving cells their
# own fields (`DH_W_CELL_W` / `_CELL_H`, 0.9.25) — the same reasoning simply had not been applied
# back to LIST, which is older.
# ⚠ A list no longer carries a pref main-axis size of its own, so one with flex 0 and no explicit
# pref auto-sizes to its content — which is what `dh_layout_box` already does for any fixed child.
fn dh_list_new(row_h): i64 {
    var w = dh_widget_new(DhWidgetKind.LIST);
    dh_widget_set_layout(w, DhLayout.BOX_V);
    store64(w + DH_W_CELL_H, row_h);
    return w;
}

# @public — a new HORIZONTAL list: the same container laid out left-to-right. `cell_w` is the width
# every item gets.
#
# ⭐⭐ WHY THIS, AND NOT A `MENU BAR` KIND (0.9.26). A menu bar, a tab strip, a toolbar and a
# view switcher are all the same thing: a row of items, one of them current, the current one
# highlighted. Composing that from a `BOX_H` of labels would make the APP paint the highlight —
# which means the app naming `accent`, which crab's ADR 0001 forbids. So the toolkit has to own it.
# ⇒ But it does NOT need a new kind: it needs the container it already has, laid out the other way.
# That is the same answer 0.9.23 gave when it refused a kind to MENU and SHEET and composed them
# over LIST instead, and it buys four surfaces rather than one.
# ⛔ THE ORIENTATION IS READ BACK FROM `DH_W_LAYOUT`, NOT STORED TWICE. A list already sets its own
# layout mode, so a second field saying the same thing is a second thing to keep in step.
fn dh_list_new_h(cell_w): i64 {
    var w = dh_widget_new(DhWidgetKind.LIST);
    dh_widget_set_layout(w, DhLayout.BOX_H);
    store64(w + DH_W_CELL_W, cell_w);
    return w;
}

# @public — is this list laid out left-to-right? 1 = horizontal.
fn dh_list_horizontal(lst): i64 {
    if (lst == 0) { return 0; }
    if (dh_widget_layout(lst) == BOX_H) { return 1; }
    return 0;
}

# @public — the per-item size along the list's OWN axis: a row's height in a vertical list, an
# item's width in a horizontal one. -> 0 if it was never set (callers must handle it).
# ⚠ THE NAME SAYS `row_h` AND MEANS "MAIN-AXIS EXTENT" as of 0.9.26. Renaming a public entry point
# in a patch would break every consumer for a word; the meaning is stated here and at each use.
fn dh_list_row_h(lst): i64 {
    if (lst == 0) { return 0; }
    if (dh_list_horizontal(lst) == 1) { return load64(lst + DH_W_CELL_W); }
    return load64(lst + DH_W_CELL_H);
}

# The list's viewport along its own axis, inside the padding.
fn dh_list_view(lst): i64 {
    if (lst == 0) { return 0; }
    var pad = dh_widget_padding(lst);
    if (dh_list_horizontal(lst) == 1) { return dh_widget_w(lst) - pad - pad; }
    return dh_widget_h(lst) - pad - pad;
}

# The list's current offset along its own axis.
fn dh_list_offset(lst): i64 {
    if (lst == 0) { return 0; }
    if (dh_list_horizontal(lst) == 1) { return dh_widget_scroll_x(lst); }
    return dh_widget_scroll_y(lst);
}

# @public — append `row` as the next item. Sets the row's height and pins its flex to 0.
fn dh_list_add(lst, row): i64 {
    if (lst == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (row == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var rh = dh_list_row_h(lst);
    # ⚠ Pinned on the MAIN AXIS: a horizontal list sizes its items by width, a vertical one by
    # height. Pinning the wrong one leaves every item auto-sized and the scroll arithmetic — which
    # multiplies by this number — describing a layout that never happened.
    if (rh > 0) {
        if (dh_list_horizontal(lst) == 1) { store64(row + DH_W_PREF_W, rh); }
        else { store64(row + DH_W_PREF_H, rh); }
    }
    # ⚠ See the file header: a flex row cannot scroll. Pinned here rather than documented-and-hoped.
    store64(row + DH_W_FLEX, 0);
    return dh_widget_add_child(lst, row);
}

# @public — how many rows this list holds.
fn dh_list_count(lst): i64 {
    if (lst == 0) { return 0; }
    var n = 0;
    var c = dh_widget_first_child(lst);
    while (c != 0) {
        n = n + 1;
        c = dh_widget_next_sibling(c);
    }
    return n;
}

# @public — the row widget at `idx`, or 0 if out of range.
fn dh_list_row_at(lst, idx): i64 {
    if (lst == 0) { return 0; }
    if (idx < 0) { return 0; }
    var i = 0;
    var c = dh_widget_first_child(lst);
    while (c != 0) {
        if (i == idx) { return c; }
        i = i + 1;
        c = dh_widget_next_sibling(c);
    }
    return 0;
}

# @public — total height of all rows plus the gaps between them.
fn dh_list_content_h(lst): i64 {
    if (lst == 0) { return 0; }
    var n = dh_list_count(lst);
    if (n == 0) { return 0; }
    var rh = dh_list_row_h(lst);
    var gap = dh_widget_gap(lst);
    return (n * rh) + ((n - 1) * gap);
}

# @public — the largest legal scroll offset: 0 when the content fits.
# ⛔ THE `< 0` CLAMP IS THE BOTTOM-EDGE BUG. Content shorter than the viewport gives a NEGATIVE
# maximum, and a scroll clamped to a negative maximum scrolls the content UP off the top of a list
# that is not even full. Every hand-rolled version of this in the stack had it.
fn dh_list_max_scroll(lst): i64 {
    if (lst == 0) { return 0; }
    var m = dh_list_content_h(lst) - dh_list_view(lst);
    if (m < 0) { return 0; }
    return m;
}

# @public — set the scroll offset, clamped to [0, max]. -> the offset actually applied.
fn dh_list_scroll_to(lst, v): i64 {
    if (lst == 0) { return 0; }
    var m = dh_list_max_scroll(lst);
    var s = v;
    if (s < 0) { s = 0; }
    if (s > m) { s = m; }
    # ⛔ INTO THE FIELD FOR THIS LIST'S OWN AXIS. See `DH_W_SCROLL_X`: a horizontal offset stored in
    # `scroll_y` is a lie that `dh_layout_box` would then apply to the wrong axis.
    if (dh_list_horizontal(lst) == 1) { store64(lst + DH_W_SCROLL_X, s); }
    else { store64(lst + DH_W_SCROLL_Y, s); }
    return s;
}

# @public — scroll by `dy` px (positive = further down the content). -> the new offset.
fn dh_list_scroll_by(lst, dy): i64 {
    if (lst == 0) { return 0; }
    return dh_list_scroll_to(lst, dh_list_offset(lst) + dy);
}

# @public — the selected row index, or -1.
fn dh_list_selected(lst): i64 { return dh_widget_sel(lst); }

# @public — select row `idx`. -1 clears the selection. Out-of-range is REFUSED (returns -1 and
# changes nothing) rather than clamped to an end row: a caller selecting row 12 of a 4-row list has
# a bug, and silently handing it row 3 hides the bug behind a plausible highlight.
fn dh_list_select(lst, idx): i64 {
    if (lst == 0) { return 0 - 1; }
    if (idx == (0 - 1)) {
        store64(lst + DH_W_SEL, 0 - 1);
        return 0 - 1;
    }
    if (idx < 0) { return 0 - 1; }
    if (idx >= dh_list_count(lst)) { return 0 - 1; }
    # ⛔ AN INERT ROW CANNOT BE SELECTED (0.9.23). A menu separator that could be selected is a menu
    # that highlights a horizontal line when you press Down. Refused rather than nudged to a
    # neighbour, for the same reason an out-of-range index is refused: quietly handing back a
    # DIFFERENT row hides the caller's bug behind a plausible highlight.
    if (dh_widget_inert(dh_list_row_at(lst, idx)) == 1) { return 0 - 1; }
    store64(lst + DH_W_SEL, idx);
    return idx;
}

# @public — move the selection by `delta` rows, CLAMPED to the ends. -> the new index, or -1.
# ⚠ Clamped, not wrapped, and that is a deliberate split from `dh_list_select`'s refusal: arrow-key
# movement past the end is the operator holding a key down, not a bug, and stopping at the last row
# is what every list in every desktop does. Wrapping makes a held key cycle forever.
# From no selection, either direction lands on the FIRST row — the operator has expressed intent to
# enter the list, and starting at the end because they pressed Up reads as the list ignoring them.
fn dh_list_move_sel(lst, delta): i64 {
    if (lst == 0) { return 0 - 1; }
    var n = dh_list_count(lst);
    if (n == 0) { return 0 - 1; }
    var cur = dh_widget_sel(lst);
    if (cur < 0) {
        # ⚠ From no selection either direction lands on the first SELECTABLE row, which with no inert
        # rows present is row 0 exactly as before.
        var f = 0;
        while (f < n) {
            if (dh_widget_inert(dh_list_row_at(lst, f)) == 0) { store64(lst + DH_W_SEL, f); return f; }
            f = f + 1;
        }
        return 0 - 1;
    }
    var nx = cur + delta;
    if (nx < 0) { nx = 0; }
    if (nx > n - 1) { nx = n - 1; }
    # ⛔ STEP OVER INERT ROWS (0.9.23), IN THE DIRECTION OF TRAVEL. A separator the cursor can land on
    # is a menu where Down sometimes appears to do nothing — the highlight vanishes onto a rule and
    # the next press is needed to escape it.
    # ⚠ The scan is CAPPED by the row count, so a menu made entirely of separators terminates and
    # leaves the selection where it was rather than spinning.
    var dir = 1;
    if (delta < 0) { dir = 0 - 1; }
    var guard = 0;
    while (guard < n) {
        if (dh_widget_inert(dh_list_row_at(lst, nx)) == 0) { store64(lst + DH_W_SEL, nx); return nx; }
        nx = nx + dir;
        # ⚠ At an edge, reverse rather than stop: an inert LAST row must not trap the cursor there.
        if (nx < 0) { nx = 0; dir = 1; }
        if (nx > n - 1) { nx = n - 1; dir = 0 - 1; }
        guard = guard + 1;
    }
    return cur;
}

# @public — scroll the minimum distance that brings the selected row fully into view. -> the offset.
#
# ⭐⭐ THIS IS THE ONE THAT IS ALWAYS SUBTLY WRONG, and the reason it is worth writing once. The
# tempting implementation is `scroll_to(sel * row_h)`, which centres nothing and JUMPS on every
# keypress — the selected row snaps to the top of the viewport even when it was already visible in
# the middle. The correct rule is: if the row is already fully visible, DO NOT SCROLL AT ALL.
# Otherwise move by the least amount that makes it fit, which puts it at whichever edge it left.
# ⚠ Computed in CONTENT space (row 0 at y=0), not screen space, so it is independent of where the
# list happens to be laid out and testable without running layout.
fn dh_list_scroll_to_sel(lst): i64 {
    if (lst == 0) { return 0; }
    var sel = dh_widget_sel(lst);
    if (sel < 0) { return dh_list_offset(lst); }
    var rh = dh_list_row_h(lst);
    if (rh <= 0) { return dh_list_offset(lst); }
    var gap = dh_widget_gap(lst);
    var view = dh_list_view(lst);
    if (view <= 0) { return dh_list_offset(lst); }

    # ⚠ "top"/"bot" are the item's LEADING and TRAILING edges along the list's own axis — its top and
    # bottom in a column, its left and right in a row. The arithmetic is identical either way, which
    # is why one function serves both.
    var top = sel * (rh + gap);
    var bot = top + rh;
    var s = dh_list_offset(lst);

    # Above the viewport -> bring its TOP to the viewport top.
    if (top < s) { return dh_list_scroll_to(lst, top); }
    # Below the viewport -> bring its BOTTOM to the viewport bottom.
    if (bot > s + view) { return dh_list_scroll_to(lst, bot - view); }
    # ⛔ ALREADY VISIBLE — the no-op branch, and the whole point of the function.
    return s;
}

# @public — move the selection AND follow it with the viewport. The pairing every key handler wants;
# separate from `dh_list_move_sel` so a caller doing its own scrolling is not fought by this one.
fn dh_list_step(lst, delta): i64 {
    var i = dh_list_move_sel(lst, delta);
    dh_list_scroll_to_sel(lst);
    return i;
}

# @public — does keyboard focus sit on `wgt` or anywhere beneath it?
# ⚠ A LIST's selection is drawn ACCENTED when the list has focus and MUTED when it does not, which is
# the universal convention and the thing crab, puka and the launcher each re-derived. "Or beneath" is
# load-bearing: a list containing a focused button is still the active list, and a highlight that
# dropped to muted the moment focus entered a row would flicker on every interaction.
fn dh_focus_within(wgt): i64 {
    if (wgt == 0) { return 0; }
    var f = dh_focus_get();
    while (f != 0) {
        if (f == wgt) { return 1; }
        f = dh_widget_parent(f);
    }
    return 0;
}

# @public — the row index at screen point (px, py), or -1 if the point misses every row.
# ⚠ Derived from the ROWS' real bounds rather than from `(py - list_y) / row_h` arithmetic, because
# the rows' bounds are what layout actually produced and what `dh_hit_test` will agree with. Two
# independent derivations of "which row is here" is how a click lands on a different row than the
# one under the cursor.
fn dh_list_index_at(lst, px, py): i64 {
    if (lst == 0) { return 0 - 1; }
    # ⛔ THE POINT MUST BE INSIDE THE LIST **AND** INSIDE THE ROW. A row scrolled half out of the
    # viewport is still at its real coordinates, so testing the row alone leaves its hidden half
    # clickable — the mirror image of the painted-but-inert bug: inert-looking but live.
    if (dh_widget_contains(lst, px, py) == 0) { return 0 - 1; }
    var i = 0;
    var c = dh_widget_first_child(lst);
    while (c != 0) {
        if (dh_widget_contains(c, px, py) == 1) {
            # ⛔ AN INERT ROW IS NOT HIT (0.9.23). A separator that answered a click is a menu that
            # closes on a press that pointed at nothing. -1 here, not the neighbouring row: the
            # operator pointed at a gap, and acting on the item above it is worse than not acting.
            if (dh_widget_inert(c) == 1) { return 0 - 1; }
            return i;
        }
        i = i + 1;
        c = dh_widget_next_sibling(c);
    }
    return 0 - 1;
}

# --- grid.cyr ---

# @public — dhancha GRID: a wrapping, selectable grid of fixed-size cells.
# grid.cyr — the POLICY over the wrap arithmetic, the selection and the scroll that widget.cyr stores.
#
# ⭐ WHY THIS EXISTS AS A WIDGET. The same argument `list.cyr` makes, one dimension further: every
# file manager, launcher and picker in this stack wants "items in a wrapping flow, one of them
# highlighted, the whole thing scrolling" — and each would compute `cols = (w + gap) / (cell + gap)`
# for itself, get the last row's remainder wrong, and paint its own highlight.
#
# ⛔⛔ IT EARNS A KIND, AND THE BAR IS THIS REPO'S OWN. `progress.cyr` states it and 0.9.23 applied
# it by REFUSING one to MENU and SHEET: *a kind earns itself only when composing it would force the
# APP to name a theme colour, or when it expresses state no existing kind can hold.* A grid built
# from BOXes clears both — the app would paint the selected cell itself, which means naming
# `accent`, which crab's ADR 0001 forbids; and a wrapped flow is state (which cell, at which column,
# on which row) that no existing kind holds.
#
# ⛔ THIS FILE OWNS NO PIXELS AND NO STATE, exactly like `list.cyr`. The cell size lives on the
# widget (`DH_W_CELL_W` / `DH_W_CELL_H`), the selection on `DH_W_SEL`, the offset on
# `DH_W_SCROLL_Y`; `layout.cyr` places the children and `surface.cyr` clips and highlights them.
# What lives here is the arithmetic that keeps those numbers COHERENT — the part that is easy to get
# wrong and boring to get right.
#
# ⚠ FIXED-SIZE CELLS, DELIBERATELY. A grid of variable-size cells is a packing problem, and a
# packing problem has no correct keyboard navigation — "the cell below" stops being well defined.
# Every consumer this is written for shows uniform tiles.

# @public — a new GRID container. `cell_w` × `cell_h` is the size every cell gets; `gap` is the
# spacing between them, in both axes.
#
# ⚠ The layout mode is NONE: a grid places its children itself (see `dh_layout_grid`), and a BOX
# mode would have the flex distributor fight it for the same space.
fn dh_grid_new(cell_w, cell_h, gap): i64 {
    var w = dh_widget_new(DhWidgetKind.GRID);
    dh_widget_set_layout(w, DhLayout.NONE);
    var cw = cell_w;
    var ch = cell_h;
    # ⛔ A ZERO OR NEGATIVE CELL WOULD DIVIDE BY ZERO IN THE WRAP. Clamped here, at the one place a
    # cell size can be set, rather than defended at every reader.
    if (cw < 1) { cw = 1; }
    if (ch < 1) { ch = 1; }
    store64(w + DH_W_CELL_W, cw);
    store64(w + DH_W_CELL_H, ch);
    var g = gap;
    if (g < 0) { g = 0; }
    store64(w + DH_W_GAP, g);
    return w;
}

fn dh_grid_cell_w(g): i64 { if (g == 0) { return 0; } return load64(g + DH_W_CELL_W); }
fn dh_grid_cell_h(g): i64 { if (g == 0) { return 0; } return load64(g + DH_W_CELL_H); }

# @public — append `cell` as the next item. Pins its size and its flex, for the reason `dh_list_add`
# pins a row's: a flex child grows to share leftover space, and a grid of flex cells has content
# exactly as tall as its viewport and never scrolls.
fn dh_grid_add(g, cell): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (cell == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(cell + DH_W_PREF_W, dh_grid_cell_w(g));
    store64(cell + DH_W_PREF_H, dh_grid_cell_h(g));
    store64(cell + DH_W_FLEX, 0);
    return dh_widget_add_child(g, cell);
}

# @public — how many cells this grid holds.
fn dh_grid_count(g): i64 {
    if (g == 0) { return 0; }
    var n = 0;
    var c = dh_widget_first_child(g);
    while (c != 0) {
        n = n + 1;
        c = dh_widget_next_sibling(c);
    }
    return n;
}

# @public — the cell at index `i`, or 0.
fn dh_grid_cell_at(g, i): i64 {
    if (g == 0) { return 0; }
    if (i < 0) { return 0; }
    var n = 0;
    var c = dh_widget_first_child(g);
    while (c != 0) {
        if (n == i) { return c; }
        n = n + 1;
        c = dh_widget_next_sibling(c);
    }
    return 0;
}

# @public — how many cells fit across a grid `avail_w` wide. Always at least 1.
#
# ⛔ THIS IS THE ARITHMETIC THE WIDGET EXISTS FOR, and the off-by-one is in the gap: `n` cells carry
# `n - 1` gaps, not `n`. Solving `n*cell + (n-1)*gap <= avail` gives `n = (avail + gap) / (cell +
# gap)` — the `+ gap` is what accounts for the gap the last cell does not have. Dropping it loses a
# column at exactly the widths where a column fits perfectly, which is the width a caller is most
# likely to have chosen on purpose.
# ⚠ NEVER ZERO. A grid narrower than one cell shows one cell clipped, which is visible and
# recoverable; zero columns is a division by zero in every reader below.
fn dh_grid_cols_for(g, avail_w): i64 {
    if (g == 0) { return 1; }
    var cw = dh_grid_cell_w(g);
    if (cw < 1) { return 1; }
    var gap = dh_widget_gap(g);
    var n = (avail_w + gap) / (cw + gap);
    if (n < 1) { n = 1; }
    return n;
}

# @public — the number of columns this grid was last LAID OUT with.
#
# ⛔ READ FROM THE LAYOUT, NOT RECOMPUTED FROM THE PREF. Navigation has to agree with what the
# operator can see: `dh_grid_move_sel` moving "down" by a different column count than the one on
# screen is the class of bug where the cursor jumps two rows and nobody can say why. The grid's
# resolved width is what layout actually used, so that is what this reads.
fn dh_grid_cols(g): i64 {
    if (g == 0) { return 1; }
    var pad = dh_widget_padding(g);
    return dh_grid_cols_for(g, dh_widget_w(g) - pad - pad);
}

# @public — total content height: every row of cells plus the gaps between them.
fn dh_grid_content_h(g): i64 {
    if (g == 0) { return 0; }
    var n = dh_grid_count(g);
    if (n < 1) { return 0; }
    var cols = dh_grid_cols(g);
    # ⚠ Ceiling division: 7 cells in 3 columns is 3 rows, not 2.
    var rows = (n + cols - 1) / cols;
    var ch = dh_grid_cell_h(g);
    var gap = dh_widget_gap(g);
    return rows * ch + (rows - 1) * gap;
}

# @public — the largest legal scroll offset. Never negative: content shorter than the viewport
# does not scroll at all.
fn dh_grid_max_scroll(g): i64 {
    if (g == 0) { return 0; }
    var pad = dh_widget_padding(g);
    var view = dh_widget_h(g) - pad - pad;
    var m = dh_grid_content_h(g) - view;
    if (m < 0) { m = 0; }
    return m;
}

# @public — set the scroll offset, clamped to [0, max].
fn dh_grid_scroll_to(g, y): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var v = y;
    if (v < 0) { v = 0; }
    var m = dh_grid_max_scroll(g);
    if (v > m) { v = m; }
    store64(g + DH_W_SCROLL_Y, v);
    return DHANCHA_OK;
}

fn dh_grid_scroll_by(g, dy): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    return dh_grid_scroll_to(g, load64(g + DH_W_SCROLL_Y) + dy);
}

# @public — the selected cell index, or -1.
fn dh_grid_selected(g): i64 {
    if (g == 0) { return 0 - 1; }
    return load64(g + DH_W_SEL);
}

# @public — select cell `i`. Out of range is refused rather than clamped: a caller that computed a
# bad index wants to know, and silently landing on the last cell hides it.
# ⚠ `DH_FLAG_INERT` cells are refused, exactly as `dh_list_select` refuses an inert row — a grid can
# carry a placeholder for a file it could not read, and selecting one means acting on nothing.
fn dh_grid_select(g, i): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (i < 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (i >= dh_grid_count(g)) { return DHANCHA_ERR_BAD_WIDGET; }
    var c = dh_grid_cell_at(g, i);
    if (c != 0) {
        if ((dh_widget_flags(c) & DH_FLAG_INERT) != 0) { return DHANCHA_ERR_BAD_WIDGET; }
    }
    store64(g + DH_W_SEL, i);
    return DHANCHA_OK;
}

# @public — move the selection by `dx` columns and `dy` rows. -> DHANCHA_OK if it moved.
#
# ⛔⛔ A GRID'S ARROW KEYS ARE NOT A LIST'S, AND THIS IS THE WHOLE REASON THE KIND EXISTS. Left and
# right step by one; up and down step by a WHOLE ROW. An app driving a grid with `dh_list_move_sel`
# gets a cursor that walks the flow one cell at a time and appears to move diagonally.
#
# ⛔ HORIZONTAL MOVEMENT DOES NOT WRAP TO THE NEXT ROW. Right at the end of a row stays put. The
# grid is a 2-D arrangement the operator can see, so the cursor must move the way the arrow points —
# wrapping makes "right" mean "down and all the way left", which is not what was pressed. ⚠ The
# context MENU wraps and is right to: six items visible at once, where running off the end and
# continuing is faster than stopping. A grid of a thousand files is the opposite case.
# ⚠ Vertical movement past the last row is REFUSED rather than clamped to the final cell, for the
# same reason: down from the second-to-last row lands nowhere if that column has no cell below it,
# and jumping sideways to the last one is a move nobody asked for.
fn dh_grid_move_sel(g, dx, dy): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var n = dh_grid_count(g);
    if (n < 1) { return DHANCHA_ERR_BAD_WIDGET; }
    var cols = dh_grid_cols(g);
    var cur = dh_grid_selected(g);
    # An unset selection lands on the first cell, whichever direction was pressed — the operator
    # asked to start navigating and the answer is "here".
    if (cur < 0) { return dh_grid_step(g, 0, 1); }
    var col = cur - (cur / cols) * cols;
    var row = cur / cols;
    var ncol = col + dx;
    var nrow = row + dy;
    if (ncol < 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (ncol >= cols) { return DHANCHA_ERR_BAD_WIDGET; }
    if (nrow < 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var t = nrow * cols + ncol;
    if (t >= n) { return DHANCHA_ERR_BAD_WIDGET; }
    # ⚠ Step over an inert cell in the direction of travel, as a list does — a placeholder must not
    # trap the cursor.
    var dir = 1;
    if (dx < 0) { dir = 0 - 1; }
    if (dy < 0) { dir = 0 - 1; }
    return dh_grid_step(g, t, dir);
}

# Select `from`, or the next selectable cell in direction `dir` (+1 / -1). -> DHANCHA_OK if one was
# found. ⚠ Bounded by the cell count, so a grid of entirely inert cells terminates rather than
# spinning — the same guard `dh_list_move_sel` carries.
fn dh_grid_step(g, from, dir): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var n = dh_grid_count(g);
    var i = from;
    var tries = 0;
    while (tries < n) {
        if (i >= 0) {
            if (i < n) {
                if (dh_grid_select(g, i) == DHANCHA_OK) { return DHANCHA_OK; }
            }
        }
        i = i + dir;
        tries = tries + 1;
    }
    return DHANCHA_ERR_BAD_WIDGET;
}

# @public — scroll the minimum distance that brings the selected cell fully into view.
#
# ⚠ MINIMUM MOVE, like `dh_list_scroll_to_sel`: a selection already visible does not scroll at all,
# and one just off an edge moves by exactly the shortfall. Snapping the selection to the top on
# every step is the behaviour that makes a grid feel like it is fighting the operator.
fn dh_grid_scroll_to_sel(g): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var sel = dh_grid_selected(g);
    if (sel < 0) { return DHANCHA_OK; }
    var cols = dh_grid_cols(g);
    var row = sel / cols;
    var ch = dh_grid_cell_h(g);
    var gap = dh_widget_gap(g);
    var top = row * (ch + gap);
    var bot = top + ch;
    var off = load64(g + DH_W_SCROLL_Y);
    var pad = dh_widget_padding(g);
    var view = dh_widget_h(g) - pad - pad;
    if (top < off) { return dh_grid_scroll_to(g, top); }
    if (bot > off + view) { return dh_grid_scroll_to(g, bot - view); }
    return DHANCHA_OK;
}

# @public — which cell contains point (px, py) in SURFACE coordinates? -> index, or -1.
#
# ⛔ FROM THE LAID-OUT CELLS, NOT FROM THE ARITHMETIC. Recomputing row and column from the pointer
# would be a second answer to "where is cell i", free to disagree with the one layout produced —
# and it is the disagreement, not either answer, that makes a click land on the wrong file. The gaps
# BETWEEN cells belong to no cell, and walking the children is what gets that right for free.
# ⚠ An inert cell reports -1, matching `dh_list_index_at`: a placeholder the keyboard steps over
# must not be clickable either.
fn dh_grid_index_at(g, px, py): i64 {
    if (g == 0) { return 0 - 1; }
    var i = 0;
    var c = dh_widget_first_child(g);
    while (c != 0) {
        var cx = dh_widget_x(c);
        var cy = dh_widget_y(c);
        if (px >= cx) {
            if (px < cx + dh_widget_w(c)) {
                if (py >= cy) {
                    if (py < cy + dh_widget_h(c)) {
                        if ((dh_widget_flags(c) & DH_FLAG_INERT) != 0) { return 0 - 1; }
                        return i;
                    }
                }
            }
        }
        i = i + 1;
        c = dh_widget_next_sibling(c);
    }
    return 0 - 1;
}

# --- menu.cyr ---

# @public — dhancha MENU: a popup menu, which is a LIST wearing a panel.
# menu.cyr — the POLICY over "a list of commands". Like list.cyr, table.cyr and progress.cyr this
# file owns no pixels and no state of its own.
#
# ⭐⭐ WHY THIS IS NOT A NEW `DhWidgetKind`, AND THE TEST IT HAD TO PASS. `src/progress.cyr`'s header
# sets the bar: a kind earns itself only when composing it would force the APP to name a theme colour
# (crab's ADR 0001), or when it expresses state no existing kind can hold. A menu clears NEITHER.
# LIST already holds the selection in `DH_W_SEL` and already paints the highlight from
# `dh_theme_accent()` / `dh_theme_line()` inside surface.cyr — so no app names a colour — and every
# function below is arithmetic over parts that shipped in 0.9.7 and 0.9.19.
# ⇒ The counter-precedent is `table.cyr`: a whole table feature with no kind, keeping colour out of
# the app by naming it HERE, in the module. This file takes that shape.
# ⚠ Reusing LIST also inherits six things a MENU kind would have to re-derive and re-test: the
# negative-scroll clamp, the bottom-edge fix, keep-selected-visible's no-op branch, the focused vs
# muted highlight split, the on-accent legibility guarantee, and the paint/hit clip agreement.
#
# ⛔ A MENU'S INDEX SPACE **IS** THE LIST'S CHILD INDEX SPACE. There is deliberately no second index:
# `dh_list_select` / `dh_list_move_sel` / `dh_list_index_at` are the menu's selection API, and
# separators simply occupy indices that `DH_FLAG_INERT` makes unselectable and unhittable. Two index
# spaces is how a click lands on a different item than the one under the cursor.

enum DhMenu {
    DH_MENU_PAD    = 5;
    DH_MENU_GAP    = 1;
    DH_MENU_SEP_H  = 9;
    DH_MENU_SEP_IN = 4;    # the rule is inset this far on each side, so it reads as a divider
}

# @public — a menu panel: a LIST with the panel background, a 1px `line` border, padding and a 1px
# gap between items. `row_h` is every ITEM's height.
#
# ⛔ ITS WIDTH AND HEIGHT ARE LEFT 0 AND THE CALLER MUST SET THEM. `dh_list_new` smuggles `row_h`
# into `DH_W_PREF_H`, and layout treats a non-zero pref as an EXACT size — so a menu handed to the
# layout engine unsized collapses to exactly ONE ROW TALL. Use `dh_menu_pref_h`.
fn dh_menu_new(row_h): i64 {
    var m = dh_list_new(row_h);
    if (m == 0) { return 0; }
    dh_widget_set_bg(m, dh_theme_panel());
    dh_widget_set_border(m, dh_theme_line());
    dh_widget_set_padding(m, DH_MENU_PAD);
    dh_widget_set_gap(m, DH_MENU_GAP);
    return m;
}

# @public — append a command row: `label` on the left, `shortcut` right-aligned in the secondary ink.
# `spec` is a 2-column DhCols. `shortcut` may be 0 for an item with no accelerator; the column is
# still reserved so every label starts at the same x. -> the row widget, or 0.
#
# ⚠ ONE SPEC FOR THE WHOLE MENU, for exactly the reason `table.cyr` exists: rows laid out
# independently drift the moment one string changes width, and a menu whose shortcut column drifts
# reads as broken.
# ⛔ ALLOCATE THE SPEC ONCE AND `dh_cols_reset` IT. `dh_cols_new` draws on the GLOBAL allocator, so a
# spec built inside a per-frame render function is a 40-byte-per-frame leak — the exact gate crab
# spent four releases closing.
fn dh_menu_item(menu, spec, label, shortcut): i64 {
    if (menu == 0) { return 0; }
    var row = dh_table_row(spec);
    if (row == 0) { return 0; }
    dh_widget_set_bg(row, 0 - 1);          # no background: the LIST paints the highlight
    dh_table_cell(row, spec, 0, label);
    if (shortcut != 0) {
        var c = dh_table_cell(row, spec, 1, shortcut);
        # ⚠ The accelerator is SECONDARY ink — it labels the row rather than being the row.
        if (c != 0) { dh_widget_set_fg(c, dh_theme_mute()); }
    }
    dh_list_add(menu, row);
    return row;
}

# @public — append a separator: an INERT row carrying a 1px `line` rule, inset on each side.
# -> the separator widget, or 0.
#
# ⛔ IT IS A ROW, NOT A GAP, AND IT IS INERT RATHER THAN MERELY UNPAINTED. A separator that could be
# selected is a menu that highlights a horizontal line when you press Down; one that could be hit is
# a menu that closes on a click that pointed at nothing.
# ⛔ AND IT BREAKS SCROLLING, WHICH IS SAID HERE RATHER THAN DISCOVERED. `dh_list_scroll_to_sel` and
# `dh_list_max_scroll` derive content height from `n * row_h` — uniform rows. A menu WITHOUT
# separators scrolls exactly like any LIST; a menu WITH them must be given its full `dh_menu_pref_h`
# and must not scroll. That is the contract, and it is why `dh_menu_pref_h` exists.
fn dh_menu_sep(menu): i64 {
    if (menu == 0) { return 0; }
    var s = dh_widget_new(BOX);
    if (s == 0) { return 0; }
    dh_widget_set_bg(s, 0 - 1);
    dh_widget_set_pref(s, 0, DH_MENU_SEP_H);
    dh_widget_set_inert(s, 1);
    var rule = dh_widget_new(BOX);
    dh_widget_set_bg(rule, dh_theme_line());
    dh_widget_set_pref(rule, 0, 1);
    dh_widget_set_inert(rule, 1);
    dh_widget_set_layout(s, BOX_V);
    dh_widget_set_padding(s, DH_MENU_SEP_IN);
    dh_widget_add_child(s, rule);
    dh_list_add(menu, s);
    # ⛔ THE HEIGHT IS SET **AFTER** `dh_list_add`, AND THAT ORDERING IS THE WHOLE FUNCTION.
    # `dh_list_add` stamps the LIST's row height onto every child it takes — that is what makes rows
    # uniform without each one being told — so a separator sized before the add is silently resized
    # to a full row and the menu grows by 13px per separator with nothing to show for it. Setting it
    # afterwards is the only order that survives.
    dh_widget_set_pref(s, 0, DH_MENU_SEP_H);
    return s;
}

# @public — the menu's natural height: every child's pref height, plus the gaps, plus 2x padding.
#
# ⚠ SUMS THE CHILDREN rather than calling `dh_list_content_h`, which assumes uniform rows and is
# wrong by the separator's extra height for every separator present. Two derivations of one number
# is the bug this replaces.
fn dh_menu_pref_h(menu): i64 {
    if (menu == 0) { return 0; }
    var total = 0;
    var n = 0;
    var c = dh_widget_first_child(menu);
    while (c != 0) {
        var ph = dh_widget_pref_h(c);
        # ⚠ A child with no pref of its own takes the LIST's row height, which is what `dh_list_add`
        # stamps on it — so this reads the stamped value rather than re-deriving it.
        if (ph <= 0) { ph = dh_widget_pref_h(menu); }
        total = total + ph;
        n = n + 1;
        c = dh_widget_next_sibling(c);
    }
    if (n > 1) { total = total + (n - 1) * dh_widget_gap(menu); }
    return total + 2 * dh_widget_padding(menu);
}

# --- overlay.cyr ---

# @public — dhancha OVERLAY: the layer a popup lives in, and where a popup goes inside it.
# overlay.cyr — geometry and paint. No routing, no retained state, no dismissal policy.
#
# ⛔⛔ THE LAYER MUST BE THE LAST CHILD OF THE ROOT, AND THAT IS NOT A STYLE PREFERENCE.
# `dh_hit_test` prunes on `dh_widget_contains(root, ...)` at EVERY level, and the painter culls and
# intersects identically — no level can widen what an ancestor narrowed. A popup parented to the row
# that spawned it therefore overflows its parent and becomes invisible AND unclickable together,
# which looks half-drawn rather than dead: the more confusing of the two. `event.cyr` says it
# outright — an overlay layer that must escape its parent "needs its own root, NOT a relaxation here".
# ⇒ Sibling order IS z-order in BOTH passes: children are walked first-to-last and a later match
# overwrites, matching the paint order. A full-window layer added LAST wins the click and the pixel
# together, by construction.
#
# ⛔ AND AN OFFSET IS MEASURED FROM THE LAYER'S PADDED CONTENT ORIGIN. `dh_overlay_new` sets pad 0
# and leaves both prefs 0, so in a NONE root at (0,0) with pad 0 the layer's content origin IS (0,0)
# and an offset is a window coordinate. Any other root, and the caller subtracts.

enum DhPin {
    DH_PIN_BOTTOM = 0;
    DH_PIN_TOP    = 1;
    DH_PIN_CENTER = 2;
}

# @public — a full-window overlay layer: a NONE container with no background and no padding.
# ⚠ NO BACKGROUND BY DEFAULT — an overlay that dimmed unconditionally could not be used for a menu,
# which dims nothing. Call `dh_widget_set_scrim(layer, 1)` for a sheet's backdrop.
fn dh_overlay_new(): i64 {
    var l = dh_widget_new(BOX);
    if (l == 0) { return 0; }
    dh_widget_set_layout(l, NONE);
    dh_widget_set_bg(l, 0 - 1);
    dh_widget_set_padding(l, 0);
    return l;
}

# @public — a sheet panel: a BOX with the panel background, a 1px `line` border and padding. The
# caller sets the layout mode and adds children; `dh_place_pinned` sizes and positions it.
#
# ⚠ NO RADIUS AND NO SHADOW, SAID RATHER THAN APPROXIMATED. `rupa_theme_radius` is published and
# dhancha has never read it, and sadish has no shadow primitive. The design canvas draws 14px corners
# and a 40px shadow and neither is expressible today. The BORDER is what says "this is a layer".
fn dh_sheet_new(): i64 {
    var s = dh_widget_new(BOX);
    if (s == 0) { return 0; }
    dh_widget_set_bg(s, dh_theme_panel());
    dh_widget_set_border(s, dh_theme_line());
    dh_widget_set_padding(s, 10);
    return s;
}

# @public — where a popup goes when it is anchored to a POINT (a context menu at the pointer).
# Writes x/y/w/h into `out32` (a 32-byte DhRect).
# -> DHANCHA_OK, or DHANCHA_ERR_BAD_ARG when the popup had to be SHRUNK to fit — in which case
#    `out32` still holds a usable rect rather than nothing.
#
# ⚠ SHRINKING IS REPORTED, NOT REFUSED — `dh_progress_set`'s discipline, not `dh_list_select`'s. A
# window smaller than the menu is a real situation an operator creates by dragging an edge, so the
# DISPLAY never lies and the CALLER is still told.
# ⛔ THE ORDER IS FLIP, THEN CLAMP, THEN SHRINK — and it FLIPS rather than merely sliding. A menu
# that slid up to fit would sit UNDER the pointer that opened it, so the first thing the operator
# sees is their own cursor on top of an item they did not choose. Flipping to the other side of the
# point keeps the anchor outside the menu.
fn dh_place_at_point(out32, px, py, pw, ph, aw, ah, margin): i64 {
    var w = pw;
    var h = ph;
    var shrunk = 0;
    var maxw = aw - margin - margin;
    var maxh = ah - margin - margin;
    if (maxw < 1) { maxw = 1; }
    if (maxh < 1) { maxh = 1; }
    if (w > maxw) { w = maxw; shrunk = 1; }
    if (h > maxh) { h = maxh; shrunk = 1; }
    var x = px;
    var y = py;
    if (x + w > aw - margin) { x = px - w; }          # flip to the left of the point
    if (y + h > ah - margin) { y = py - h; }          # flip above the point
    if (x < margin) { x = margin; }
    if (y < margin) { y = margin; }
    if (x + w > aw - margin) { x = aw - margin - w; }
    if (y + h > ah - margin) { y = ah - margin - h; }
    if (x < 0) { x = 0; }
    if (y < 0) { y = 0; }
    store64(out32 + 0, x);
    store64(out32 + 8, y);
    store64(out32 + 16, w);
    store64(out32 + 24, h);
    if (shrunk == 1) { return DHANCHA_ERR_BAD_ARG; }
    return DHANCHA_OK;
}

# @public — where a popup goes when it is anchored to an EDGE (a sheet). Same rect + return contract.
#
# ⚠ DH_PIN_BOTTOM IS FULL-BLEED: x = 0, w = aw, and `h` is clamped so a strip of the layer ALWAYS
# shows above the panel. That strip is what the scrim is drawn on — and a sheet that covered its own
# scrim would be a screen with no way to say what it is covering.
fn dh_place_pinned(out32, pw, ph, aw, ah, edge, margin): i64 {
    var h = ph;
    var shrunk = 0;
    var maxh = ah - margin;
    if (maxh < 1) { maxh = 1; }
    if (h > maxh) { h = maxh; shrunk = 1; }
    var w = pw;
    var x = (aw - w) / 2;
    if (edge != DH_PIN_CENTER) { w = aw; x = 0; }     # BOTTOM and TOP are full-bleed
    if (w > aw) { w = aw; shrunk = 1; }
    if (x < 0) { x = 0; }
    var y = ah - h;                                   # DH_PIN_BOTTOM
    if (edge == DH_PIN_TOP) { y = 0; }
    if (edge == DH_PIN_CENTER) { y = (ah - h) / 2; }
    if (y < 0) { y = 0; }
    store64(out32 + 0, x);
    store64(out32 + 8, y);
    store64(out32 + 16, w);
    store64(out32 + 24, h);
    if (shrunk == 1) { return DHANCHA_ERR_BAD_ARG; }
    return DHANCHA_OK;
}

# --- progress.cyr ---

# @public — dhancha PROGRESS: a determinate-or-indeterminate bar.
# progress.cyr — the POLICY over "how full". Like list.cyr and table.cyr this file owns no pixels and
# no state of its own: the number lives on the widget (`DH_W_FILL`), and surface.cyr paints it.
#
# ⭐ WHY A KIND AND NOT A BOX WITH A COLOURED CHILD. A bar CAN be built from parts that already
# exist — a BOX with `bg = line` holding two flex children weighted `done` and `remaining` lays out
# to exactly the right pixel, because the distributor hands its LAST flex share the exact remainder
# (layout.cyr). It was rejected because the APP would then be naming `dh_theme_accent()` itself, and
# crab's ADR 0001 forbids that outright: an app that names one colour will name the next one to work
# around a missing token instead of asking for it. Every app that hand-rolls a bar also picks its own
# track colour — the same three-implementations-of-one-thing that made LIST a kind. A kind costs one
# widget per bar instead of three, and it is the only form that can express INDETERMINATE at all.
#
# ⛔ INDETERMINATE IS NOT A CONVENIENCE, AND `den <= 0` IS NOT AN ERROR. Callers really do have no
# denominator: crab's size array carries -2 (pending) and -1 (unstattable) as DISTINCT first-class
# values and refuses to conflate them; a rename moves zero bytes and has no total; a recursive delete
# has no byte total at all, only a count discovered while walking. A determinate-only bar forces
# those callers to invent a denominator — and a bar reading 40% because someone guessed is strictly
# worse than one that admits it does not know.
#
# ⚠ THE BAR CARRIES NO TEXT, DELIBERATELY. One centred "68%" straddling the fill edge cannot be
# legible in a single ink: `on-accent` over the `line` track and plain `ink` over the `accent` fill
# both fall near 1.3:1 on the dark grounds. Put the percentage in a SIBLING label, outside the bar,
# in `ink`. The generic text path still draws a text set on a PROGRESS — it is drawn ON TOP of the
# bar rather than refused — but it inherits that contrast problem and nothing here can fix it.
#
# ⚠ HIT-TESTING IS KIND-BLIND AND THERE IS NO OPT-OUT. A PROGRESS with non-zero bounds is hittable
# like anything else, and a later sibling beats an earlier one. A bar overlapping a button in a NONE
# container will take the click. Not new, not fixable here, and worth knowing before you overlap one.

# @public — a new PROGRESS bar `thickness` px tall, starting INDETERMINATE.
#
# ⚠ `thickness` is a PLAIN `DH_W_PREF_H`, not payload smuggled into a layout field the way
# `dh_list_new` stores its row height. A bar's preferred height IS its height, so layout treating it
# as an exact size is the INTENT here rather than the hazard it is for LIST. It follows that a bar is
# a fixed-height child.
# ⛔ ITS WIDTH IS LEFT 0. Set `dh_widget_set_flex(bar, 1)` or a `pref_w`, or the bar measures 0 wide
# and the draw path culls it before painting anything. That is the first thing to check on a bar that
# renders nothing.
# ⚠ In a BOX_V the bar's `pref_h` is the MAIN axis and is honoured exactly. In a BOX_H it is the
# CROSS axis, where ALIGN_STRETCH (the default) fills the row height and ignores `pref_h` — use
# ALIGN_CENTER there, or put the bar in a BOX_V.
fn dh_progress_new(thickness): i64 {
    var t = thickness;
    if (t < 1) { t = 1; }                  # a 0-px bar is an invisible control, not a thin one
    var w = dh_widget_new(DhWidgetKind.PROGRESS);
    store64(w + DH_W_PREF_H, t);
    return w;
}

# @public — set how full the bar is, from an integer numerator/denominator pair.
# `den <= 0` means INDETERMINATE (see the ⛔ in the header) and is NOT an error.
# -> DHANCHA_OK; DHANCHA_ERR_BAD_WIDGET on a null bar; DHANCHA_ERR_BAD_ARG when `num` was out of
#    range — in which case the bar is still CLAMPED to something sane rather than left stale.
#
# ⚠ OUT-OF-RANGE IS CLAMPED HERE, NOT REFUSED, WHICH IS THE OPPOSITE OF `dh_list_select`. Refusing is
# right for a selection: selecting row 12 of a 4-row list names a row that does not exist, and
# quietly handing back row 3 hides the bug behind a plausible highlight. A transfer is not that case
# — a size stat taken before a copy can legitimately disagree with the bytes actually written — and a
# bar frozen at its last value while the operation is visibly running is worse than one pinned at
# full. So the DISPLAY never lies and the CALLER is still told.
#
# ⚠ PERMILLE, NOT PERCENT, AND MULTIPLY BEFORE DIVIDING. Percent is one step per 3 px on a 300 px
# bar, which is visibly steppy; and `num * (1000 / den)` written the other way round truncates to
# ZERO for every value below `den`, so the bar would sit at 0 until the very last chunk.
# ⛔ `num` is clamped to `den` FIRST, so the product is bounded by `den * 1000` — `den` would have to
# exceed nine petabytes before it overflows i64. Byte counts will not.
fn dh_progress_set(bar, num, den): i64 {
    if (bar == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (den <= 0) {
        store64(bar + DH_W_FILL, 0 - 1);
        return DHANCHA_OK;
    }
    var bad = 0;
    var n = num;
    if (n < 0) { n = 0; bad = 1; }
    if (n > den) { n = den; bad = 1; }
    store64(bar + DH_W_FILL, n * 1000 / den);
    if (bad == 1) { return DHANCHA_ERR_BAD_ARG; }
    return DHANCHA_OK;
}

# @public — how full the bar is, in PERMILLE (0..1000), or -1 = indeterminate.
# ⚠ -1 for a null widget too. It is the same "no answer" this getter already has a value for, and it
# matches `dh_widget_fg` and `dh_widget_sel`, which both return a neutral sentinel rather than an
# error code a caller would have to tell apart from a real reading.
fn dh_progress_permille(bar): i64 {
    if (bar == 0) { return 0 - 1; }
    return load64(bar + DH_W_FILL);
}

# --- event.cyr ---

# @public — dhancha input dispatch + event loop.
# event.cyr — this module OWNS the input-dispatch role.
#
# Input (keyboard / pointer) arrives from the aethersafha compositor over
# the native display-protocol connection as DhEvents. dh_dispatch resolves a
# target (the focused widget for keys, the widget under the pointer for
# clicks) and BUBBLES the event up the parent chain, invoking each node's
# handler until one CONSUMES it. dh_run pumps a DhQueue of events and
# dispatches them until the queue drains or a handler calls dh_quit.
#
# Wire model (the compositor input convention): a pointer BUTTON
# event carries (button, state) but NOT coordinates — the compositor
# tracks position from MOTION events. So dhancha keeps the current
# pointer position (updated on POINTER_MOVE) and hit-tests button/drag
# events against it, not against the button event's payload.
#
# The compositor-fd source (decode the native protocol's input wire bytes
# into DhEvents and pump the transport) is a later bite (see CHANGELOG); the
# DhQueue is the seam it will feed. Until then a caller (or a test) posts
# DhEvents into the queue directly, keeping the whole dispatch path usable.

# The kinds of input event the toolkit routes.
enum DhEventKind {
    KEY           = 0;   # keyboard key: keysym / codepoint in `a`, mods in `b`
    POINTER_MOVE  = 1;   # pointer motion to (x=`a`, y=`b`)
    POINTER_BTN   = 2;   # pointer button: code in `a`, state in `b` (0=release,1=press)
    FOCUS         = 3;   # focus enter/leave
    DRAG          = 4;   # raw drag phase (hit-tests at the tracked pointer)
    POINTER_ENTER = 5;   # synthesized: pointer entered a widget (hover)
    POINTER_LEAVE = 6;   # synthesized: pointer left a widget (hover)
    ACTIVATE      = 7;   # synthesized: click / keyboard activation of a widget
    DRAG_START    = 8;   # synthesized: a drag began on a draggable widget (to source)
    DRAG_MOVE     = 9;   # synthesized: pointer moved while dragging (to source)
    DRAG_DROP     = 10;  # synthesized: drag released over a drop target
    DRAG_END      = 11;  # synthesized: drag finished (to source)
    # ⛔⛔ WINDOW_CLOSE IS NOT AN INPUT EVENT AND IT IS THE MOST IMPORTANT ONE TO DELIVER. The
    # compositor sends SETU_CLOSE when it removes a client's window. A client that keeps running
    # holds its `#97` channel end and its `#86` GPU-visible shm slot for the rest of the boot — and
    # there are only 16 of those slots system-wide. Its EXIT is what releases them, so this is a
    # release path, not a courtesy. Measured on the 2026-08-08 iron burn: a client that ignored it
    # was left orphaned alive. An event mapper that drops it recreates that leak in every consumer.
    WINDOW_CLOSE  = 12;
    # ⭐⭐ THE COMPOSITOR ASKS FOR A NEW SIZE (`SETU_CONFIGURE`; `a` = width, `b` = height).
    # ⛔ IT IS AN ASK, NOT A FACT. The compositor cannot resize a client's buffer — the buffer is the
    # client's, and on agnos it is a `#86` slot the client owns. Until the client re-attaches at this
    # size the compositor CLAMPS or REFUSES its blit, so a client that ignores this event does not
    # crash, it FREEZES at its old extent. Before aethersafha 0.16.8 there was no clamp and no ask:
    # the blit read `win_w x win_h` out of the smaller slot and took a page fault.
    WINDOW_CONFIGURE = 13;
    # ⭐ 0.9.18 — the wheel. `a` = signed delta, POSITIVE = wheel-up (away from the user). Summed by
    # the compositor since its last forward, so one event may carry several detents.
    # ⛔ NOT A `POINTER_BTN` WITH A MAGIC BUTTON CODE. X11 spends buttons 4/5 on wheel detents; a
    # toolkit that copied that would make `POINTER_BTN`'s `a` mean two things and turn a scroll into a
    # click in every consumer that range-checks buttons rather than enumerating them.
    # ⚠ NO POSITION. A scroll carries none on the wire (setu `SETU_INPUT_PTR_SCROLL` is id + delta),
    # for the same reason `POINTER_BTN` carries none: the pointer is wherever the last `POINTER_MOVE`
    # left it, and `dh_dispatch` already tracks that in `_dh_ptr_x`/`_dh_ptr_y`.
    POINTER_SCROLL = 14;
}

# Well-known key codes the toolkit acts on itself (values are ASCII /
# Unicode codepoints, matching the puka keymap's sym space).
enum DhKey {
    DH_KEY_BACKSPACE = 8;
    DH_KEY_TAB    = 9;
    DH_KEY_ENTER  = 10;
    DH_KEY_RETURN = 13;
    DH_KEY_SPACE  = 32;
    # ⭐ NAMED (non-Unicode) KEYS. ⛔ THESE VALUES ARE NOT FREE TO CHOOSE — they are puka's
    # `InputKey`, verbatim, because the header above already promises this enum IS puka's sym space
    # and puka is the component that turns compositor key events into syms for the whole desktop.
    # A toolkit numbering Left as 3 while its input source sends 0x110003 does not fail loudly; it
    # silently edits text on arrow keys. KEY_BASE = 0x110000 is one past UC_MAX, so no codepoint
    # can collide with a named key.
    DH_KEY_UP     = 0x110000;
    DH_KEY_DOWN   = 0x110001;
    DH_KEY_RIGHT  = 0x110002;
    DH_KEY_LEFT   = 0x110003;
    DH_KEY_HOME   = 0x110004;
    DH_KEY_END    = 0x110005;
    DH_KEY_DELETE = 0x110007;
}

# Event propagation phase (DH_E_PHASE): a dispatched event runs a CAPTURE
# pass (root -> target, capture handlers) then a BUBBLE pass (target ->
# root, bubble handlers). A handler reads dh_event_phase to tell them apart.
enum DhPhase {
    DH_PHASE_CAPTURE = 1;
    DH_PHASE_BUBBLE  = 2;
}

# Pointer travel (Manhattan distance from the press point) before a press
# on a draggable widget is promoted to a drag, so a jittery click doesn't
# accidentally start one.
var DH_DRAG_THRESHOLD = 4;

# DhEvent struct layout (56 bytes):
#   +0:  kind    — one of DhEventKind
#   +8:  a       — primary payload (keysym / x / button code)
#   +16: b       — secondary payload (mods / y / button state)
#   +24: target  — resolved target DhWidget* (0 = unrouted): the ORIGINAL
#                  hit/focus node (propagation still reports currentTarget to
#                  each handler as its first arg)
#   +32: consumed — 1 once a handler claims it (stops propagation)
#   +40: phase   — DH_PHASE_CAPTURE / _BUBBLE during propagation (0 otherwise)
#   +48: source  — drag source DhWidget* on DRAG_* events (0 otherwise)
enum DhEventField {
    DH_E_KIND     = 0;
    DH_E_A        = 8;
    DH_E_B        = 16;
    DH_E_TARGET   = 24;
    DH_E_CONSUMED = 32;
    DH_E_PHASE    = 40;
    DH_E_SOURCE   = 48;
}

# Currently-focused widget for keyboard routing. A plain module-global
# SCALAR (NOT a `var X[1]` array — module-global `var X[N]` sizing is
# non-uniform in cyrius, so an 8-byte load64/store64 on a `[1]` can read
# or write out of bounds). A scalar i64 is a reliable 8-byte cell.
var _dh_focus = 0;

# Last known pointer position (set by POINTER_MOVE; button/drag events
# hit-test against this, matching the compositor wire model).
var _dh_ptr_x = 0;
var _dh_ptr_y = 0;

# Widget currently under the pointer (hover), and the widget that received
# the last still-unreleased press (for click / ACTIVATE synthesis).
var _dh_hover = 0;
var _dh_press = 0;

# Press origin (for the drag threshold) and the active drag source
# (0 = no drag in progress).
var _dh_press_x = 0;
var _dh_press_y = 0;
var _dh_drag_src = 0;

# ⭐⭐ THE KEY SHADOWS (0.9.24) — the same four pieces of retained state, held as INTEGERS.
#
# ⛔⛔ THE WHOLE POINT: a pointer cannot survive `arena_reset` and an integer cannot be invalidated
# by it. When a widget carries a stable key (`dh_widget_set_key`), dhancha remembers the KEY here
# alongside the pointer; `dh_frame_begin` drops the pointers and keeps the keys, and
# `dh_rebind_input` re-resolves them against the freshly built tree. An unkeyed widget stores 0 here
# and behaves exactly as it did before — retained by pointer, cleared every frame.
# ⚠ THE POINTER REMAINS THE AUTHORITY WITHIN A FRAME. These are not a second source of truth: every
# read still goes through `_dh_focus` / `_dh_hover` / `_dh_press` / `_dh_drag_src`, and the keys
# exist only to reconstruct them at the frame boundary. A design where both are consulted is one
# where they can disagree.
var _dh_focus_key = 0;
var _dh_hover_key = 0;
var _dh_press_key = 0;
var _dh_drag_key = 0;

# The event-loop run flag. dh_run sets it; dh_quit clears it.
var _dh_running = 0;

# Allocate a DhEvent of `kind` with zeroed payload.
fn dh_event_new(kind): i64 {
    var ev = alloc(56);
    store64(ev + DH_E_KIND, kind);
    store64(ev + DH_E_A, 0);
    store64(ev + DH_E_B, 0);
    store64(ev + DH_E_TARGET, 0);
    store64(ev + DH_E_CONSUMED, 0);
    store64(ev + DH_E_PHASE, 0);
    store64(ev + DH_E_SOURCE, 0);
    return ev;
}

fn dh_event_kind(ev): i64     { return load64(ev + DH_E_KIND); }
fn dh_event_a(ev): i64        { return load64(ev + DH_E_A); }
fn dh_event_b(ev): i64        { return load64(ev + DH_E_B); }
fn dh_event_target(ev): i64   { return load64(ev + DH_E_TARGET); }
fn dh_event_consumed(ev): i64 { return load64(ev + DH_E_CONSUMED); }
fn dh_event_phase(ev): i64    { return load64(ev + DH_E_PHASE); }
fn dh_event_source(ev): i64   { return load64(ev + DH_E_SOURCE); }

# Set the payload fields.
fn dh_event_set_payload(ev, a, b): i64 {
    store64(ev + DH_E_A, a);
    store64(ev + DH_E_B, b);
    return DHANCHA_OK;
}

# Set / get the keyboard focus target.
# ⚠ RECORDS THE WIDGET'S KEY ALONGSIDE THE POINTER (0.9.24), so focus survives a frame-arena rewind
# for a keyed widget. An unkeyed widget stores 0 and behaves exactly as before.
fn dh_focus_set(wgt): i64 {
    _dh_focus = wgt;
    _dh_focus_key = dh_widget_key(wgt);
    return DHANCHA_OK;
}
fn dh_focus_get(): i64    { return _dh_focus; }

# Widget currently under the pointer (0 = none).
fn dh_hover_get(): i64 { return _dh_hover; }

# Clear all transient input state (focus, hover, press). Apps call this
# when swapping the widget tree (a new window / scene) so a stale pointer
# can't route into a torn-down tree.
fn dh_reset_input(): i64 {
    _dh_focus = 0;
    _dh_hover = 0;
    _dh_press = 0;
    _dh_drag_src = 0;
    # ⛔ A FULL RESET DROPS THE KEYS TOO. This is the "swapping the widget tree for a different
    # scene" entry point, and identity does not carry across scenes — a key that survived into an
    # unrelated tree would re-bind to whatever widget happened to reuse the number. `dh_frame_begin`
    # deliberately does NOT call this any more, precisely because a frame is not a new scene.
    _dh_focus_key = 0;
    _dh_hover_key = 0;
    _dh_press_key = 0;
    _dh_drag_key = 0;
    return DHANCHA_OK;
}

# Drop the retained POINTERS but keep the keys, so `dh_rebind_input` can restore them after the app
# rebuilds its tree. Internal to the frame boundary — see `dh_frame_begin`.
fn dh_drop_input_ptrs(): i64 {
    _dh_focus = 0;
    _dh_hover = 0;
    _dh_press = 0;
    _dh_drag_src = 0;
    return DHANCHA_OK;
}

# @public — re-resolve the retained widget pointers from their keys against a freshly built tree.
#
# ⭐ CALLED FOR YOU BY `dh_surface_set_root`, which is the one point in a frame where the new tree
# exists and the old pointers are known to be dead. An app that renders through a DhSurface — every
# app — never calls this directly. It is public for the app that builds a tree without a surface.
#
# ⛔ A KEY THAT NO LONGER RESOLVES IS DROPPED, AND SO IS ITS POINTER. The widget genuinely left the
# tree: the row was deleted, the pane closed, the menu dismissed. Keeping the key would mean a
# widget reappearing under that key three frames later silently inherits focus — or worse, a drag
# the operator abandoned. **Absence is an answer**, and the answer is "there is no longer a focused
# widget", which is a state the whole event path already handles.
# ⚠ UNKEYED STATE IS LEFT ALONE. If `_dh_focus` was set on a widget with no key, its shadow is 0,
# this function skips it, and the pointer stands or falls on whether the app arena'd it — which is
# exactly the pre-0.9.24 contract.
fn dh_rebind_input(root): i64 {
    if (root == 0) { return DHANCHA_OK; }
    if (_dh_focus_key != 0) {
        _dh_focus = dh_widget_find_key(root, _dh_focus_key);
        if (_dh_focus == 0) { _dh_focus_key = 0; }
    }
    if (_dh_hover_key != 0) {
        _dh_hover = dh_widget_find_key(root, _dh_hover_key);
        if (_dh_hover == 0) { _dh_hover_key = 0; }
    }
    if (_dh_press_key != 0) {
        _dh_press = dh_widget_find_key(root, _dh_press_key);
        if (_dh_press == 0) { _dh_press_key = 0; }
    }
    if (_dh_drag_key != 0) {
        _dh_drag_src = dh_widget_find_key(root, _dh_drag_key);
        # ⛔ A DRAG WHOSE SOURCE LEFT THE TREE IS OVER, AND THE APP MUST BE TOLD. Silently forgetting
        # it is the 0.9.21 failure in a new place: the app set a "dragging" flag on DRAG_START and
        # would never see DRAG_END. Emitting it here is not possible — there is no widget to emit
        # to — so the state is cleared and `dh_drag_active` answers 0, which is what an app polls.
        if (_dh_drag_src == 0) { _dh_drag_key = 0; }
    }
    return DHANCHA_OK;
}

# @public — is a drag in progress? 1 = yes. Cheap enough to poll every frame, and the honest answer
# after a drag source is destroyed mid-drag (see `dh_rebind_input`).
fn dh_drag_active(): i64 {
    if (_dh_drag_src == 0) { return 0; }
    return 1;
}

# @public — start a new frame: reset the frame arena AND drop the widget pointers dhancha retains.
# No-op when no frame arena is set, so an app that has not opted in is unaffected.
#
# ⛔⛔ THE TWO HALVES CANNOT BE DONE SEPARATELY, WHICH IS WHY THIS ENTRY POINT EXISTS AND WHY
# `arena_reset` MUST NOT BE CALLED ON A FRAME ARENA DIRECTLY. `_dh_focus`, `_dh_hover`, `_dh_press`
# and `_dh_drag_src` are raw widget pointers held across calls. After a reset they address memory the
# arena is about to hand out again — so `dh_focus_within` would walk recycled parent links and answer
# a question about a widget that no longer exists, with no fault to say so. Resetting the arena
# without clearing them converts a memory saving into silent misbehaviour.
# ⚠ IT FOLLOWS THAT AN APP USING A FRAME ARENA MUST RE-ESTABLISH FOCUS EVERY FRAME. crab does
# (`crab_pane` calls `dh_focus_set` on the active pane while building the tree). An app that sets
# focus once at startup and expects it to persist must NOT arena its widgets — cross-frame widget
# identity and a per-frame arena are mutually exclusive by construction, not by policy.
# ⛔⛔ AND DRAG IS ON THE LOSING SIDE OF THAT SAME LINE, WHICH WAS NOT SPELLED OUT UNTIL 0.9.21.
# A drag spans press → move → release, so `_dh_drag_src` is cross-frame widget identity by
# definition. It cannot survive this function, and until 0.9.21 the only symptom was that
# `DRAG_START` fired and nothing else ever did. `dh_drag_available()` now answers the question, and
# `dh_drag_progress` refuses to start a drag it cannot finish. See that function.
fn dh_frame_begin(): i64 {
    var a = dh_frame_arena_get();
    if (a == 0) { return DHANCHA_OK; }
    arena_reset(a);
    # ⭐⭐ 0.9.24: DROPS THE POINTERS, KEEPS THE KEYS. This used to call `dh_reset_input`, which
    # cleared both — and that is what made focus, press and drag unreachable for every immediate-mode
    # app. The pointers must still go (after the reset they address memory about to be handed out
    # again); the keys are integers and nothing has happened to them.
    # ⇒ `dh_surface_set_root` re-binds them against the new tree. A widget the app did not key still
    # loses its retained state here, exactly as before.
    dh_drop_input_ptrs();
    return DHANCHA_OK;
}

# Current pointer position (last POINTER_MOVE).
fn dh_pointer_x(): i64 { return _dh_ptr_x; }
fn dh_pointer_y(): i64 { return _dh_ptr_y; }

# Hit-test: which widget contains point (px, py)? Depth-first, last match wins. Returns a DhWidget* or 0.
#
# ⭐ SIBLING ORDER IS ALREADY Z-ORDER, and that half was right: children are walked first-to-last and a
# later match overwrites an earlier one, which matches the paint order `dh_surface_render` uses. The
# last-painted widget is the one you see, so it must be the one you hit.
#
# ⛔⛔ CLIPPING WAS NOT ENFORCED, AND THAT IS AN INPUT-CORRECTNESS BUG, not a cosmetic gap.
# The walk recursed into children EVEN WHEN THE POINT WAS OUTSIDE THE PARENT, so a child laid out
# beyond its parent's bounds — anything scrolled, overflowing, or sized past its container — received
# clicks at coordinates where **it is not drawn**. `dh_surface_render` clips a child to what fits;
# input did not, so the two disagreed about where a widget was. Invisible pixels answering the mouse is
# the worst shape of this: it looks like a dead click on the widget you CAN see.
# ⇒ A point outside a subtree's root is outside every one of its descendants. Return immediately and
# the whole subtree is skipped — which is both the correctness fix and a free pruning of the walk.
# ⚠ THIS ASSUMES CHILDREN ARE CLIPPED TO PARENTS, which is what a box/flex toolkit means by containment
# and what this repo's own deferral note asked for. A future overlay/popup layer that must escape its parent
# needs its own root, NOT a relaxation here — relaxing it brings the disagreement straight back.
fn dh_hit_test(root, px, py): i64 {
    if (root == 0) { return 0; }
    # ⚠ ONE definition of "inside", shared with the painter's clip and `dh_list_index_at`. When this
    # was open-coded here it was the only copy; it is not any more, and three subtly different
    # half-open conventions is how a 1px seam ends up dead in one of them.
    if (dh_widget_contains(root, px, py) == 0) { return 0; }
    var hit = root;
    # recurse; a deeper hit overrides, and a LATER sibling overrides an earlier one (paint order)
    var child = dh_widget_first_child(root);
    while (child != 0) {
        var ch = dh_hit_test(child, px, py);
        if (ch != 0) { hit = ch; }
        child = dh_widget_next_sibling(child);
    }
    return hit;
}

# Bubble `ev` up the parent chain starting at `target`: invoke each
# node's handler (if any); the first handler that returns 1 CONSUMES the
# event and stops propagation (sets DH_E_CONSUMED). Handlers receive
# (currentTarget, ev); the original hit/focus node is ev's DH_E_TARGET.
# A null handler ptr is skipped (fncall on 0 would crash).
fn dh_bubble(target, ev): i64 {
    var node = target;
    while (node != 0) {
        var fp = dh_widget_handler(node);
        if (fp != 0) {
            var consumed = fncall2(fp, node, ev);
            if (consumed == 1) {
                store64(ev + DH_E_CONSUMED, 1);
                return DHANCHA_OK;
            }
        }
        node = dh_widget_parent(node);
    }
    return DHANCHA_OK;
}

# Full two-phase propagation, the router dispatch uses: a CAPTURE pass
# (root -> target, invoking each node's capture handler) then a BUBBLE pass
# (target -> root, invoking each node's bubble handler). The first handler
# in EITHER pass to return 1 CONSUMES the event (sets DH_E_CONSUMED) and
# stops all further propagation — a capture handler can thus intercept an
# event before the target's bubble handler ever sees it. Handlers get
# (currentTarget, ev); dh_event_phase says which pass. Null slots skipped.
fn dh_propagate(target, ev): i64 {
    if (target == 0) { return DHANCHA_OK; }
    # collect the chain target..root into buf (buf[0]=target .. buf[n-1]=root)
    var cap = 256;
    var buf = alloc(cap * 8);
    var n = 0;
    var node = target;
    while (node != 0) {
        if (n < cap) {
            store64(buf + n * 8, node);
            n = n + 1;
        }
        node = dh_widget_parent(node);
    }
    # capture pass: root -> target (indices n-1 .. 0)
    store64(ev + DH_E_PHASE, DH_PHASE_CAPTURE);
    var i = n - 1;
    while (i >= 0) {
        var wc = load64(buf + i * 8);
        var fc = dh_widget_capture_handler(wc);
        if (fc != 0) {
            if (fncall2(fc, wc, ev) == 1) {
                store64(ev + DH_E_CONSUMED, 1);
                return DHANCHA_OK;
            }
        }
        i = i - 1;
    }
    # bubble pass: target -> root (indices 0 .. n-1)
    store64(ev + DH_E_PHASE, DH_PHASE_BUBBLE);
    var j = 0;
    while (j < n) {
        var wb = load64(buf + j * 8);
        var fb = dh_widget_handler(wb);
        if (fb != 0) {
            if (fncall2(fb, wb, ev) == 1) {
                store64(ev + DH_E_CONSUMED, 1);
                return DHANCHA_OK;
            }
        }
        j = j + 1;
    }
    return DHANCHA_OK;
}

# ---- higher-level synthesis helpers --------------------------------

# Emit a fresh synthetic event of `kind` targeted at `target` and bubble
# it. Used for POINTER_ENTER / POINTER_LEAVE / ACTIVATE, which the toolkit
# DERIVES from raw motion/button/key events rather than receiving off the
# wire. No-op on a null target.
fn dh_emit(target, kind): i64 {
    if (target == 0) { return DHANCHA_OK; }
    var ev = dh_event_new(kind);
    store64(ev + DH_E_TARGET, target);
    dh_propagate(target, ev);
    return DHANCHA_OK;
}

# Update the hovered widget; on a boundary crossing emit POINTER_LEAVE to
# the widget left and POINTER_ENTER to the widget entered.
fn dh_update_hover(target): i64 {
    if (target == _dh_hover) { return DHANCHA_OK; }
    if (_dh_hover != 0) { dh_emit(_dh_hover, POINTER_LEAVE); }
    _dh_hover = target;
    _dh_hover_key = dh_widget_key(target);
    if (target != 0) { dh_emit(target, POINTER_ENTER); }
    return DHANCHA_OK;
}

# Pre-order (DFS) collect of focusable widgets into `buf` (up to `cap`
# slots). Returns the running count, threaded through the return value so
# no address-of-a-local is needed.
fn dh_collect_focusable(node, buf, count, cap): i64 {
    if (node == 0) { return count; }
    var c = count;
    if (dh_widget_focusable(node) == 1) {
        if (c < cap) {
            store64(buf + c * 8, node);
            c = c + 1;
        }
    }
    var child = dh_widget_first_child(node);
    while (child != 0) {
        c = dh_collect_focusable(child, buf, c, cap);
        child = dh_widget_next_sibling(child);
    }
    return c;
}

# Move keyboard focus to the next (backward==0) or previous (backward!=0)
# focusable widget in pre-order, wrapping. With no current focus, forward
# picks the first and backward the last. Caps at 256 focusables (a UI with
# more is beyond this toolkit's current scope).
fn dh_focus_advance(root, backward): i64 {
    var cap = 256;
    var buf = alloc(cap * 8);
    var count = dh_collect_focusable(root, buf, 0, cap);
    if (count == 0) { return DHANCHA_OK; }
    var cur = dh_focus_get();
    var idx = 0 - 1;
    var i = 0;
    while (i < count) {
        if (load64(buf + i * 8) == cur) { idx = i; }
        i = i + 1;
    }
    var next = 0;
    if (idx == (0 - 1)) {
        if (backward == 0) { next = load64(buf); }
        if (backward != 0) { next = load64(buf + (count - 1) * 8); }
    }
    if (idx != (0 - 1)) {
        var ni = idx + 1;
        if (backward != 0) { ni = idx - 1; }
        if (ni >= count) { ni = 0; }
        if (ni < 0) { ni = count - 1; }
        next = load64(buf + ni * 8);
    }
    dh_focus_set(next);
    return DHANCHA_OK;
}

# True if `k` is an activation key (Enter / Return / Space).
fn dh_key_is_activate(k): i64 {
    if (k == DH_KEY_ENTER)  { return 1; }
    if (k == DH_KEY_RETURN) { return 1; }
    if (k == DH_KEY_SPACE)  { return 1; }
    return 0;
}

# ---- drag-drop state machine ---------------------------------------

# |x| — for the Manhattan drag-threshold test.
fn dh_abs(x): i64 {
    if (x < 0) { return 0 - x; }
    return x;
}

# Emit a synthetic drag event (DRAG_START / _MOVE / _DROP / _END): `target`
# receives it, with the drag `source` in DH_E_SOURCE and the current pointer
# in (a, b). Propagates like any other event.
fn dh_emit_drag(target, kind, source): i64 {
    if (target == 0) { return DHANCHA_OK; }
    var ev = dh_event_new(kind);
    store64(ev + DH_E_TARGET, target);
    store64(ev + DH_E_SOURCE, source);
    store64(ev + DH_E_A, _dh_ptr_x);
    store64(ev + DH_E_B, _dh_ptr_y);
    dh_propagate(target, ev);
    return DHANCHA_OK;
}

# @public — can a drag be carried out in this configuration? 1 = yes, 0 = no.
#
# ⛔⛔ DRAG AND THE FRAME ARENA ARE MUTUALLY EXCLUSIVE, AND THIS FUNCTION IS THAT FACT MADE CALLABLE.
# A drag is inherently multi-frame — press, one or more moves, release — and its source is held as a
# raw widget pointer in `_dh_drag_src`. `dh_frame_begin` clears that pointer on every frame (it must:
# after `arena_reset` it addresses memory about to be handed out again). So with a frame arena
# installed, a drag begun on one frame has no source by the next pointer event.
#
# ⛔ THE OLD BEHAVIOUR WAS THE WORST OF BOTH: `DRAG_START` fired and `DRAG_MOVE` / `DRAG_DROP` /
# `DRAG_END` never did. An app could set a "dragging" flag on START and never be told the drag
# ended — a capability that half-works, which is harder to diagnose than one that is absent, because
# the first event arrives exactly as documented. Reported by crab 0.7.1, the first client to want
# both APIs; crab is also why the arena exists.
#
# ⇒ A press on a draggable widget under a frame arena is now simply a **click** — no DRAG_START, and
# `ACTIVATE` still synthesizes on release, which is the behaviour a widget had before it was marked
# draggable. Nothing half-fires.
# ⚠ THIS IS A CAPABILITY QUESTION, NOT A POLICY ONE. The 0.9.15 note on `dh_frame_begin` already
# said cross-frame widget identity and a per-frame arena are exclusive *by construction*; drag is
# cross-frame widget identity, so it was always on the wrong side of that line. This makes the
# consequence observable instead of leaving it to be discovered at the drop that never came.
fn dh_drag_available(): i64 {
    if (dh_frame_arena_get() != 0) { return 0; }
    return 1;
}

# @public — can a drag be carried out **from this widget**? 1 = yes.
#
# ⭐⭐ 0.9.24 — THIS IS THE ANSWER THAT WAS MISSING WHEN `dh_drag_available()` WAS WRITTEN.
# That function answers a question about the *configuration*, and under a frame arena the answer was
# an unconditional no. But the arena was never the real obstacle — **identity** was. A widget with a
# stable key keeps its identity across the rewind, so a drag begun on one frame still has a source on
# the next, and every one of DRAG_START / MOVE / DROP / END can be delivered.
# ⇒ Drag is available when there is no arena (as before), **or** when the source carries a key.
# ⚠ `dh_drag_available()` is kept and unchanged, because its answer is still correct for the question
# it asks — "can an UNKEYED widget be dragged here". A caller wanting the useful answer asks this one.
# ⛔ CHECKED AT THE SOURCE, NOT AT EACH EMIT, for the reason 0.9.21 recorded: a drag that never
# starts needs no special case downstream, and half-firing is worse than not firing.
fn dh_drag_available_for(w): i64 {
    if (dh_frame_arena_get() == 0) { return 1; }
    if (w == 0) { return 0; }
    if (dh_widget_key(w) != 0) { return 1; }
    return 0;
}

# Advance the drag state after a POINTER_MOVE. If a draggable widget is
# pressed and the pointer has travelled past the threshold, start the drag
# (DRAG_START to the source); once dragging, every move emits DRAG_MOVE.
fn dh_drag_progress(): i64 {
    if (_dh_press == 0) { return DHANCHA_OK; }
    # ⛔ REFUSE TO BEGIN A DRAG THAT CANNOT BE FINISHED. See `dh_drag_available`. Checked HERE, at the
    # one place a drag can start, rather than at each emit — a drag that never starts needs no
    # special case anywhere downstream, and the press falls through to ordinary click handling.
    if (dh_drag_available_for(_dh_press) == 0) { return DHANCHA_OK; }
    if (_dh_drag_src == 0) {
        if (dh_widget_is_draggable(_dh_press) == 1) {
            var dx = _dh_ptr_x - _dh_press_x;
            var dy = _dh_ptr_y - _dh_press_y;
            if (dh_abs(dx) + dh_abs(dy) >= DH_DRAG_THRESHOLD) {
                _dh_drag_src = _dh_press;
                _dh_drag_key = dh_widget_key(_dh_press);
                dh_emit_drag(_dh_drag_src, DRAG_START, _dh_drag_src);
            }
        }
    } else {
        dh_emit_drag(_dh_drag_src, DRAG_MOVE, _dh_drag_src);
    }
    return DHANCHA_OK;
}

# Handle a pointer release. If a drag is in progress: drop onto the widget
# under the pointer when it is a drop target (DRAG_DROP), then always fire
# DRAG_END to the source. Otherwise it's a click — a release on the pressed
# widget synthesizes ACTIVATE. Clears press / drag state either way.
fn dh_pointer_release(target): i64 {
    if (_dh_drag_src != 0) {
        if (target != 0) {
            if (dh_widget_is_drop_target(target) == 1) {
                dh_emit_drag(target, DRAG_DROP, _dh_drag_src);
            }
        }
        dh_emit_drag(_dh_drag_src, DRAG_END, _dh_drag_src);
        _dh_drag_src = 0;
        _dh_drag_key = 0;
    } else {
        if (target != 0) {
            if (target == _dh_press) { dh_emit(target, ACTIVATE); }
        }
    }
    _dh_press = 0;
    _dh_press_key = 0;
    return DHANCHA_OK;
}

# Dispatch an event into the tree.
#   KEY   -> the focused widget; Tab / Shift-Tab (a==DH_KEY_TAB, b!=0 =>
#            backward) instead moves focus and is toolkit-consumed;
#            Enter/Return/Space on a focused BUTTON also synthesizes ACTIVATE.
#   FOCUS -> the focused widget.
#   POINTER_MOVE -> updates the tracked pointer position, hit-tests there,
#            and emits POINTER_ENTER/LEAVE on hover boundary crossings.
#   POINTER_BTN  -> hit-tests at the tracked position; a press records the
#            press target + origin + click-to-focus; a release either DROPS
#            an in-progress drag or (if none) synthesizes ACTIVATE on the
#            pressed widget (a click).
#   DRAG  -> hit-tests at the tracked position.
# The resolved target is stamped into ev, then the raw event PROPAGATES
# (capture root->target, then bubble target->root). Higher-level events
# (ENTER/LEAVE, ACTIVATE, DRAG_START/MOVE/DROP/END) are synthesized around
# it. Returns DHANCHA_OK.
fn dh_dispatch(root, ev): i64 {
    if (root == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (ev == 0)   { return DHANCHA_ERR_OTHER; }
    var kind = dh_event_kind(ev);

    # Tab traversal is a toolkit-level action: retarget focus, do not route
    # to the (old) focused widget, and consume the key.
    if (kind == KEY) {
        if (dh_event_a(ev) == DH_KEY_TAB) {
            dh_focus_advance(root, dh_event_b(ev));
            store64(ev + DH_E_TARGET, dh_focus_get());
            store64(ev + DH_E_CONSUMED, 1);
            return DHANCHA_OK;
        }
    }

    var target = 0;
    if (kind == KEY)   { target = dh_focus_get(); }
    if (kind == FOCUS) { target = dh_focus_get(); }
    if (kind == POINTER_MOVE) {
        _dh_ptr_x = dh_event_a(ev);
        _dh_ptr_y = dh_event_b(ev);
        target = dh_hit_test(root, _dh_ptr_x, _dh_ptr_y);
        dh_update_hover(target);
    }
    if (kind == POINTER_BTN) {
        target = dh_hit_test(root, _dh_ptr_x, _dh_ptr_y);
        if (dh_event_b(ev) == 1) {
            _dh_press = target;
            _dh_press_key = dh_widget_key(target);
            _dh_press_x = _dh_ptr_x;
            _dh_press_y = _dh_ptr_y;
            _dh_drag_src = 0;
            _dh_drag_key = 0;
            if (target != 0) {
                if (dh_widget_focusable(target) == 1) { dh_focus_set(target); }
            }
        }
    }
    if (kind == DRAG) { target = dh_hit_test(root, _dh_ptr_x, _dh_ptr_y); }

    store64(ev + DH_E_TARGET, target);
    dh_propagate(target, ev);

    # higher-level synthesis, AFTER the raw event has been delivered
    if (kind == POINTER_MOVE) { dh_drag_progress(); }
    if (kind == POINTER_BTN) {
        if (dh_event_b(ev) == 0) { dh_pointer_release(target); }
    }
    if (kind == KEY) {
        if (target != 0) {
            if (dh_widget_kind(target) == BUTTON) {
                if (dh_key_is_activate(dh_event_a(ev)) == 1) { dh_emit(target, ACTIVATE); }
            }
            # ⭐ TEXT EDITING (0.9.7) — the step that makes a TEXTINPUT actually take input rather
            # than merely accept focus. Placed HERE, after `dh_propagate`, on purpose:
            # ⛔ AN APP HANDLER THAT ALREADY CLAIMED THE KEY MUST WIN. A window binding Ctrl+S would
            # otherwise get its shortcut AND an "s" typed into whatever field had focus — the app
            # sees a working shortcut, the operator sees the text box growing junk, and neither
            # side has any indication the two are related.
            if (dh_event_consumed(ev) == 0) {
                if (dh_text_editable(target) == 1) {
                    if (dh_text_key(target, dh_event_a(ev)) == 1) {
                        store64(ev + DH_E_CONSUMED, 1);
                    }
                }
            }
        }
    }
    return DHANCHA_OK;
}

# ---- event queue (the dh_run pump source) --------------------------
#
# A DhQueue is a fixed-capacity ring of DhEvent pointers. The future
# compositor-fd translator pushes wire events here; dh_run pops +
# dispatches. A ring (not a growable vec) so an input flood DROPS the
# overflow rather than growing without bound (puka's kq-ring discipline).
#
# DhQueue struct layout (32 bytes):
#   +0:  head   — index of the next event to pop
#   +8:  count  — number of queued events
#   +16: cap    — ring capacity (slots)
#   +24: buf    — cap i64 slots of DhEvent*
enum DhQueueField {
    DH_Q_HEAD  = 0;
    DH_Q_COUNT = 8;
    DH_Q_CAP   = 16;
    DH_Q_BUF   = 24;
}

# Allocate a ring of `cap` DhEvent-pointer slots. Returns a DhQueue* (or
# 0 for cap <= 0 / on OOM).
fn dh_queue_new(cap): i64 {
    if (cap <= 0) { return 0; }
    var q = alloc(32);
    var buf = alloc(cap * 8);
    store64(q + DH_Q_HEAD, 0);
    store64(q + DH_Q_COUNT, 0);
    store64(q + DH_Q_CAP, cap);
    store64(q + DH_Q_BUF, buf);
    return q;
}

fn dh_queue_count(q): i64 { return load64(q + DH_Q_COUNT); }
fn dh_queue_empty(q): i64 {
    if (load64(q + DH_Q_COUNT) == 0) { return 1; }
    return 0;
}

# Push `ev` onto the tail. Returns DHANCHA_OK; DHANCHA_ERR_OTHER if `ev`
# is null or the ring is full (in both cases nothing is enqueued). A null
# event is rejected here so dh_run's drain can treat a null pop strictly
# as "ring empty" (a null slot mid-ring would otherwise truncate the drain).
fn dh_queue_push(q, ev): i64 {
    if (q == 0)  { return DHANCHA_ERR_OTHER; }
    if (ev == 0) { return DHANCHA_ERR_OTHER; }
    var count = load64(q + DH_Q_COUNT);
    var cap = load64(q + DH_Q_CAP);
    if (count >= cap) { return DHANCHA_ERR_OTHER; }
    var head = load64(q + DH_Q_HEAD);
    var buf = load64(q + DH_Q_BUF);
    var idx = (head + count) % cap;
    store64(buf + idx * 8, ev);
    store64(q + DH_Q_COUNT, count + 1);
    return DHANCHA_OK;
}

# Pop from the head. Returns a DhEvent*, or 0 if the ring is empty.
fn dh_queue_pop(q): i64 {
    if (q == 0) { return 0; }
    var count = load64(q + DH_Q_COUNT);
    if (count == 0) { return 0; }
    var head = load64(q + DH_Q_HEAD);
    var cap = load64(q + DH_Q_CAP);
    var buf = load64(q + DH_Q_BUF);
    var ev = load64(buf + head * 8);
    store64(q + DH_Q_HEAD, (head + 1) % cap);
    store64(q + DH_Q_COUNT, count - 1);
    return ev;
}

# ---- event loop ----------------------------------------------------

# Stop the running dh_run loop (a handler calls this to quit the app).
fn dh_quit(): i64 { _dh_running = 0; return DHANCHA_OK; }

# The client event loop. Pops events off `q` and dispatches each into
# `root` until the queue drains or a handler calls dh_quit. Returns the
# count of events processed (>= 0), or -1 if `root` / `q` is null (a
# negative return means "did not run" — it can never be a real count).
#
# Termination is on queue-EMPTY, not on a null pop: dh_queue_push rejects
# null events, so the ring never holds a 0 slot, but keying off emptiness
# is the self-evidently-correct condition regardless.
#
# The compositor-connected loop (block on the native protocol fd, decode wire
# events into DhEvents, run layout + present when dirty) replaces the
# empty-check branch with an fd wait; the dispatch core is the same.
fn dh_run(root, q): i64 {
    if (root == 0) { return 0 - 1; }
    if (q == 0)    { return 0 - 1; }
    _dh_running = 1;
    var n = 0;
    while (_dh_running == 1) {
        if (dh_queue_empty(q) == 1) {
            _dh_running = 0;
        } else {
            var ev = dh_queue_pop(q);
            if (ev != 0) {
                dh_dispatch(root, ev);
                n = n + 1;
            }
        }
    }
    return n;
}

# --- canvas.cyr ---

# @public — dhancha CANVAS: a widget-tree slot the APP draws into itself.
# canvas.cyr — the escape hatch, and the reason it is a small one.
#
# ⭐⭐ WHY A TOOLKIT NEEDS THIS. Not every surface decomposes into widgets. puka's terminal grid is
# 80×24 cells with per-cell foreground, background, attributes, wide-glyph spacers and a cursor,
# repainted by a DIRTY-ROW scanner that touches only the lines that changed. Expressing that as ~1920
# widgets would cost more memory than the terminal's entire scrollback and would throw away the damage
# tracking that makes a keystroke echo repaint sixteen scanlines instead of the screen. The answer
# every real toolkit reaches is the same one: give the app a rectangle and let it paint.
#
# ⛔ AND IT IS DELIBERATELY NARROW. A CANVAS gets its BOX and the CLIP, and nothing else — no access
# to siblings, no way to widen the clip it was handed, no say in layout beyond the pref size every
# widget already has. An escape hatch that can reach outside its rectangle is not a hatch, it is a
# hole: the whole value of putting app-drawn content in the tree is that layout, clipping and
# hit-testing keep applying to it.
#
# ⚠ THE CALLBACK RECEIVES THE CLIP AND MUST HONOUR IT. `dh_draw_widget` cannot clip pixels it did not
# write, so a canvas that ignores its clip box paints over its neighbours and there is nothing the
# toolkit can do about it. Use `dh_canvas_clip_rect` below rather than intersecting by hand.

# @public — an SdSurface header pointing at pixels the CALLER owns (BGRA/XRGB8888, `stride_px`
# pixels per row). Nothing is copied and nothing is freed; the caller's buffer IS the surface.
#
# ⭐⭐ WHY THIS EXISTS, AND WHY IT IS THE DIFFERENCE BETWEEN A PORT AND A REGRESSION. An app with its
# own present buffer — puka hands one back from `win_present_begin` — would otherwise have to render
# the widget tree into a dhancha-allocated surface and then copy the whole thing into that buffer,
# every frame. For an 80×24 terminal at 8×16 cells that is a second full-frame copy on every
# keystroke, so adopting the toolkit would have made the app measurably slower. Wrapping instead
# means the widget tree draws straight into the buffer the compositor is going to read.
#
# ⚠ IT USES sadish's OWN `SD_SURFACE_*` OFFSETS, not hardcoded numbers. The layout is sadish's to
# change; borrowing its published constants means a change there is a rebuild here, not a silent
# mis-write into a caller's framebuffer.
# ⛔ THE CALLER OWNS THE MEMORY AND ITS LIFETIME. A wrapped surface must not outlive the buffer —
# `win_present_begin` hands back a pointer valid until commit, so wrap it per frame rather than
# caching one across frames.
fn dh_surface_wrap(pixels, w, h, stride_px): i64 {
    if (pixels == 0) { return 0; }
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    var s = alloc(SD_SURFACE_SIZE);
    if (s == 0) { return 0; }
    store64(s + SD_SURFACE_WIDTH_OFFSET, w);
    store64(s + SD_SURFACE_HEIGHT_OFFSET, h);
    store64(s + SD_SURFACE_PIXELS_OFFSET, pixels);
    store64(s + SD_SURFACE_STRIDE_OFFSET, stride_px * 4);
    return s;
}

# @public — a CANVAS whose `draw(wgt, sds, clx, cly, clw, clh)` paints its contents.
# `userdata` is handed back through `dh_widget_userdata(wgt)`; the callback gets the widget, so it
# needs no globals of its own.
fn dh_canvas_new(draw_fn, userdata): i64 {
    var w = dh_widget_new(DhWidgetKind.CANVAS);
    store64(w + DH_W_DRAW, draw_fn);
    store64(w + DH_W_USERDATA, userdata);
    return w;
}

fn dh_canvas_draw_fn(w): i64 { if (w == 0) { return 0; } return load64(w + DH_W_DRAW); }

# @public — replace the draw callback (0 disables painting; the widget still lays out and hit-tests).
fn dh_canvas_set_draw(w, draw_fn): i64 {
    if (w == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(w + DH_W_DRAW, draw_fn);
    return DHANCHA_OK;
}

# @public — intersect the widget's box with the clip it was handed, writing x/y/w/h into `out`
# (four i64 slots). -> 1 if anything is visible, 0 if the canvas is entirely clipped away.
#
# ⚠ THE CALLBACK'S FIRST CALL SHOULD BE THIS. Painting relative to the widget's own x/y while
# ignoring the clip is the natural mistake — it looks right until the canvas is inside a scrolled
# list or a window smaller than its content, at which point it paints over whatever is beside it.
# Returning 0 for "nothing visible" also lets an expensive renderer skip its work entirely.
fn dh_canvas_clip_rect(wgt, clx, cly, clw, clh, out): i64 {
    if (wgt == 0) { return 0; }
    var x0 = dh_widget_x(wgt);
    var y0 = dh_widget_y(wgt);
    var x1 = x0 + dh_widget_w(wgt);
    var y1 = y0 + dh_widget_h(wgt);
    if (x0 < clx) { x0 = clx; }
    if (y0 < cly) { y0 = cly; }
    if (x1 > clx + clw) { x1 = clx + clw; }
    if (y1 > cly + clh) { y1 = cly + clh; }
    if (x1 <= x0) { return 0; }
    if (y1 <= y0) { return 0; }
    store64(out, x0);
    store64(out + 8, y0);
    store64(out + 16, x1 - x0);
    store64(out + 24, y1 - y0);
    return 1;
}

# @public — blit a packed RGB24 source (`sw` × `sh`, rows contiguous) into `sds` at the canvas's
# origin, clipped. -> rows written.
#
# ⛔⛔ THE ALPHA BYTE IS SET TO 255 AND THAT IS LOAD-BEARING, NOT TIDINESS. An RGB24 source has no
# alpha, so the obvious pack — `(r << 16) | (g << 8) | b` — leaves byte 3 at ZERO. Harmless while
# nothing reads it; under agnos's `gpu_shader_op #92` op 0x01, which is premultiplied src-over
# (`out = src + dst * (1 - src_a)`), an alpha of 0 makes the term collapse to `out = src + dst`.
# The content does not vanish — it renders as an ADDITIVE OVER-BRIGHT GHOST of itself composited
# onto whatever is behind it, which is far harder to notice and to diagnose than a black rectangle.
# ⚠ This stack has now paid that bill twice (kashi glyph text, and the coverage-blend colour), which
# is why the conversion lives HERE rather than in each app that owns an RGB buffer.
fn dh_canvas_blit_rgb24(wgt, sds, src, sw, sh, clx, cly, clw, clh): i64 {
    var r4 = alloc(32);
    if (dh_canvas_clip_rect(wgt, clx, cly, clw, clh, r4) == 0) { return 0; }
    var dx = load64(r4);
    var dy = load64(r4 + 8);
    var dw = load64(r4 + 16);
    var dh2 = load64(r4 + 24);
    var wx = dh_widget_x(wgt);
    var wy = dh_widget_y(wgt);
    var dst = sd_surface_pixels(sds);
    # ⚠ THE REAL STRIDE, not the width. They are equal for `sd_surface_new`, and they are NOT for a
    # `dh_surface_wrap` over a present buffer whose rows are padded — where using the width would
    # skew every row progressively and shear the image.
    var stride = sd_surface_stride(sds) / 4;
    var rows = 0;
    var y = 0;
    while (y < dh2) {
        var syy = (dy + y) - wy;                 # source row, relative to the widget's own origin
        if (syy >= 0) {
            if (syy < sh) {
                var x = 0;
                while (x < dw) {
                    var sxx = (dx + x) - wx;
                    if (sxx >= 0) {
                        if (sxx < sw) {
                            var sp = (syy * sw + sxx) * 3;
                            var px = (load8(src + sp) << 16) | (load8(src + sp + 1) << 8) | load8(src + sp + 2);
                            store32(dst + ((dy + y) * stride + (dx + x)) * 4, px | 0xFF000000);
                        }
                    }
                    x = x + 1;
                }
                rows = rows + 1;
            }
        }
        y = y + 1;
    }
    return rows;
}

# --- textinput.cyr ---

# @public — dhancha TEXTINPUT: an editable single-line text field.
# textinput.cyr — the buffer, the caret, and the key semantics behind DhWidgetKind.TEXTINPUT.
#
# ⭐ BEFORE 0.9.7 `TEXTINPUT` WAS A KIND AND A FOCUSABILITY RULE AND NOTHING ELSE. It could be
# built, focused, Tab-cycled to, drawn — and it could not be typed into, because there was no
# buffer for a character to go into. A focusable field that accepts no input is the painted-but-
# inert failure in its purest form: every affordance present, the function absent.
#
# ⛔ THE BUFFER IS `DH_W_TEXT` — the same field a LABEL draws from. That is deliberate and it is
# most of the reason this file is short: the painter already knows how to render that pointer, so
# an edited field shows its new contents with zero new drawing code, and there is exactly one
# answer to "what does this widget say" rather than a display string and an edit string that drift.
#
# ⚠ UTF-8 THROUGHOUT, and the caret is a BYTE offset. Movement and deletion step over whole
# sequences (see `dh_text__prev` / `dh_text__next`), so a caret can never land inside a character
# and a backspace can never leave a half-encoded byte behind. A codepoint-index caret would have
# been simpler to reason about and would have made every draw and edit an O(n) rescan.

# UTF-8 continuation bytes are 0b10xxxxxx. A byte is a character START if it is anything else.
fn dh_text__is_cont(b): i64 {
    if ((b & 0xC0) == 0x80) { return 1; }
    return 0;
}

# Byte offset of the character START before `at`. -> `at` unchanged when already at 0.
fn dh_text__prev(buf, at): i64 {
    var i = at;
    if (i <= 0) { return 0; }
    i = i - 1;
    while (i > 0) {
        if (dh_text__is_cont(load8(buf + i)) == 0) { return i; }
        i = i - 1;
    }
    return 0;
}

# Byte offset of the character START after `at`. -> `len` when already at the end.
fn dh_text__next(buf, at, len): i64 {
    var i = at;
    if (i >= len) { return len; }
    i = i + 1;
    while (i < len) {
        if (dh_text__is_cont(load8(buf + i)) == 0) { return i; }
        i = i + 1;
    }
    return len;
}

# How many bytes `cp` needs in UTF-8. -> 0 for a value that is not a legal scalar.
# ⛔ SURROGATES (D800..DFFF) ARE REFUSED. They are not scalar values; encoding one produces CESU-8,
# which every decoder downstream is entitled to reject — and the place it would surface is a
# rendering glitch three components away, not here.
fn dh_text_utf8_len(cp): i64 {
    if (cp < 0) { return 0; }
    if (cp < 0x80) { return 1; }
    if (cp < 0x800) { return 2; }
    if (cp >= 0xD800) { if (cp <= 0xDFFF) { return 0; } }
    if (cp < 0x10000) { return 3; }
    if (cp <= 0x10FFFF) { return 4; }
    return 0;
}

# Encode `cp` into `buf` at `at`. -> bytes written (caller has already checked the room).
fn dh_text__encode(buf, at, cp): i64 {
    var n = dh_text_utf8_len(cp);
    if (n == 1) {
        store8(buf + at, cp);
        return 1;
    }
    if (n == 2) {
        store8(buf + at, 0xC0 | (cp >> 6));
        store8(buf + at + 1, 0x80 | (cp & 0x3F));
        return 2;
    }
    if (n == 3) {
        store8(buf + at, 0xE0 | (cp >> 12));
        store8(buf + at + 1, 0x80 | ((cp >> 6) & 0x3F));
        store8(buf + at + 2, 0x80 | (cp & 0x3F));
        return 3;
    }
    if (n == 4) {
        store8(buf + at, 0xF0 | (cp >> 18));
        store8(buf + at + 1, 0x80 | ((cp >> 12) & 0x3F));
        store8(buf + at + 2, 0x80 | ((cp >> 6) & 0x3F));
        store8(buf + at + 3, 0x80 | (cp & 0x3F));
        return 4;
    }
    return 0;
}

# @public — a new TEXTINPUT with a `cap`-byte buffer (capacity INCLUDES the NUL terminator).
fn dh_text_new(cap): i64 {
    var w = dh_widget_new(DhWidgetKind.TEXTINPUT);
    var c = cap;
    if (c < 2) { c = 2; }                  # room for one byte and a NUL
    var buf = alloc(c);
    store8(buf, 0);
    store64(w + DH_W_TEXT, buf);
    store64(w + DH_W_TEXT_CAP, c);
    store64(w + DH_W_TEXT_LEN, 0);
    store64(w + DH_W_CARET, 0);
    return w;
}

# @public — make an EXISTING widget an editable field over a buffer the CALLER owns.
#
# ⛔⛔ `dh_text_new` IS UNUSABLE FROM AN IMMEDIATE-MODE APP, AND THIS IS THE ENTRY POINT THAT FIXES
# IT. `dh_text_new` calls `alloc(cap)` — the GLOBAL allocator, deliberately, so the buffer outlives
# the frame — but the widget holding it is `dh_falloc`'d and dies at the next `dh_frame_begin`. An
# app that rebuilds its tree every frame must therefore call `dh_text_new` every frame, and every
# call leaks a fresh buffer into an allocator with no `free()`. A 256-byte field edited for ten
# seconds at 60 Hz is ~150 KB gone, permanently.
# ⇒ The buffer is the one piece of a text field that is genuinely APP state — it holds what the
# operator typed, which must outlive the tree that displays it. So the app should own it.
# ⭐ Pair with `dh_widget_set_key` and the caret survives the rewind too: the app allocates one
# buffer for the process, calls this each frame on the freshly built widget, and every editing
# operation below works unchanged.
#
# ⚠ `len` IS TAKEN FROM THE CALLER, NOT SCANNED. The caller already knows it, and a `strlen` here
# would make re-attaching an O(n) rescan on every frame — the cost this entry point exists to avoid.
# ⛔ THE CARET IS CLAMPED TO `len`, NOT TRUSTED. Re-attaching a SHORTER buffer than last frame is an
# ordinary thing for an app to do — the operator pressed Backspace — and a caret past the end would
# let `dh_text__prev` walk before the start of the buffer.
# ⚠ dhancha never frees this buffer. It did not allocate it.
fn dh_text_attach(w, buf, cap, len): i64 {
    if (w == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (dh_widget_kind(w) != TEXTINPUT) { return DHANCHA_ERR_BAD_WIDGET; }
    if (buf == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (cap < 2) { return DHANCHA_ERR_BAD_WIDGET; }
    var n = len;
    if (n < 0) { n = 0; }
    if (n > cap - 1) { n = cap - 1; }
    store8(buf + n, 0);
    store64(w + DH_W_TEXT, buf);
    store64(w + DH_W_TEXT_CAP, cap);
    store64(w + DH_W_TEXT_LEN, n);
    var c = load64(w + DH_W_CARET);
    if (c > n) { c = n; }
    if (c < 0) { c = 0; }
    store64(w + DH_W_CARET, c);
    return DHANCHA_OK;
}

fn dh_text_len(w): i64   { if (w == 0) { return 0; } return load64(w + DH_W_TEXT_LEN); }
fn dh_text_caret(w): i64 { if (w == 0) { return 0; } return load64(w + DH_W_CARET); }
fn dh_text_cap(w): i64   { if (w == 0) { return 0; } return load64(w + DH_W_TEXT_CAP); }

# @public — is this widget an editable field? Everything below refuses politely if not, so a caller
# can route keys at whatever has focus without first asking what kind it is.
fn dh_text_editable(w): i64 {
    if (w == 0) { return 0; }
    if (dh_widget_kind(w) != TEXTINPUT) { return 0; }
    if (load64(w + DH_W_TEXT_CAP) <= 0) { return 0; }
    if (load64(w + DH_W_TEXT) == 0) { return 0; }
    return 1;
}

# @public — empty the field and reset the caret.
fn dh_text_clear(w): i64 {
    if (dh_text_editable(w) == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store8(load64(w + DH_W_TEXT), 0);
    store64(w + DH_W_TEXT_LEN, 0);
    store64(w + DH_W_CARET, 0);
    return DHANCHA_OK;
}

# @public — insert codepoint `cp` at the caret; the caret advances past it. -> bytes inserted, or 0.
# ⚠ A FULL BUFFER REFUSES AND RETURNS 0 — it does not truncate the codepoint to fit. Writing 2 of a
# 3-byte sequence would corrupt the string rather than fill it, and the caller cannot tell from a
# byte count that it happened.
fn dh_text_insert(w, cp): i64 {
    if (dh_text_editable(w) == 0) { return 0; }
    var n = dh_text_utf8_len(cp);
    if (n == 0) { return 0; }
    var buf = load64(w + DH_W_TEXT);
    var len = load64(w + DH_W_TEXT_LEN);
    var cap = load64(w + DH_W_TEXT_CAP);
    if (len + n + 1 > cap) { return 0; }
    var at = load64(w + DH_W_CARET);
    # Shift the tail right by n, back to front so overlapping ranges do not eat themselves.
    var i = len;
    while (i >= at) {
        store8(buf + i + n, load8(buf + i));
        i = i - 1;
    }
    dh_text__encode(buf, at, cp);
    store64(w + DH_W_TEXT_LEN, len + n);
    store64(w + DH_W_CARET, at + n);
    store8(buf + len + n, 0);
    return n;
}

# @public — delete the character BEFORE the caret. -> bytes removed.
fn dh_text_backspace(w): i64 {
    if (dh_text_editable(w) == 0) { return 0; }
    var at = load64(w + DH_W_CARET);
    if (at <= 0) { return 0; }
    var buf = load64(w + DH_W_TEXT);
    var len = load64(w + DH_W_TEXT_LEN);
    var from = dh_text__prev(buf, at);
    var n = at - from;
    var i = at;
    while (i <= len) {
        store8(buf + i - n, load8(buf + i));
        i = i + 1;
    }
    store64(w + DH_W_TEXT_LEN, len - n);
    store64(w + DH_W_CARET, from);
    return n;
}

# @public — delete the character AT the caret (Delete, not Backspace). -> bytes removed.
fn dh_text_delete(w): i64 {
    if (dh_text_editable(w) == 0) { return 0; }
    var buf = load64(w + DH_W_TEXT);
    var len = load64(w + DH_W_TEXT_LEN);
    var at = load64(w + DH_W_CARET);
    if (at >= len) { return 0; }
    var to = dh_text__next(buf, at, len);
    var n = to - at;
    var i = to;
    while (i <= len) {
        store8(buf + i - n, load8(buf + i));
        i = i + 1;
    }
    store64(w + DH_W_TEXT_LEN, len - n);
    return n;
}

# @public — move the caret `delta` CHARACTERS (not bytes). -> the new byte offset.
fn dh_text_caret_move(w, delta): i64 {
    if (dh_text_editable(w) == 0) { return 0; }
    var buf = load64(w + DH_W_TEXT);
    var len = load64(w + DH_W_TEXT_LEN);
    var at = load64(w + DH_W_CARET);
    var d = delta;
    while (d < 0) { at = dh_text__prev(buf, at); d = d + 1; }
    while (d > 0) { at = dh_text__next(buf, at, len); d = d - 1; }
    store64(w + DH_W_CARET, at);
    return at;
}

# @public — how many CHARACTERS precede byte offset `at`. The painter needs this: the caret is
# stored as a byte offset (so edits are cheap) but must be drawn at a character column (so it sits
# between glyphs). Using the byte offset directly would push the caret right by one cell for every
# non-ASCII character already typed.
fn dh_text_char_index(w, at): i64 {
    if (dh_text_editable(w) == 0) { return 0; }
    var buf = load64(w + DH_W_TEXT);
    var i = 0;
    var n = 0;
    while (i < at) {
        if (dh_text__is_cont(load8(buf + i)) == 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn dh_text_home(w): i64 {
    if (dh_text_editable(w) == 0) { return 0; }
    store64(w + DH_W_CARET, 0);
    return 0;
}
fn dh_text_end(w): i64 {
    if (dh_text_editable(w) == 0) { return 0; }
    var len = load64(w + DH_W_TEXT_LEN);
    store64(w + DH_W_CARET, len);
    return len;
}

# @public — set the field's contents from a cstring, caret to the end. -> bytes stored.
# ⚠ TRUNCATES ON A CHARACTER BOUNDARY, never mid-sequence — a source longer than the buffer yields
# a shorter valid string rather than a same-length invalid one.
fn dh_text_set(w, s): i64 {
    if (dh_text_editable(w) == 0) { return 0; }
    dh_text_clear(w);
    if (s == 0) { return 0; }
    var buf = load64(w + DH_W_TEXT);
    var cap = load64(w + DH_W_TEXT_CAP);
    var n = 0;
    var done = 0;
    while (done == 0) {
        var b = load8(s + n);
        if (b == 0) {
            done = 1;
        } else {
            if (n + 1 >= cap) {
                done = 2;                  # out of room, source continues
            } else {
                store8(buf + n, b);
                n = n + 1;
            }
        }
    }
    # If the cut landed inside a multi-byte sequence, back up to that character's start.
    if (done == 2) {
        if (dh_text__is_cont(load8(s + n)) == 1) { n = dh_text__prev(buf, n); }
    }
    store8(buf + n, 0);
    store64(w + DH_W_TEXT_LEN, n);
    store64(w + DH_W_CARET, n);
    return n;
}

# @public — feed one key to the focused field. -> 1 if consumed, 0 if the caller should handle it.
#
# ⛔ WHAT IT DOES **NOT** CONSUME IS THE IMPORTANT HALF. Tab must keep cycling focus and Enter must
# keep reaching the app's handler; a field that swallowed them would trap the operator inside it
# with no keyboard way out. A single-line field has no use for either, so both fall through.
fn dh_text_key(w, sym): i64 {
    if (dh_text_editable(w) == 0) { return 0; }
    if (sym == DH_KEY_BACKSPACE) { dh_text_backspace(w); return 1; }
    if (sym == DH_KEY_DELETE)    { dh_text_delete(w); return 1; }
    if (sym == DH_KEY_LEFT)      { dh_text_caret_move(w, 0 - 1); return 1; }
    if (sym == DH_KEY_RIGHT)     { dh_text_caret_move(w, 1); return 1; }
    if (sym == DH_KEY_HOME)      { dh_text_home(w); return 1; }
    if (sym == DH_KEY_END)       { dh_text_end(w); return 1; }
    if (sym == DH_KEY_TAB)       { return 0; }    # focus movement — see the note above
    if (sym == DH_KEY_ENTER)     { return 0; }
    if (sym == DH_KEY_RETURN)    { return 0; }
    # ⚠ Everything else is text only if it is PRINTABLE. C0 controls (a stray 0x01 from a Ctrl
    # chord) would otherwise be inserted as literal bytes and render as garbage the operator cannot
    # see to delete. Named keys sit at 0x110000+ and are rejected by the same upper bound.
    if (sym < 32) { return 0; }
    if (sym == 127) { return 0; }
    if (sym > 0x10FFFF) { return 0; }
    if (dh_text_insert(w, sym) > 0) { return 1; }
    return 0;                                     # buffer full — not consumed, so a caller can beep
}

# --- theme.cyr ---

# theme.cyr — dhancha's binding to rupa, the shared desktop theme-token core.
#
# Widgets + chrome draw with the active MUDRA / SHANTA theme instead of hardcoded
# colours. Each helper packs a rupa 0xRRGGBB token (of the SINGLE active theme) into
# a sadish colour via sd_rgb, so an app just reads them: set a widget background with
# dh_widget_set_bg(w, dh_theme_panel()), or let dh_surface_render use the theme
# backdrop / border / text automatically. rupa is the ONE source shared with the
# compositor (aethersafha), so the toolkit matches the desktop chrome. Switch the
# whole desktop's look with rupa_theme_set_active_name("shanta-dark") etc.

# Pack a rupa 0xRRGGBB token into a sadish colour (0x00RRGGBB, the SdSurface format).
fn dh_theme_col(c): i64 { return sd_rgb(rupa_color_r(c), rupa_color_g(c), rupa_color_b(c)); }

fn dh_theme_bg(): i64     { return dh_theme_col(rupa_theme_bg(rupa_theme_active())); }
fn dh_theme_panel(): i64  { return dh_theme_col(rupa_theme_panel(rupa_theme_active())); }
fn dh_theme_widget(): i64 { return dh_theme_col(rupa_theme_widget(rupa_theme_active())); }
fn dh_theme_line(): i64   { return dh_theme_col(rupa_theme_line(rupa_theme_active())); }
fn dh_theme_ink(): i64    { return dh_theme_col(rupa_theme_ink(rupa_theme_active())); }
fn dh_theme_mute(): i64   { return dh_theme_col(rupa_theme_mute(rupa_theme_active())); }
fn dh_theme_accent(): i64 { return dh_theme_col(rupa_theme_accent(rupa_theme_active())); }
fn dh_theme_alert(): i64  { return dh_theme_col(rupa_theme_alert(rupa_theme_active())); }

# ⭐ THE INK THAT GOES *ON* AN ACCENT FILL (0.9.20, rupa 0.1.5). Every other token above names a
# colour you paint WITH; this one names the colour you paint ON TOP OF `dh_theme_accent()`.
# ⛔ WITHOUT IT THE SELECTED ROW WAS UNREADABLE. `dh_draw_list_selection` fills the focused
# selection with `accent`, and the row's label was then drawn in `ink` — on MUDRA dark that is
# 0xE7E9EF on 0x00E5FF, a contrast ratio of **1.27:1**. The highlight was landing on the one row the
# operator is looking at and erasing its text.
fn dh_theme_on_accent(): i64 { return dh_theme_col(rupa_theme_on_accent(rupa_theme_active())); }

# ⚠ `faint` and `held` were published by rupa and never bound here, so a consumer wanting either had
# to reach past the toolkit into rupa directly — which is the coupling this file exists to prevent.
fn dh_theme_faint(): i64  { return dh_theme_col(rupa_theme_faint(rupa_theme_active())); }
fn dh_theme_held(): i64   { return dh_theme_col(rupa_theme_held(rupa_theme_active())); }
# ⭐ THE MODAL BACKDROP'S COLOUR AND COVERAGE (0.9.23, rupa 0.1.6). Two values, because a scrim is a
# colour AND an alpha — and the light grounds dim with their own ink at 40% while the dark ones use
# the void at 70%. See `dh_draw_scrim`.
fn dh_theme_scrim(): i64   { return dh_theme_col(rupa_theme_scrim(rupa_theme_active())); }
fn dh_theme_scrim_a(): i64 { return rupa_theme_scrim_a(rupa_theme_active()); }

# --- table.cyr ---

# @public — dhancha COLUMNS: the shared width spec that makes a header and its rows line up.
# table.cyr — the POLICY over column geometry. Like list.cyr, this file owns no pixels and no state
# beyond the spec itself; rows are ordinary BOX_H widgets and cells are ordinary LABELs.
#
# ⭐ WHY A SHARED SPEC IS THE WHOLE FEATURE. dhancha could already draw a row of cells — a BOX_H of
# fixed-width LABELs lays out correctly on its own. What it could NOT do is guarantee that the header
# and every row agree on where column 2 starts. Rows laid out independently drift the moment one
# cell's content changes a width, and a table whose columns drift is worse than no columns at all:
# the reader trusts the alignment to tell them which value belongs to which heading.
# ⇒ One spec, read by the header and by every row. Alignment is then structural, not a coincidence
# that holds until someone passes a longer string.
#
# ⛔ FIXED WIDTHS, NOT CONTENT-MEASURED. Measuring the widest cell needs every row's text before the
# first row can be placed, which is a second full pass over a directory that may hold thousands of
# entries — and it makes the column geometry depend on what happens to be on screen, so scrolling
# would shift the columns. Auto-sizing is a real feature; it is not this one.
#
# ⚠ THE LAST COLUMN MAY BE 0, MEANING "take the remainder". Anything else would force the caller to
# know the container's pixel width at build time, which for a resizable pane it does not.

enum DhCols {
    DH_COLS_MAX    = 4;     # columns per spec
    DH_COLS_N      = 0;     # how many are in use
    DH_COLS_W0     = 8;     # widths, one qword each
    DH_COLS_SZ     = 40;
}

# @public — a spec for `n` columns (clamped to DH_COLS_MAX). All widths start 0 ("remainder").
fn dh_cols_new(n): i64 {
    var c = alloc(DH_COLS_SZ);
    if (c == 0) { return 0; }
    var k = n;
    if (k < 0) { k = 0; }
    if (k > DH_COLS_MAX) { k = DH_COLS_MAX; }
    store64(c + DH_COLS_N, k);
    var i = 0;
    while (i < DH_COLS_MAX) { store64(c + DH_COLS_W0 + i * 8, 0); i = i + 1; }
    return c;
}

# @public — re-initialise an EXISTING spec for `n` columns, without allocating.
# ⛔ THIS EXISTS BECAUSE A SPEC PER FRAME IS A LEAK. `alloc` is a bump allocator with no `free()`, so
# a consumer that built its column spec inside its render function retained 40 bytes per pane per
# frame, forever — which is precisely the per-frame allocation dhancha 0.9.13-0.9.16 spent four
# releases removing. A caller allocates ONE spec and resets it when its geometry changes.
fn dh_cols_reset(spec, n): i64 {
    if (spec == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var k = n;
    if (k < 0) { k = 0; }
    if (k > DH_COLS_MAX) { k = DH_COLS_MAX; }
    store64(spec + DH_COLS_N, k);
    var i = 0;
    while (i < DH_COLS_MAX) { store64(spec + DH_COLS_W0 + i * 8, 0); i = i + 1; }
    return 0;
}

# @public — how many columns this spec holds.
fn dh_cols_count(spec): i64 {
    if (spec == 0) { return 0; }
    return load64(spec + DH_COLS_N);
}

# @public — set column `i`'s width in px. 0 means "take the remaining width".
fn dh_cols_set_width(spec, i, w): i64 {
    if (spec == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (i < 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (i >= dh_cols_count(spec)) { return DHANCHA_ERR_BAD_WIDGET; }
    if (w < 0) { w = 0; }
    store64(spec + DH_COLS_W0 + i * 8, w);
    return 0;
}

# @public — column `i`'s width, or 0 (remainder / out of range).
fn dh_cols_width(spec, i): i64 {
    if (spec == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= dh_cols_count(spec)) { return 0; }
    return load64(spec + DH_COLS_W0 + i * 8);
}

# @public — total of the FIXED widths. A 0-width column contributes nothing, which is what makes
# this the right number to subtract when working out the remainder column's size.
fn dh_cols_fixed_total(spec): i64 {
    var t = 0;
    var i = 0;
    var n = dh_cols_count(spec);
    while (i < n) { t = t + dh_cols_width(spec, i); i = i + 1; }
    return t;
}

# @public — an empty row laid out for this spec: a BOX_H whose children are its cells.
# ⚠ Not added to any list — the caller does that, so a row can also be used as a HEADER sitting
# outside the list (which is exactly how a header avoids scrolling with the rows).
fn dh_table_row(spec): i64 {
    var r = dh_widget_new(DhWidgetKind.BOX);
    if (r == 0) { return 0; }
    dh_widget_set_layout(r, DhLayout.BOX_H);
    return r;
}

# @public — append cell `i` carrying `text`, sized from the spec. Returns the cell widget, or 0.
# ⚠ A 0-width column becomes flex 1 — it takes the leftover space — and every other column is fixed
# with flex 0. That is the "last column is the remainder" rule, expressed in the layout engine that
# already exists rather than in arithmetic here.
fn dh_table_cell(row, spec, i, text): i64 {
    if (row == 0) { return 0; }
    var c = dh_widget_new(DhWidgetKind.LABEL);
    if (c == 0) { return 0; }
    dh_widget_set_text(c, text);
    var w = dh_cols_width(spec, i);
    if (w > 0) {
        store64(c + DH_W_PREF_W, w);
        store64(c + DH_W_FLEX, 0);
    } else {
        store64(c + DH_W_FLEX, 1);
    }
    dh_widget_add_child(row, c);
    return c;
}

# @public — a header row for this spec: the same geometry as a data row, drawn in the theme's
# SECONDARY ink so it reads as a label rather than as another entry.
# ⛔ A HEADER THAT LOOKS LIKE A ROW IS A BUG, not a style choice — the first line of a file list
# reading as a file is exactly the misreading a header exists to prevent.
fn dh_table_header(spec): i64 {
    var h = dh_table_row(spec);
    if (h == 0) { return 0; }
    dh_widget_set_fg(h, dh_theme_mute());
    return h;
}

# --- surface.cyr ---

# @public — dhancha client surface / present path.
# surface.cyr — DhSurface: a client window backed by a pixel buffer.
#
# A DhSurface is the app's window from the client's side: a CPU pixel
# buffer the toolkit draws the widget tree into, then presents to the
# aethersafha compositor as a client surface over the native protocol (which the
# compositor composites onto the screen). v0.1.0 allocates the buffer;
# the draw + present code lands in v0.2 once sadish / rekha / mabda are
# wired.
#
# DhSurface struct layout (48 bytes):
#   +0:  width   — surface width in pixels
#   +8:  height  — surface height in pixels
#   +16: pixels  — owned RGBA8 buffer (width*height*4 bytes), or 0 until first ASKED for
#   +24: root    — the DhWidget tree root drawn into this surface (or 0)
#   +32: dirty   — 1 if the buffer needs a redraw before next present
#   +40: sds     — the cached sadish render target `dh_surface_render` draws into, or 0 until the
#                  first render. ⚠ 0.9.14 — the struct was 40 bytes before this field.
enum DhSurfaceField {
    DH_S_WIDTH  = 0;
    DH_S_HEIGHT = 8;
    DH_S_PIXELS = 16;
    DH_S_ROOT   = 24;
    DH_S_DIRTY  = 32;
    DH_S_SDS    = 40;
}

# Allocate a DhSurface. Returns a DhSurface* (or 0 on OOM — the caller
# can map that to DHANCHA_ERR_NO_SURFACE / _OOM).
#
# ⛔⛔ THE `w*h*4` PIXEL BUFFER IS NO LONGER ALLOCATED HERE (0.9.13), BECAUSE IT WAS ALLOCATED ALWAYS
# AND USED NEVER. `dh_surface_render` — the only function in this file that draws — ignores
# `DH_S_PIXELS` entirely and allocates its own `sd_surface_new(w, h)` to draw into. So every surface
# carried a full-size buffer that nothing ever wrote and nothing ever read.
# ⚠ AND THE ALLOCATOR UNDERNEATH HAS NO `free()`. `lib/alloc.cyr` is a bump allocator; `alloc_reset`
# rewinds the WHOLE arena, so a consumer that builds a surface per frame cannot reclaim any of it.
# MEASURED against crab 0.5.0 at 380x220 with 114 entries per pane: `crab_render` cost 746,440 B per
# frame, of which **334,440 B was this buffer** — 45 % of a per-keypress leak, for a buffer with no
# reader. At a 60 Hz repaint that alone is 20 MB/s.
# ⇒ The field is kept and the ALLOCATION IS DEFERRED to `dh_surface_pixels`, rather than deleted.
# `surface.cyr` is in the published dist bundle, so an external caller may hold the accessor; deferring
# keeps that caller's contract byte-for-byte (it still gets an owned w*h*4 buffer) while every caller
# that does not ask — which is all of dhancha, all of its programs, puka and crab — pays nothing.
# ⚠ THIS IS NOT THE ONE-LINE CHANGE IT LOOKS LIKE. Simply storing 0 breaks `programs/event_test.cyr`
# S): `dh_surface_present` refuses with `_NO_SURFACE` when pixels are 0 and `_UNSUPPORTED` otherwise,
# so a permanently-zero field silently converts dhancha's "refuse loudly and diagnosably" contract
# into "bad surface". Deferring preserves it: the refusal path asks for pixels, gets a real buffer,
# and still returns `_UNSUPPORTED`.
fn dh_surface_new(w, h): i64 {
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    var surf = alloc(48);
    store64(surf + DH_S_WIDTH, w);
    store64(surf + DH_S_HEIGHT, h);
    store64(surf + DH_S_PIXELS, 0);
    store64(surf + DH_S_ROOT, 0);
    store64(surf + DH_S_DIRTY, 1);
    store64(surf + DH_S_SDS, 0);
    return surf;
}

fn dh_surface_width(surf): i64  { return load64(surf + DH_S_WIDTH); }
fn dh_surface_height(surf): i64 { return load64(surf + DH_S_HEIGHT); }

# The surface's own RGBA8 buffer, allocated on the FIRST call and cached thereafter (0.9.13 — see
# the ⛔ on `dh_surface_new`). Returns 0 only for a null surface or a degenerate size.
# ⚠ IT IS STILL NOT WHAT `dh_surface_render` DRAWS INTO, and it never was — that has always been a
# separate `sd_surface_new`. This accessor hands back the same never-written buffer it always did;
# what changed is that a caller who does not ask no longer pays for it.
fn dh_surface_pixels(surf): i64 {
    if (surf == 0) { return 0; }
    var buf = load64(surf + DH_S_PIXELS);
    if (buf != 0) { return buf; }
    var w = load64(surf + DH_S_WIDTH);
    var h = load64(surf + DH_S_HEIGHT);
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    buf = alloc(w * h * 4);
    store64(surf + DH_S_PIXELS, buf);
    return buf;
}

fn dh_surface_root(surf): i64   { return load64(surf + DH_S_ROOT); }

# @public — resize a live surface to `w` x `h` (0.9.17). -> DHANCHA_OK, or `_NO_SURFACE` / `_BAD_ARG`.
#
# ⭐⭐ THIS IS THE ENTRY POINT `WINDOW_CONFIGURE` HAS BEEN WAITING FOR SINCE 0.9.12. The compositor has
# been able to ASK a client to resize for five releases, and no client could act on it: a `DhSurface`'s
# `w`/`h` were fixed at construction and there was no way to change them. A client that ignores the ask
# does not crash — it FREEZES at its old extent while the compositor clamps or refuses every blit.
#
# ⛔⛔ AND IT CLOSES A LATENT BUFFER OVERFLOW THAT 0.9.13 CREATED AND NOTHING COULD REACH UNTIL NOW.
# `dh_surface_pixels` allocates `w*h*4` **on first ask** and caches it. With `w`/`h` immutable that was
# safe by construction. The moment a surface can grow, a cached buffer sized for the OLD extent is
# handed to a caller that will write the NEW one — a silent heap overflow, in a bump allocator where
# the bytes past it are other live objects. ⇒ **The pixel cache MUST be dropped here**, and it is. The
# next `dh_surface_pixels` re-allocates at the new size.
# ⚠ The old buffer is abandoned, not freed — there is nothing to free it with. A resize therefore costs
# one screenful, once, which is the right trade against handing back a short one.
#
# ⭐ THE RENDER TARGET IS **NOT** DROPPED HERE, DELIBERATELY. `dh_surface_render` already compares the
# cached target's dimensions against the surface's and re-allocates on a mismatch. That branch was
# written in 0.9.14, documented as unreachable, and measured as such — deleting it did not fail
# `draw_test`. **This function is what makes it live**, which is exactly what its ⚠ said would happen,
# so the check stays the mechanism rather than being duplicated into a second place that can drift.
fn dh_surface_resize(surf, w, h): i64 {
    if (surf == 0) { return DHANCHA_ERR_NO_SURFACE; }
    if (w <= 0) { return DHANCHA_ERR_BAD_ARG; }
    if (h <= 0) { return DHANCHA_ERR_BAD_ARG; }
    if (load64(surf + DH_S_WIDTH) == w) {
        if (load64(surf + DH_S_HEIGHT) == h) { return DHANCHA_OK; }   # no-op: same extent
    }
    store64(surf + DH_S_WIDTH, w);
    store64(surf + DH_S_HEIGHT, h);
    store64(surf + DH_S_PIXELS, 0);        # ⛔ see above — a stale-sized cache is an overflow
    store64(surf + DH_S_DIRTY, 1);
    return DHANCHA_OK;
}

# Attach the widget-tree root that this surface renders.
fn dh_surface_set_root(surf, root): i64 {
    if (surf == 0) { return DHANCHA_ERR_NO_SURFACE; }
    store64(surf + DH_S_ROOT, root);
    store64(surf + DH_S_DIRTY, 1);
    # ⭐⭐ RE-BIND THE RETAINED INPUT STATE (0.9.24). This is the one moment in a frame when the new
    # tree exists and the pointers `dh_frame_begin` dropped are known to be dead — so it is where
    # keyed focus, hover, press and drag come back to life. See `dh_rebind_input`.
    # ⛔ HERE RATHER THAN IN THE APP, for the same reason `crab_render` owns its arena: a step the
    # caller must remember is a step that gets forgotten, and forgetting this one restores exactly
    # the bug the keys exist to fix — silently, with a green suite.
    # ⚠ NO-OP FOR AN APP THAT KEYS NOTHING. Every shadow is 0, every branch is skipped, and the
    # function returns having touched nothing.
    dh_rebind_input(root);
    return DHANCHA_OK;
}

# ⛔⛔ THIS FUNCTION CANNOT PRESENT, AND UNTIL 0.9.5 IT CLAIMED IT HAD.
# It validated the surface, cleared the dirty flag and returned **DHANCHA_OK** — announcing success
# while sending nothing to the compositor. An app that reached for the obviously-named entry point got
# a silent no-op and a blank window, with a success code to explain it away. Nothing in this repo calls
# it, including dhancha's own programs, which is why the lie survived: it was never exercised.
#
# ⭐ THE REASON IT CANNOT WORK IS STRUCTURAL, NOT MISSING CODE. Presenting needs a CONNECTION, and this
# signature takes only a surface — there is no client, no fd, nowhere to send. The real entry point is
# `dh_client_present(c, surf, font)` in `dh_client.cyr`, which renders via `dh_surface_render` and hands
# the pixels to `setu_client_present`. That has existed since the client layer landed.
#
# ⇒ REFUSE, LOUDLY AND DIAGNOSABLY, rather than delete. `surface.cyr` is in the published dist bundle,
# so an external caller may exist; today it gets silence, and after this it gets an error code it can
# act on. ⚠ `DHANCHA_ERR_UNSUPPORTED` is the honest one — the operation is not supported *at this entry
# point*, as opposed to a bad surface (`_NO_SURFACE`) or a transient failure.
# ⚠ AND IT NO LONGER CLEARS THE DIRTY FLAG. Clearing it said "this surface has been shown", which was
# false, and would make a later real present skip a surface that had never reached the screen.
fn dh_surface_present(surf): i64 {
    if (surf == 0) { return DHANCHA_ERR_NO_SURFACE; }
    if (dh_surface_pixels(surf) == 0) { return DHANCHA_ERR_NO_SURFACE; }
    return DHANCHA_ERR_UNSUPPORTED;
}

# ---- widget-tree draw (sadish fills/strokes + rekha text) ----------

# ============================================================================================
# ⭐⭐ CLIPPING (0.9.7) — the draw side of a bound the INPUT side has always enforced
# ============================================================================================
# ⛔ THE DISAGREEMENT THIS CLOSES: `dh_hit_test` rejects a point outside a widget's rect at EVERY
# level of the recursion, so a child painted outside its parent was already un-clickable. Draw did
# not clip, so it was still VISIBLE. That combination — pixels you can see, that do not respond —
# is the single failure mode this stack keeps producing, and it is worse than either half alone,
# because it looks like a working control. Clipping the painter makes the two agree: if you can see
# it, you can hit it.
# ⚠ Applied to EVERY container, not just LIST. A special case for the scrolling kind would leave
# the same disagreement in place everywhere else, which is how it got here.

# Fill (x,y,w,h) intersected with the clip box (clx,cly,clw,clh). Exact — an axis-aligned rect
# clipped by an axis-aligned rect is another rect, so there is nothing to approximate.
fn dh_fill_rect_clip(sds, x, y, w, h, color, clx, cly, clw, clh): i64 {
    var x0 = x;
    var y0 = y;
    var x1 = x + w;
    var y1 = y + h;
    if (x0 < clx) { x0 = clx; }
    if (y0 < cly) { y0 = cly; }
    if (x1 > clx + clw) { x1 = clx + clw; }
    if (y1 > cly + clh) { y1 = cly + clh; }
    if (x1 <= x0) { return 0; }
    if (y1 <= y0) { return 0; }
    return sd_fill_rect(sds, x0, y0, x1 - x0, y1 - y0, color);
}

# A 1px border as four clipped edge fills. ⚠ NOT `sd_rect`, which draws through the clip: a
# half-scrolled row would otherwise stamp its bottom edge across whatever sits below the viewport.
fn dh_rect_clip(sds, x, y, w, h, color, clx, cly, clw, clh): i64 {
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    dh_fill_rect_clip(sds, x, y, w, 1, color, clx, cly, clw, clh);
    dh_fill_rect_clip(sds, x, y + h - 1, w, 1, color, clx, cly, clw, clh);
    dh_fill_rect_clip(sds, x, y, 1, h, color, clx, cly, clw, clh);
    dh_fill_rect_clip(sds, x + w - 1, y, 1, h, color, clx, cly, clw, clh);
    return 0;
}

# Draw `text` (a cstring) left-aligned inside a box at (x, y) of height h, onto
# the sadish surface `sds`, using `font` (a RekhaFont). Each glyph is converted
# to a sadish path (scaled so the em-height ~= h) and union-filled into one
# coverage canvas, then blit in `ink`. Advance is a fixed ~0.6em (real hmtx
# advances are a rekha v0.4 item). No-op if font is 0.
#
# ⚠ THE PUBLIC SIGNATURE IS UNCHANGED — it defaults to the theme's primary ink. `dh_draw_text_ink`
# is the variant that takes a colour, because the selected row needs a DIFFERENT one (0.9.20).
fn dh_draw_text(sds, font, text, x, y, h, clx, cly, clw, clh): i64 {
    return dh_draw_text_ink(sds, font, text, x, y, h, clx, cly, clw, clh, dh_theme_ink());
}

fn dh_draw_text_ink(sds, font, text, x, y, h, clx, cly, clw, clh, ink): i64 {
    if (text == 0) { return 0; }
    if (font == 0) {
        # Bitmap path: blit the kashi VGA 8x16 SYSTEM font (full CP437, crisp +
        # monospace, matching the compositor chrome) directly into the sadish
        # surface. rekha (font != 0) stays for scalable TrueType when a .ttf loads.
        kashi_font_init();
        var sw = sd_surface_width(sds);
        var sstride = sd_surface_stride(sds) / 4;   # see canvas.cyr: width != stride when wrapped
        var sh2 = sd_surface_height(sds);
        var pix = sd_surface_pixels(sds);
        # ⚠ `ink` is the PARAMETER now, not `dh_theme_ink()` — that is what lets the selected row
        # draw its label in on-accent instead of vanishing into the highlight.
        # The per-pixel bound is the SURFACE intersected with the CLIP. Folding them together here
        # means the inner loop keeps its original four comparisons — clipping costs nothing per pixel.
        var bx0 = clx; if (bx0 < 0) { bx0 = 0; }
        var by0 = cly; if (by0 < 0) { by0 = 0; }
        var bx1 = clx + clw; if (bx1 > sw) { bx1 = sw; }
        var by1 = cly + clh; if (by1 > sh2) { by1 = sh2; }
        var ky = y + (h - 16) / 2;             # vertically centre the 16px glyph in the box
        var kx = x + 3;
        var ki = 0;
        while (load8(text + ki) != 0) {
            var kc = load8(text + ki);
            var kr = 0;
            while (kr < 16) {
                var kb = kashi_glyph_row(0, kc, kr);   # KASHI_FONT_VGA_8X16 = 0; one row byte
                var kcol = 0;
                while (kcol < 8) {
                    if ((kb & (1 << (7 - kcol))) != 0) {
                        var px = kx + kcol; var py = ky + kr;
                        if (px >= bx0) { if (px < bx1) { if (py >= by0) { if (py < by1) {
                                        # ⚠ 0xFF000000 IS LOAD-BEARING (v0.9.2). `ink` is a rupa theme
                                        # token, 0x00RRGGBB — alpha byte ZERO. Every other painter in the
                                        # stack writes byte 3 = 255, so this one path produced glyph pixels
                                        # that were transparent-by-accident. Harmless while nothing read
                                        # byte 3; under agnos's gpu_shader_op#92 op 0x01 (premultiplied
                                        # src-over, which DOES read it) the shader is
                                        # `out = src + dst*(1 - src_a)`, so alpha 0 gives `out = src + dst`
                                        # — system-font text would render as an additive over-bright
                                        # ghost, not vanish, which is harder to notice, not easier.
                                        store32(pix + (py * sstride + px) * 4, ink | 0xFF000000);
                                    } } } }
                    }
                    kcol = kcol + 1;
                }
                kr = kr + 1;
            }
            kx = kx + 9;                        # 8px glyph + 1px gap (monospace)
            ki = ki + 1;
        }
        return 0;
    }
    var upem = rekha_units_per_em(font);
    if (upem <= 0) { return 0; }
    var scale = (h << 16) / upem;          # 16.16 pixels per design unit
    var advf = (h * 6) / 10;               # fixed advance ~0.6 em
    if (advf <= 0) { advf = 4; }
    var baseline = y + h - 2;              # sit text near the box bottom
    var cx = x + 2;

    var cv = sd_canvas_new(sd_surface_width(sds), sd_surface_height(sds));
    # ⭐ REAL per-pixel clipping for the scalable path — sadish's clip stack (v0.4.0) multiplies the
    # clip mask into the coverage before the blit, so a glyph straddling the viewport edge is CUT,
    # not dropped. Dropping the whole glyph was the tempting shortcut and it reads as text that
    # vanishes a row early while scrolling.
    sd_canvas_clip_push_rect(cv, clx, cly, clx + clw, cly + clh);
    var i = 0;
    while (load8(text + i) != 0) {
        var cp = load8(text + i);
        if (cp != 32) {                    # spaces contribute no coverage
            var path = rekha_char_to_sdpath(font, cp, scale, cx << 16, baseline << 16);
            sd_canvas_fill_union(cv, path, SD_FILL_NONZERO);
        }
        cx = cx + advf;
        i = i + 1;
    }
    # ⛔ THIS WAS HARDCODED `sd_rgb(255, 255, 255)` AND IGNORED THE THEME ENTIRELY (fixed 0.9.20).
    # White glyphs on MUDRA light's 0xFBF8F0 paper is white-on-white — the scalable-font path was
    # unreadable on both light grounds, and had been since it was written. The bitmap path (what
    # everything actually ships with, `font == 0`) always honoured the theme, which is why nothing
    # caught it.
    sd_canvas_blit(cv, sds, ink);
    sd_canvas_clip_pop(cv);
    return 0;
}

# Draw one widget (background, border, text) onto `sds`, then recurse into its
# children. `font` may be 0 (text skipped).
#
# ⚠ THE PUBLIC SIGNATURE IS UNCHANGED. puka calls this directly (`puka/src/ui.cyr`), as do dhancha's
# own test programs, so the ink travels in `dh_draw_widget_ink` rather than as a 8th parameter here.
fn dh_draw_widget(sds, wgt, font, clx, cly, clw, clh): i64 {
    return dh_draw_widget_ink(sds, wgt, font, clx, cly, clw, clh, dh_theme_ink(), 0);
}

# `ink` is the text colour for this widget AND everything below it, so a row handed on-accent passes
# it to its own labels — a row is not always a leaf.
# `forced` = 1 when the ink is a legibility GUARANTEE the subtree may not override (the selected
# row's on-accent). A widget's own `DH_W_FG` is a preference and yields to it.
fn dh_draw_widget_ink(sds, wgt, font, clx, cly, clw, clh, ink, forced): i64 {
    if (forced == 0) {
        var ownfg = dh_widget_fg(wgt);
        if (ownfg != (0 - 1)) { ink = ownfg; }
    }
    var x = dh_widget_x(wgt);
    var y = dh_widget_y(wgt);
    var w = dh_widget_w(wgt);
    var h = dh_widget_h(wgt);
    # ⛔ CULL FIRST. A subtree with no visible pixels must not paint OR recurse — in a 10 000-row list
    # scrolled to the bottom, the rows above are not "clipped away cheaply", they are never visited.
    # That is what makes a long list cost the viewport rather than the content.
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    if (x >= clx + clw) { return 0; }
    if (y >= cly + clh) { return 0; }
    if (x + w <= clx) { return 0; }
    if (y + h <= cly) { return 0; }

    var bg = dh_widget_bg(wgt);
    if (bg != (0 - 1)) {
        dh_fill_rect_clip(sds, x, y, w, h, bg, clx, cly, clw, clh);
    }
    # ⭐ A BORDER ON ANY WIDGET (0.9.23). Until now `dh_rect_clip` had exactly ONE call site in the
    # whole repo and it was hardcoded to BUTTON and to `dh_theme_line()`. A menu panel and a sheet
    # are both defined visually by their EDGE — and with no translucency available for a backdrop
    # (see `dh_draw_scrim`), the border is doing all the work of saying *this is a layer, not part of
    # the page*.
    # ⛔ RESOLVED HERE, AT DRAW TIME, NEVER STORED AT CONSTRUCTION. A widget that captured
    # `dh_theme_line()` when it was built would keep the old colour across a theme switch.
    var bcol = dh_widget_border(wgt);
    if (bcol == DH_BORDER_INHERIT) {
        bcol = DH_BORDER_NONE;
        if (dh_widget_kind(wgt) == BUTTON) { bcol = dh_theme_line(); }
    }
    if (bcol != DH_BORDER_NONE) {
        dh_rect_clip(sds, x, y, w, h, bcol, clx, cly, clw, clh);
    }
    # ⚠ AFTER the border and BEFORE the children, so a sheet's backdrop dims what is under it without
    # dimming the sheet itself — the sheet is a SIBLING in the layer, not a child of the scrim.
    if ((dh_widget_flags(wgt) & DH_FLAG_SCRIM) != 0) {
        dh_draw_scrim(sds, x, y, w, h, clx, cly, clw, clh);
    }
    # ⚠ BEFORE the text below, so a text set on a bar lands ON TOP of it rather than under it — the
    # same ordering reason the CANVAS arm sits before its children.
    if (dh_widget_kind(wgt) == PROGRESS) {
        dh_draw_progress(sds, wgt, x, y, w, h, clx, cly, clw, clh);
    }
    var text = dh_widget_text(wgt);
    if (text != 0) {
        dh_draw_text_ink(sds, font, text, x, y, h, clx, cly, clw, clh, ink);
    }
    # ⭐ THE CARET (0.9.7). Drawn only on the FOCUSED field: a caret in every text box at once says
    # every box is taking input, which is exactly the thing the operator uses it to find out.
    # ⚠ Positioned with the bitmap font's 9px advance — correct for the system font (which is what
    # `font == 0` draws with, and is monospace) and an approximation under rekha, where glyph
    # advances vary. A caret that drifts from proportional text is a rekha-advance item, not a
    # reason to withhold the caret from the monospace path that is what everything ships with.
    if (dh_widget_kind(wgt) == TEXTINPUT) {
        if (dh_focus_get() == wgt) {
            var cbytes = dh_text_caret(wgt);
            var cchars = dh_text_char_index(wgt, cbytes);
            var cx2 = x + 3 + (cchars * 9);
            var cy2 = y + (h - 16) / 2;
            dh_fill_rect_clip(sds, cx2, cy2, 1, 16, dh_theme_ink(), clx, cly, clw, clh);
        }
    }

    # ⭐ THE CHILD CLIP IS THIS NODE'S BOX INTERSECTED WITH THE INHERITED ONE. Intersecting (rather
    # than replacing) is what makes clipping compose through nesting: a row inside a list inside a
    # scrolled panel is bounded by all three, and no level can widen what an ancestor narrowed.
    var kx0 = x; var ky0 = y;
    var kx1 = x + w; var ky1 = y + h;
    if (kx0 < clx) { kx0 = clx; }
    if (ky0 < cly) { ky0 = cly; }
    if (kx1 > clx + clw) { kx1 = clx + clw; }
    if (ky1 > cly + clh) { ky1 = cly + clh; }
    if (kx1 <= kx0) { return 0; }
    if (ky1 <= ky0) { return 0; }

    # ⭐ CANVAS (0.9.9) — hand the rectangle to the app. Placed after this widget's own background
    # and BEFORE its children, so a canvas can be used as a backdrop with widgets composed on top;
    # it is given the CHILD clip, which is its own box intersected with everything above it.
    if (dh_widget_kind(wgt) == CANVAS) {
        var dfn = dh_canvas_draw_fn(wgt);
        if (dfn != 0) { fncall6(dfn, wgt, sds, kx0, ky0, kx1 - kx0, ky1 - ky0); }
    }

    # ⚠ BEFORE the rows, so a row's own background (if it has one) paints OVER the highlight rather
    # than the highlight hiding the row. A row that wants to stay visible when selected simply keeps
    # its background; the default — no background — lets the highlight through, which is what an app
    # that has stopped hand-rolling its selection expects.
    if (dh_widget_kind(wgt) == LIST) {
        dh_draw_list_selection(sds, wgt, kx0, ky0, kx1 - kx0, ky1 - ky0);
    }
    # ⭐ GRID (0.9.25) — the selected CELL's highlight, painted here for the same reason a LIST's is:
    # so the app never names `accent`. That is the whole reason GRID is a kind (ADR 0001 in crab).
    if (dh_widget_kind(wgt) == GRID) {
        dh_draw_grid_selection(sds, wgt, kx0, ky0, kx1 - kx0, ky1 - ky0);
    }

    # ⭐⭐ THE SELECTED ROW'S TEXT MUST SURVIVE ITS OWN HIGHLIGHT (0.9.20, rupa 0.1.5).
    # ⛔ THE HIGHLIGHT WAS ERASING THE ROW IT HIGHLIGHTED. `dh_draw_list_selection` above fills the
    # focused selection with `accent`, and every child was then drawn in the theme's primary `ink` —
    # on MUDRA dark, 0xE7E9EF on 0x00E5FF is a contrast ratio of **1.27:1**. The one row the operator
    # is looking at was the one row that could not be read.
    # ⚠ ONLY THE ACCENT FILL NEEDS THIS. An unfocused list fills its selection with `line` instead,
    # and normal ink reads fine on `line` in all four grounds — so the swap is gated on focus exactly
    # as the fill is, and the two cannot drift apart.
    var selrow = 0;
    if (dh_widget_kind(wgt) == LIST) {
        if (dh_focus_within(wgt) == 1) {
            var ssel = dh_widget_sel(wgt);
            if (ssel >= 0) { selrow = dh_list_row_at(wgt, ssel); }
        }
    }
    var child = dh_widget_first_child(wgt);
    while (child != 0) {
        var cink = ink;
        # ⚠ Compared by WIDGET POINTER, not by index — `dh_list_row_at` already answers which widget
        # is the selected row, and counting children again would be a second source of truth.
        var cforced = forced;
        if (selrow != 0) { if (child == selrow) { cink = dh_theme_on_accent(); cforced = 1; } }
        dh_draw_widget_ink(sds, child, font, kx0, ky0, kx1 - kx0, ky1 - ky0, cink, cforced);
        child = dh_widget_next_sibling(child);
    }
    return 0;
}

# ⭐⭐ THE SELECTION HIGHLIGHT (0.9.8) — drawn by the TOOLKIT, not by each app.
# ⛔ WHY THIS MOVED HERE. 0.9.7 stored `DH_W_SEL` and used it for scrolling, but nothing painted it,
# so a consumer adopting LIST still had to set a background on the selected row itself — which is
# exactly the hand-rolling the container was supposed to end. crab was the consumer that proved it:
# porting its panes onto LIST deleted the truncation and the scroll arithmetic and left its
# `if (selected) { bg = accent }` block untouched. A container that owns the selection must own how
# the selection LOOKS, or it has only taken half the job.
# ⚠ ACCENT WHEN FOCUSED, MUTED OTHERWISE. Two panes both showing an accented row is a display that
# cannot answer "which one do my arrow keys drive" — the single question a two-pane file manager
# exists to make obvious. This is the rule crab, puka and the launcher had each written separately.
# ⭐⭐ THE BAR (0.9.22) — two rects, and the second one's WIDTH is the information.
#
# ⛔ INDETERMINATE IS PAINTED, NOT OMITTED. An empty track and a 0%-full track are the same picture,
# and the whole reason `den <= 0` exists is that "I do not know" and "nothing has happened yet" are
# different facts. `held` is rupa's own token for exactly this state — its field comment reads
# "pending / sandbox / held" — so the bar says *pending* in the palette's own vocabulary rather than
# in a colour dhancha invented. It also puts `held` to work: rupa published it and 0.9.20 bound it
# with nothing in the toolkit using it.
#
# ⚠ HANDED THE INHERITED CLIP, not an intersected child clip — unlike `dh_draw_list_selection`,
# which paints a CHILD's rect and therefore needs the narrower one. A PROGRESS has no children.
# ⚠ `dh_fill_rect_clip`, never `sd_fill_rect`: a bar inside a scrolled list must be cut by the
# viewport like everything else, and the bare sadish call does not know about the clip.
# ⭐⭐ THE SCRIM (0.9.23) — a REAL translucent veil, as of sadish 0.5.3 and rupa 0.1.6.
#
# ⚠ THIS SHIPPED AS A SCANLINE DITHER FOR ABOUT AN HOUR, AND THE REASON IT DID IS WORTH KEEPING.
# sadish had no fill that read its destination — every span writer stored four bytes per pixel and
# never loaded — and `sd_alpha_of` maps a 0 alpha byte to **opaque**, so `sd_rgba(0,0,0,128)` handed
# to a fill painted SOLID BLACK. The honest options were an opaque panel (hides rather than dims), a
# hand-written coverage buffer through `sd_canvas_blit` (bypasses the clip stack and allocates a
# screenful per frame), or 50% coverage at scanline granularity. The dither shipped.
# ⛔ IT WAS NOT A LIMIT, IT WAS TWO UNFINISHED REPOS. `sd_fill_rect_blend` (sadish 0.5.3) is a fill
# that composites source-over, and `scrim` / `scrim_a` (rupa 0.1.6) are the palette's own answer to
# how far the page recedes. Both were a short change away in repos this stack owns. Calling that a
# limitation was wrong, and the dither is gone.
#
# ⛔ THE COLOUR AND THE ALPHA BOTH COME FROM THE THEME, and they are not interchangeable: the dark
# grounds dim with the void at 70%, the light grounds with their own INK at 40%. The void at 70% over
# rice paper would black the page out rather than let it recede — which is exactly why this is a
# per-theme token and not one number chosen here.
# ⚠ HANDED THE INHERITED CLIP, like `dh_draw_progress` and unlike `dh_draw_list_selection`: it paints
# its OWN rect, not a child's.
fn dh_draw_scrim(sds, x, y, w, h, clx, cly, clw, clh): i64 {
    # ⚠ Intersect by hand: `sd_fill_rect_blend` is a sadish primitive and knows nothing about
    # dhancha's clip stack, so the rect handed to it must already be the visible part.
    var x0 = x;
    var y0 = y;
    var x1 = x + w;
    var y1 = y + h;
    if (x0 < clx) { x0 = clx; }
    if (y0 < cly) { y0 = cly; }
    if (x1 > clx + clw) { x1 = clx + clw; }
    if (y1 > cly + clh) { y1 = cly + clh; }
    if (x1 <= x0) { return 0; }
    if (y1 <= y0) { return 0; }
    return sd_fill_rect_blend(sds, x0, y0, x1 - x0, y1 - y0, dh_theme_scrim(), dh_theme_scrim_a());
}

fn dh_draw_progress(sds, wgt, x, y, w, h, clx, cly, clw, clh): i64 {
    var p = dh_progress_permille(wgt);
    if (p < 0) {
        return dh_fill_rect_clip(sds, x, y, w, h, dh_theme_held(), clx, cly, clw, clh);
    }
    dh_fill_rect_clip(sds, x, y, w, h, dh_theme_line(), clx, cly, clw, clh);
    # ⚠ MULTIPLY THEN DIVIDE, the house convention the flex distributor already uses. At p == 1000
    # this is EXACTLY `w`, so a finished bar leaves no track pixel at the right edge — the off-by-one
    # that would otherwise make "done" and "nearly done" look the same.
    var fw = w * p / 1000;
    if (fw <= 0) { return 0; }
    return dh_fill_rect_clip(sds, x, y, fw, h, dh_theme_accent(), clx, cly, clw, clh);
}

# The selected GRID cell's highlight. ⚠ Same split as a list's: `accent` when the grid holds focus,
# `line` when it does not — two grids side by side must say which one the arrow keys drive, and a
# muted highlight is how a pane that is merely *remembering* a selection says so.
# ⛔ FROM THE CELL'S LAID-OUT BOX, never from the wrap arithmetic. Recomputing it here would be a
# second answer to "where is cell i", free to disagree with the one the cell was drawn at.
fn dh_draw_grid_selection(sds, wgt, clx, cly, clw, clh): i64 {
    var sel = dh_widget_sel(wgt);
    if (sel < 0) { return 0; }
    var cell = dh_grid_cell_at(wgt, sel);
    if (cell == 0) { return 0; }
    var col = dh_theme_line();
    if (dh_focus_within(wgt) == 1) { col = dh_theme_accent(); }
    return dh_fill_rect_clip(sds, dh_widget_x(cell), dh_widget_y(cell),
      dh_widget_w(cell), dh_widget_h(cell), col, clx, cly, clw, clh);
}

fn dh_draw_list_selection(sds, wgt, clx, cly, clw, clh): i64 {
    var sel = dh_widget_sel(wgt);
    if (sel < 0) { return 0; }
    var row = dh_list_row_at(wgt, sel);
    if (row == 0) { return 0; }
    var col = dh_theme_line();
    if (dh_focus_within(wgt) == 1) { col = dh_theme_accent(); }
    var rx = dh_widget_x(row);
    var ry = dh_widget_y(row);
    var rw = dh_widget_w(row);
    var rh = dh_widget_h(row);
    return dh_fill_rect_clip(sds, rx, ry, rw, rh, col, clx, cly, clw, clh);
}

# @public — render `surf`'s widget tree into a sadish SdSurface and return it (BGRA pixels; the
# caller can present/PPM it). `font` may be 0. Returns 0 on a bad surface or on OOM.
#
# ⛔⛔ THE RETURNED SURFACE IS OWNED BY `surf` AND IS REUSED ACROSS CALLS (0.9.14). THIS IS A
# CONTRACT CHANGE: until 0.9.13 every call allocated a brand-new `sd_surface_new`, so two renders of
# the same DhSurface produced two independent images. **They are now the same object**, and a caller
# holding the result of an earlier render sees it overwritten by the next one.
# ⇒ A caller that genuinely wants two images at once must render into **two DhSurfaces**. That is
# strictly clearer than the old behaviour, where the aliasing question was invisible because the
# answer was always "no" — and always cost a full-size buffer to say so.
#
# ⚠ WHY THIS IS WORTH A CONTRACT CHANGE. `lib/alloc.cyr` is a bump allocator with **no `free()`**, so
# the per-call `sd_surface_new` was not a transient — it was retained for the life of the process,
# every frame, forever. Measured against crab at 380x220: **334,432 B per frame**, which after
# 0.9.13's fix was **81 % of the whole frame cost**. An immediate-mode toolkit that cannot repaint
# without leaking a screenful cannot host an animation, a progress bar or a clock.
#
# ⭐ THE DIMENSION CHECK IS LIVE AS OF 0.9.17, AND IT WAS WRITTEN BEFORE ANYTHING COULD REACH IT.
# Through 0.9.14–0.9.16 there was no `dh_surface_resize`, so `w`/`h` could not change on a live
# DhSurface and this branch was **unreachable** — deleting it did not fail `draw_test`, which was
# measured and said out loud rather than glossed. It was kept because `WINDOW_CONFIGURE` (0.9.12)
# exists precisely so clients can resize, and whoever added that entry point would otherwise have had
# to remember to invalidate this cache. `dh_surface_resize` landed, the branch became reachable, and
# `draw_test` S) now pins it: deleting these four lines fails three checks.
# ⇒ Correct by construction beat correct by "nothing calls resize yet", and the bill came due in three
# releases rather than never.
# ⚠ On a miss the previous target is ABANDONED, not freed — there is nothing to free it with. A
# resize therefore costs one screenful, once, which is the right trade against leaking one per frame.
fn dh_surface_render(surf, font): i64 {
    if (surf == 0) { return 0; }
    var w = dh_surface_width(surf);
    var h = dh_surface_height(surf);
    var sds = load64(surf + DH_S_SDS);
    if (sds != 0) {
        if (sd_surface_width(sds) != w) { sds = 0; }
    }
    if (sds != 0) {
        if (sd_surface_height(sds) != h) { sds = 0; }
    }
    if (sds == 0) {
        sds = sd_surface_new(w, h);
        # ⚠ GUARD ADDED 0.9.14. The old body passed `sd_surface_new`'s result straight into
        # `sd_clear` without checking it, so an OOM here dereferenced 0 instead of returning it.
        if (sds == 0) { return 0; }
        store64(surf + DH_S_SDS, sds);
    }
    sd_clear(sds, dh_theme_bg());          # the active rupa theme's desktop void
    # ⭐ `sd_clear` fills EVERY pixel of the surface (`sd_fill_rect(s, 0, 0, w, h, …)`), which is what
    # makes reuse pixel-identical to a fresh allocation: no residue from the previous frame can
    # survive it. If that ever stops being true, reuse stops being safe.
    var root = dh_surface_root(surf);
    if (root != 0) {
        # The root clip is the surface itself — every widget is bounded by the thing it is drawn on.
        dh_draw_widget(sds, root, font, 0, 0, w, h);
    }
    return sds;
}

# --- setu_client.cyr ---

# dhancha — setu client convenience layer (thin, over setu's reference client).
#
# setu (>= 0.2.0) now OWNS the client transport IMPLEMENTATION (the framing
# primitives `setu_connect` / `setu_send` / `setu_recv` / `setu_read_exact` /
# `setu_read_msg`, and the persistent `setu_client_*`). The client was promoted
# INTO setu so dhancha + puka share ONE implementation (agnosticos
# native-display-protocol.md).
#
# ⛔ THE TRANSPORT DESCRIBED BELOW IS RETIRED (2026-08-03) — as the WRONG PRIMITIVE for a local
# display protocol (nothing to route, nothing to checksum, no window to negotiate, no business
# owning a port), NOT because it never worked. Scope the history: BEFORE `net_src_for` (agnos
# 1.56.34) it could not complete a compositor↔client handshake on an ordinary boot, and the only
# test that passed in that era did so because the `AETHERSAFHA_SETU_SELFTEST` kernel hook
# assigned `net_ip = 0x7F000001` (hook + smoke deleted; claims tracing to them are FALSE GREENS).
# AFTER `net_src_for` it did work un-rigged: 2026-08-02, the hook-scanning harness
# `aethersafha-clients-test.py` reached "connected: 2, presented: 2" — the real dhancha `crab`
# and setu's `present_probe` both connected and presented (QEMU `-smp 1`; never on iron, `-smp 4`
# fault-kills). The replacement is the agnos socket (`anu`) — agnos
# `docs/development/planning/ipc.md` §9/§10. These forwarders are unaffected in shape; what they
# forward TO is what changes.
#
# Since setu 0.3.0 the transport was (⛔ retired) cross-platform
# TCP over loopback:7700 (Linux BSD sockets + agnos kernel TCP) — the AF_UNIX
# `sockaddr_un` builder is gone, so the old `dh_setu_sockaddr` forwarder was
# dropped (the address is now the implicit loopback endpoint). This file no
# longer re-implements any transport — it just keeps the `dh_setu_*` names
# dhancha's probes use as thin forwarders + one-shot (connect → do → close)
# convenience wrappers over setu. The codec + transport are setu's; the toolkit
# binding is `dh_client.cyr`.

# --- framing primitives: forwarders to setu -------------------------------
fn dh_setu_connect(path): i64            { return setu_connect(path); }
fn dh_setu_send(fd, msg): i64            { return setu_send(fd, msg); }
fn dh_setu_recv(fd, msg_out): i64        { return setu_recv(fd, msg_out); }
fn dh_setu_read_exact(fd, buf, n): i64   { return setu_read_exact(fd, buf, n); }
fn dh_setu_read_msg(fd, msg_out): i64    { return setu_read_msg(fd, msg_out); }

# --- one-shot convenience (connect → do → close), over setu's primitives ---

# Connect, send a HELLO(version, role), close. -> 0 or the first negative code.
fn dh_setu_hello(path, version, role): i64 {
    var fd = setu_connect(path);
    if (fd < 0) { return fd; }
    var rc = setu_send(fd, setu_hello(version, role));
    syscall(SYS_CLOSE, fd);
    if (rc < 0) { return rc; }
    return 0;
}

# Connect, CREATE_SURFACE(w,h,flags), read SURFACE_CREATED, close. -> surface id
# (> 0), or a negative step/codec code / -8 unexpected reply.
fn dh_setu_create_surface(path, w, h, flags): i64 {
    var fd = setu_connect(path);
    if (fd < 0) { return fd; }
    var sr = setu_send(fd, setu_create_surface(w, h, flags));
    if (sr < 0) { syscall(SYS_CLOSE, fd); return sr; }
    var reply = setu_msg_new();
    var rr = setu_recv(fd, reply);
    syscall(SYS_CLOSE, fd);
    if (rr < 0) { return rr; }
    if (setu_msg_kind(reply) != SETU_SURFACE_CREATED) { return 0 - 8; }
    return setu_msg_arg(reply, 0);
}

# One-shot present of a deterministic w*h BGRA TEST buffer; returns the byte
# checksum the client SENT (> 0) so a caller can compare it against the server's
# received-byte sum. Negative on error. Uses setu's persistent client for the
# CREATE→ATTACH+payload→COMMIT round-trip.
fn dh_setu_send_buffer(path, w, h): i64 {
    var stride = w * 4;
    var nbytes = h * stride;
    var pix = alloc(nbytes);
    var sum = 0;
    var i = 0;
    while (i < nbytes) {
        var b = (i * 37 + 11) & 255;   # deterministic; the server reproduces the sum
        store8(pix + i, b);
        sum = sum + b;
        i = i + 1;
    }
    var c = setu_client_connect(path);
    if (c == 0) { return 0 - 20; }
    var rc = setu_client_present(c, pix, w, h);
    setu_client_close(c);
    if (rc < 0) { return rc; }
    return sum;
}

# One-shot present of an already-rendered w*h BGRA buffer `pix` (e.g. a widget
# surface's pixels). -> 0 on success or a negative code. Uses setu's client.
fn dh_setu_send_pixels(path, pix, w, h): i64 {
    var c = setu_client_connect(path);
    if (c == 0) { return 0 - 20; }
    var rc = setu_client_present(c, pix, w, h);
    setu_client_close(c);
    if (rc < 0) { return rc; }
    return 0;
}

# --- setu_input.cyr ---

# dhancha — setu input adapter: setu INPUT_* wire messages → DhEvents.
#
# The "compositor-fd input source" the sovereign-desktop doc describes: the
# client reads input frames off the setu transport and feeds them as DhEvents
# into the toolkit's dispatch (dh_run's DhQueue). Bridges event.cyr (DhEvent) +
# setu (the wire) + setu_client.cyr (the transport) — include it alongside
# src/lib.cyr + src/setu_client.cyr. Bite 11 wires dh_setu_read_event into
# dh_run's loop; here it's the standalone seam.

# Map a decoded setu INPUT_* message `m` to a fresh DhEvent (*DhEvent), or 0 if
# `m` is not an input message. The (a,b) payload maps 1:1 onto DhEvent:
#   INPUT_KEY(id,keysym,mods) → KEY(a=keysym, b=mods)
#   INPUT_PTR_MOVE(id,x,y)    → POINTER_MOVE(a=x, b=y)
#   INPUT_PTR_BTN(id,btn,st)  → POINTER_BTN(a=btn, b=st)
#   INPUT_PTR_SCROLL(id,d)    → POINTER_SCROLL(a=delta, + = up/away)
#   INPUT_FOCUS(id,focused)   → FOCUS(a=focused, b=0)
fn dh_setu_map_input(m): i64 {
    var k = setu_msg_kind(m);
    var dk = 0 - 1;
    var a = 0;
    var b = 0;
    if (k == SETU_INPUT_KEY)        { dk = KEY;          a = setu_msg_arg(m, 1); b = setu_msg_arg(m, 2); }
    elif (k == SETU_INPUT_PTR_MOVE) { dk = POINTER_MOVE; a = setu_msg_arg(m, 1); b = setu_msg_arg(m, 2); }
    elif (k == SETU_INPUT_PTR_BTN)  { dk = POINTER_BTN;  a = setu_msg_arg(m, 1); b = setu_msg_arg(m, 2); }
    elif (k == SETU_INPUT_PTR_SCROLL) { dk = POINTER_SCROLL; a = setu_msg_arg(m, 1); b = 0; }
    elif (k == SETU_INPUT_FOCUS)    { dk = FOCUS;        a = setu_msg_arg(m, 1); b = 0; }
    elif (k == SETU_CLOSE)          { dk = WINDOW_CLOSE; a = 0; b = 0; }
    elif (k == SETU_CONFIGURE)      { dk = WINDOW_CONFIGURE; a = setu_msg_arg(m, 1); b = setu_msg_arg(m, 2); }
    else { return 0; }
    var ev = dh_event_new(dk);
    store64(ev + DH_E_A, a);
    store64(ev + DH_E_B, b);
    return ev;
}

# ============================================================================================
# ⭐⭐ ONE SCRATCH MESSAGE FOR THE PROCESS (0.9.16) — the last unbounded per-cycle allocation
# ============================================================================================
# ⛔ THE DEFECT: `dh_setu_poll_event` called `setu_msg_new()` — an 80-byte `alloc` — **before it knew
# whether anything was pending**, so an idle desktop paid 80 B for every poll that found nothing, into
# a bump allocator with no `free()`. crab's event loop polls once per iteration and waits on
# `sys_pause` when idle, so the cost tracked wakeups; anything that repaints without input tracks the
# repaint rate, and at 60 Hz that is ~4.8 KB/s of permanent growth forever.
#
# ⭐ IT WAS THE LAST ONE. crab's frame went to zero bytes across 0.9.13–0.9.15; this is the other half
# of the render/input loop, and with it the whole loop allocates nothing in steady state. That is what
# makes a self-repainting element — an idle animation, a transfer progress bar, an index counter —
# affordable rather than a slow leak.
#
# ⇒ The message is PURE SCRATCH: `setu_client_poll_input` fills it and `dh_setu_map_input` reads it to
# build a **separate** `DhEvent`. Nothing retains it past the call, so one per process is enough.
# ⚠ NOT ON THE FRAME ARENA, AND THIS IS THE TRAP WORTH NAMING. The obvious move — route it through
# `dh_falloc` — is WRONG: polling happens in the event loop, `dh_frame_begin` rewinds the arena inside
# the caller's render, and the scratch would be freed out from under a loop that is still using it.
# Per-frame and per-poll are different lifetimes. It stays on the global allocator, allocated once.
# ⚠ IT IS ZEROED ON EVERY HAND-OUT rather than merely reused — and that is UNEXERCISED DEFENCE, stated
# rather than implied. `setu_decode` writes only the args a kind actually carries, so a reused buffer
# keeps the previous frame's tail. Nothing can observe it: `dh_setu_map_input` maps `SETU_CLOSE` with a
# literal `a = 0`, and every kind that reads an arg has it guaranteed by `setu_decode`'s argc-vs-kind
# check. **Deleting the zeroing does not fail `poll_test` — measured, not assumed.** It is kept because
# it removes a dependency on setu's argc validation staying correct, at a cost of ten stores; if that
# validation is ever relaxed, this is what stops a stale tail becoming a wrong event.
var _dh_msg_scratch = 0;

# @public — the toolkit's per-process scratch `SetuMsg`, zeroed and ready. Allocated on first use.
# Valid only until the next call: it is one buffer, and every caller here consumes it immediately.
fn dh_setu_msg_scratch(): i64 {
    if (_dh_msg_scratch == 0) {
        _dh_msg_scratch = setu_msg_new();
        return _dh_msg_scratch;
    }
    var m = _dh_msg_scratch;
    if (m == 0) { return 0; }
    store64(m + SETU_MSG_KIND, 0);
    store64(m + SETU_MSG_ARGC, 0);
    var i = 0;
    while (i < SETU_MAX_ARGS) {
        store64(m + SETU_MSG_ARGS + i * 8, 0);
        i = i + 1;
    }
    return m;
}

# Read one setu frame off `fd` (exact framing) and map it to a DhEvent. Returns
# the DhEvent (*DhEvent, > 0), 0 on a non-input frame, or -6 on EOF / recv error.
# The seam the compositor-fd loop in dh_run will pump.
fn dh_setu_read_event(fd): i64 {
    var m = dh_setu_msg_scratch();          # 0.9.16 — one per process, not one per call
    if (m == 0) { return 0 - 6; }
    if (dh_setu_read_msg(fd, m) < 0) { return 0 - 6; }
    return dh_setu_map_input(m);
}

# @public — NON-BLOCKING sibling of `dh_setu_read_event`. -> a *DhEvent (> 0), 0 when nothing is
# pending, or -6 on EOF.
#
# ⭐⭐ WHY THE TOOLKIT OWES BOTH SHAPES. `dh_setu_read_event` BLOCKS: it waits for a frame. That is
# right for an app whose display only changes when input arrives, and wrong for one that redraws on
# its own — a file manager repainting a selection, a terminal draining a pty. Offering only the
# blocking read forced every such consumer to reach past the toolkit to setu, which is exactly how
# crab ended up with a hand-rolled input loop while using dhancha for pixels.
#
# ⛔ IT WRAPS `setu_client_poll_input`, NOT `setu_poll_input`, AND THAT IS A BUG FIX, NOT A DETAIL.
# setu's own header on the latter: it "decodes only the FIRST frame of each recv; coalesced or split
# frames are dropped ... kept for API compat", and dropping a coalesced tail LOSES KEY-RELEASE
# EVENTS, which sticks keys for FULL_KEYS consumers. The reassembling call buffers the remainder in
# the client and hands out one frame per call. Any consumer moving off a hand-rolled
# `setu_poll_input` loop onto this gains that fix by adopting.
#
# ⚠ A NON-INPUT FRAME IS CONSUMED AND THE POLL CONTINUES, rather than returning 0. Returning 0 there
# would read as "nothing pending" and stop a caller's drain loop early, stranding frames that were
# already buffered — the same class of dropped-tail defect this wraps around.
fn dh_setu_poll_event(c): i64 {
    # ⚠ HOISTED (0.9.16). This was `setu_msg_new()` — 80 B allocated before the poll knew whether
    # anything was pending. See the ⛔ block above `_dh_msg_scratch`.
    var m = dh_setu_msg_scratch();
    if (m == 0) { return 0 - 6; }
    var spinning = 1;
    while (spinning == 1) {
        var r = setu_client_poll_input(c, m);
        if (r == 0) { return 0; }          # nothing pending
        if (r < 0) { return r; }           # -6 EOF
        var ev = dh_setu_map_input(m);
        if (ev != 0) { return ev; }        # an input frame -> hand it over
        # a consumed non-input frame: keep draining
    }
    return 0;
}

# --- dh_client.cyr ---

# dhancha — DhClient: the app-facing setu binding ("each app owns its
# connection"). A THIN layer over setu's reference client (a *DhClient IS a
# *SetuClient — identical {fd@0, sid@8} layout) plus dhancha's toolkit semantics:
# render a widget surface -> pixels -> present, and read a setu frame -> DhEvent.
#
# setu OWNS the transport now (connect / persistent present / recv / close — the
# dedup after the client was promoted into setu, agnosticos
# native-display-protocol.md). This file no longer re-implements CREATE / ATTACH
# / COMMIT or the connection struct; it delegates to setu_client_* and adds only
# dh_surface_render (setu_client.cyr's dh_setu_* stay for the standalone probes).
# Include alongside src/lib.cyr + src/setu_client.cyr + src/setu_input.cyr.

# Connect to the compositor's setu socket at `path`. Returns a *DhClient (== a
# *SetuClient), or 0 on failure.
fn dh_client_connect(path): i64 { return setu_client_connect(path); }

fn dh_client_fd(c): i64  { return setu_client_fd(c); }
fn dh_client_sid(c): i64 { return setu_client_sid(c); }

# Render `surf` (via `font`, may be 0) and present it over the client's
# connection. setu_client_present creates the surface once on the first present
# (CREATE_SURFACE -> SURFACE_CREATED, storing the id) and sends ATTACH + pixels +
# COMMIT every time. Returns 0, -40 on a render failure, or setu_client_present's
# negative code (-41 create / -6 recv / -8 unexpected reply / -42 attach /
# -43 pixel write / -44 commit).
fn dh_client_present(c, surf, font): i64 {
    var sds = dh_surface_render(surf, font);
    if (sds == 0) { return 0 - 40; }
    return setu_client_present(c, sd_surface_pixels(sds), sd_surface_width(sds), sd_surface_height(sds));
}

# Read the next input event off the client's connection as a DhEvent (*DhEvent,
# > 0), 0 on a non-input frame, or -6 on EOF. (dh_setu_read_event lives in
# setu_input.cyr — it reads one setu frame via setu's framing + maps it.)
fn dh_client_next_event(c): i64 { return dh_setu_read_event(setu_client_fd(c)); }

# @public — NON-BLOCKING event read. -> *DhEvent (> 0), 0 when nothing is pending, -6 on EOF.
# ⚠ The pair matters: `dh_client_next_event` BLOCKS until a frame arrives, which suits an app that
# only changes when input does. An app that redraws on its own — a file manager, a terminal — must
# poll or its render loop stalls on an idle connection. Call this in a loop until it returns 0 to
# drain everything buffered, then draw once.
fn dh_client_poll_event(c): i64 { return dh_setu_poll_event(c); }

fn dh_client_close(c): i64 { return setu_client_close(c); }
