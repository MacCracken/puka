# puka.cyr -- bundled distribution
# Version: 0.6.17
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- parser.cyr ---

# parser.cyr — puka VT/escape-sequence parser.
#
# A faithful implementation of the Paul Williams DEC ANSI parser state
# machine (https://vt100.net/emu/dec_ansi_parser). PURE by design: it does
# no I/O, no rendering, and no hot-path allocation. Bytes go in via
# vt_feed(); a single consumer-visible EVENT comes out (the return value),
# with operands exposed through accessor functions. The terminal driver
# (terminal.cyr) switches on the event and mutates the grid;
# the parser never touches the grid itself. This keeps the untrusted-input
# boundary in one auditable place.
#
# Per-byte contract: vt_feed(b) advances the machine by one byte and returns
# at most one event. Operands for that event (final byte, params, prefix,
# intermediates, OSC string) are valid in the parser's module-global state
# *until the next vt_feed call* — the single-threaded read-before-next idiom.
#
# UTF-8 / 8-bit C1: this parser treats bytes >= 0x80 as printable (the next
# bite layers a UTF-8 decoder over the PRINT stream). It deliberately does
# NOT honor 8-bit C1 controls (0x80-0x9F) — in a UTF-8 terminal those are
# continuation bytes, so all C1 functions arrive 7-bit via ESC. This is the
# correct choice for a modern UTF-8 terminal.
#
# Scope (M1): GROUND / ESCAPE / CSI / OSC fully implemented. DCS and
# SOS/PM/APC strings are consumed and discarded (VT_STR_IGN) — full DCS
# passthrough (hook/put/unhook events) is deferred to M6 per the roadmap.

# ---- States (Williams) -------------------------------------------------
enum VtState {
    VT_GROUND    = 0;
    VT_ESCAPE    = 1;
    VT_ESC_INTER = 2;   # ESCAPE intermediate
    VT_CSI_ENTRY = 3;
    VT_CSI_PARAM = 4;
    VT_CSI_INTER = 5;
    VT_CSI_IGNORE = 6;
    VT_OSC       = 7;   # OSC string (emits VTE_OSC on terminator)
    VT_STR_IGN   = 8;   # DCS / SOS / PM / APC — consumed, discarded (M6)
}

# ---- Events (return value of vt_feed) ----------------------------------
enum VtEvent {
    VTE_NONE    = 0;   # bookkeeping byte — nothing for the consumer to do
    VTE_PRINT   = 1;   # printable: vt_event_char() = byte (codepoint after UTF-8 bite)
    VTE_EXECUTE = 2;   # C0 control: vt_event_char() = control byte
    VTE_CSI     = 3;   # CSI dispatch: char=final byte; prefix/params/intermediates valid
    VTE_ESC     = 4;   # ESC dispatch: char=final byte; intermediates valid
    VTE_OSC     = 5;   # OSC terminated: string in vt_string_ptr()/vt_string_len()
}

# ---- Limits ------------------------------------------------------------
enum VtLimits {
    VT_PARAM_MAX   = 16;     # max CSI parameters
    VT_INTER_MAX   = 2;      # max intermediate bytes
    VT_STR_CAP     = 512;    # OSC string capacity in BYTES
    VT_PARAM_CLAMP = 65535;  # per-parameter ceiling (overflow guard)
}

# ---- State (module-global; single-threaded by design) ------------------
# Reminder (genesis CLAUDE): a module-global `var X[N]` reserves N*u64.
#   vt_params[16] = 16 i64 slots (128 bytes), element i at &vt_params + i*8.
#   vt_inter[2]   = 2 i64 slots.
#   vt_str_buf[64] = 64*8 = 512 bytes — matches VT_STR_CAP; bytes via store8.
var vt_state = 0;
var vt_nparams = 0;     # index of the current (last) param slot, 0-based
var vt_have_param = 0;  # 1 if any digit/separator seen this sequence
var vt_params[16];
var vt_ninter = 0;
var vt_inter[2];
var vt_pfx = 0;         # CSI private-marker byte (0x3C-0x3F), else 0
var vt_evch = 0;        # event char/byte for the last vt_feed
var vt_str_len = 0;
var vt_str_buf[64];

# ---- Internal actions --------------------------------------------------

# CLEAR: reset params, intermediates, and the private marker. Run on entry
# to a fresh control sequence (ESC, CSI_ENTRY).
fn vt__clear(): i64 {
    vt_nparams = 0;
    vt_have_param = 0;
    vt_ninter = 0;
    vt_pfx = 0;
    for (var i = 0; i < VT_PARAM_MAX; i = i + 1) {
        store64(&vt_params + i * 8, 0);
    }
    return 0;
}

# PARAM: fold a decimal digit into the current parameter slot.
fn vt__param_digit(d): i64 {
    if (vt_nparams >= VT_PARAM_MAX) { return 0; }   # overflow: drop extra digits
    var off = vt_nparams * 8;
    var cur = load64(&vt_params + off) * 10 + d;
    if (cur > VT_PARAM_CLAMP) { cur = VT_PARAM_CLAMP; }
    store64(&vt_params + off, cur);
    vt_have_param = 1;
    return 0;
}

# PARAM separator (';' and, flattened, ':'): advance to the next slot.
# NOTE: ':' sub-parameters are flattened into the same flat list in M1 —
# enough to *read* SGR truecolor (38:2:r:g:b becomes separate params);
# preserving ';' vs ':' grouping is a later refinement.
fn vt__param_next(): i64 {
    vt_have_param = 1;
    if (vt_nparams + 1 < VT_PARAM_MAX) {
        vt_nparams = vt_nparams + 1;
        store64(&vt_params + vt_nparams * 8, 0);
    }
    return 0;
}

# COLLECT: store an intermediate byte (0x20-0x2F).
fn vt__collect(b): i64 {
    if (vt_ninter < VT_INTER_MAX) {
        store64(&vt_inter + vt_ninter * 8, b);
        vt_ninter = vt_ninter + 1;
    }
    return 0;
}

fn vt__str_reset(): i64 { vt_str_len = 0; return 0; }

fn vt__str_push(b): i64 {
    if (vt_str_len < VT_STR_CAP) {
        store8(&vt_str_buf + vt_str_len, b);
        vt_str_len = vt_str_len + 1;
    }
    return 0;
}

# C0 controls that EXECUTE: 0x00-0x17, 0x19, 0x1C-0x1F. CAN(0x18),
# SUB(0x1A), ESC(0x1B) are handled separately (sequence abort / escape).
fn vt__is_c0(b): i64 {
    if (b <= 0x17) { return 1; }
    if (b == 0x19) { return 1; }
    if (b >= 0x1c) {
        if (b <= 0x1f) { return 1; }
    }
    return 0;
}

# ---- Public accessors --------------------------------------------------

fn vt_event_char(): i64 { return vt_evch; }

# Number of parameters present (0 = none given → consumer uses defaults).
fn vt_param_count(): i64 {
    if (vt_have_param == 1) { return vt_nparams + 1; }
    return 0;
}

# Raw value of parameter i (0 if absent).
fn vt_param(i): i64 {
    if (i < 0) { return 0; }
    if (i >= VT_PARAM_MAX) { return 0; }
    return load64(&vt_params + i * 8);
}

# Parameter i with VT default-substitution: an omitted OR explicit-zero
# parameter yields `dflt`. Correct for cursor/erase verbs (CSI 0 A == CSI A).
# SGR must read vt_param() directly — for SGR an explicit 0 means "reset".
fn vt_param_or(i, dflt): i64 {
    if (i >= vt_param_count()) { return dflt; }
    var v = vt_param(i);
    if (v == 0) { return dflt; }
    return v;
}

fn vt_inter_count(): i64 { return vt_ninter; }

fn vt_intermediate(i): i64 {
    if (i < 0) { return 0; }
    if (i >= vt_ninter) { return 0; }
    return load64(&vt_inter + i * 8);
}

# CSI private-marker byte (e.g. '?' in CSI ?25h), or 0 if none.
fn vt_prefix(): i64 { return vt_pfx; }

fn vt_string_ptr(): i64 { return &vt_str_buf; }
fn vt_string_len(): i64 { return vt_str_len; }

fn vt_get_state(): i64 { return vt_state; }

# ---- Lifecycle ---------------------------------------------------------

fn vt_reset(): i64 {
    vt_state = VT_GROUND;
    vt__str_reset();
    vt__clear();
    return 0;
}

fn vt_init(): i64 { return vt_reset(); }

# ---- The machine -------------------------------------------------------
# Feed one byte. Returns one VtEvent (VTE_NONE for pure bookkeeping).
fn vt_feed(b): i64 {
    vt_evch = 0;
    b = b & 255;

    # ---- anywhere transitions: ESC, CAN, SUB ----
    # These abort whatever sequence is in flight. Leaving an OSC string
    # fires its end event (the Williams state-exit action).
    if (b == 0x1b) {
        var eesc = VTE_NONE;
        if (vt_state == VT_OSC) { eesc = VTE_OSC; vt_evch = vt_str_len; }
        vt_state = VT_ESCAPE;
        vt__clear();
        return eesc;
    }
    if (b == 0x18) {
        var ecan = VTE_NONE;
        if (vt_state == VT_OSC) { ecan = VTE_OSC; vt_evch = vt_str_len; }
        vt_state = VT_GROUND;
        return ecan;
    }
    if (b == 0x1a) {
        var esub = VTE_NONE;
        if (vt_state == VT_OSC) { esub = VTE_OSC; vt_evch = vt_str_len; }
        vt_state = VT_GROUND;
        return esub;
    }

    # ---- GROUND ----
    if (vt_state == VT_GROUND) {
        if (vt__is_c0(b) == 1) { vt_evch = b; return VTE_EXECUTE; }
        if (b == 0x7f) { return VTE_NONE; }              # DEL ignored in ground
        vt_evch = b;                                     # 0x20-0x7E and 0x80+ (UTF-8)
        return VTE_PRINT;
    }

    # ---- ESCAPE ----
    if (vt_state == VT_ESCAPE) {
        if (vt__is_c0(b) == 1) { vt_evch = b; return VTE_EXECUTE; }
        if (b == 0x7f) { return VTE_NONE; }
        if (b == 0x5b) { vt_state = VT_CSI_ENTRY; vt__clear(); return VTE_NONE; }   # '[' CSI
        if (b == 0x5d) { vt_state = VT_OSC; vt__str_reset(); return VTE_NONE; }     # ']' OSC
        if (b == 0x50) { vt_state = VT_STR_IGN; return VTE_NONE; }                  # 'P' DCS (M6)
        if (b == 0x58) { vt_state = VT_STR_IGN; return VTE_NONE; }                  # 'X' SOS
        if (b == 0x5e) { vt_state = VT_STR_IGN; return VTE_NONE; }                  # '^' PM
        if (b == 0x5f) { vt_state = VT_STR_IGN; return VTE_NONE; }                  # '_' APC
        if (b >= 0x20) {
            if (b <= 0x2f) { vt__collect(b); vt_state = VT_ESC_INTER; return VTE_NONE; }
        }
        if (b >= 0x30) {
            if (b <= 0x7e) { vt_evch = b; vt_state = VT_GROUND; return VTE_ESC; }
        }
        vt_state = VT_GROUND;                            # 0x80+ in escape: abort
        return VTE_NONE;
    }

    # ---- ESCAPE intermediate ----
    if (vt_state == VT_ESC_INTER) {
        if (vt__is_c0(b) == 1) { vt_evch = b; return VTE_EXECUTE; }
        if (b == 0x7f) { return VTE_NONE; }
        if (b >= 0x20) {
            if (b <= 0x2f) { vt__collect(b); return VTE_NONE; }
        }
        if (b >= 0x30) {
            if (b <= 0x7e) { vt_evch = b; vt_state = VT_GROUND; return VTE_ESC; }
        }
        vt_state = VT_GROUND;
        return VTE_NONE;
    }

    # ---- CSI entry ----
    if (vt_state == VT_CSI_ENTRY) {
        if (vt__is_c0(b) == 1) { vt_evch = b; return VTE_EXECUTE; }
        if (b == 0x7f) { return VTE_NONE; }
        if (b >= 0x30) {
            if (b <= 0x39) { vt__param_digit(b - 0x30); vt_state = VT_CSI_PARAM; return VTE_NONE; }
        }
        if (b == 0x3b) { vt__param_next(); vt_state = VT_CSI_PARAM; return VTE_NONE; }   # ';'
        if (b == 0x3a) { vt__param_next(); vt_state = VT_CSI_PARAM; return VTE_NONE; }   # ':'
        if (b >= 0x3c) {
            if (b <= 0x3f) { vt_pfx = b; vt_state = VT_CSI_PARAM; return VTE_NONE; }     # private marker
        }
        if (b >= 0x20) {
            if (b <= 0x2f) { vt__collect(b); vt_state = VT_CSI_INTER; return VTE_NONE; }
        }
        if (b >= 0x40) {
            if (b <= 0x7e) { vt_evch = b; vt_state = VT_GROUND; return VTE_CSI; }
        }
        vt_state = VT_GROUND;
        return VTE_NONE;
    }

    # ---- CSI param ----
    if (vt_state == VT_CSI_PARAM) {
        if (vt__is_c0(b) == 1) { vt_evch = b; return VTE_EXECUTE; }
        if (b == 0x7f) { return VTE_NONE; }
        if (b >= 0x30) {
            if (b <= 0x39) { vt__param_digit(b - 0x30); return VTE_NONE; }
        }
        if (b == 0x3b) { vt__param_next(); return VTE_NONE; }
        if (b == 0x3a) { vt__param_next(); return VTE_NONE; }
        if (b >= 0x3c) {
            if (b <= 0x3f) { vt_state = VT_CSI_IGNORE; return VTE_NONE; }   # marker mid-param → ignore
        }
        if (b >= 0x20) {
            if (b <= 0x2f) { vt__collect(b); vt_state = VT_CSI_INTER; return VTE_NONE; }
        }
        if (b >= 0x40) {
            if (b <= 0x7e) { vt_evch = b; vt_state = VT_GROUND; return VTE_CSI; }
        }
        vt_state = VT_GROUND;
        return VTE_NONE;
    }

    # ---- CSI intermediate ----
    if (vt_state == VT_CSI_INTER) {
        if (vt__is_c0(b) == 1) { vt_evch = b; return VTE_EXECUTE; }
        if (b == 0x7f) { return VTE_NONE; }
        if (b >= 0x20) {
            if (b <= 0x2f) { vt__collect(b); return VTE_NONE; }
        }
        if (b >= 0x40) {
            if (b <= 0x7e) { vt_evch = b; vt_state = VT_GROUND; return VTE_CSI; }
        }
        if (b >= 0x30) {
            if (b <= 0x3f) { vt_state = VT_CSI_IGNORE; return VTE_NONE; }   # param after inter → ignore
        }
        vt_state = VT_GROUND;
        return VTE_NONE;
    }

    # ---- CSI ignore ----
    if (vt_state == VT_CSI_IGNORE) {
        if (vt__is_c0(b) == 1) { vt_evch = b; return VTE_EXECUTE; }
        if (b >= 0x40) {
            if (b <= 0x7e) { vt_state = VT_GROUND; return VTE_NONE; }       # consume final, no dispatch
        }
        return VTE_NONE;
    }

    # ---- OSC string ----
    if (vt_state == VT_OSC) {
        if (b == 0x07) { vt_state = VT_GROUND; vt_evch = vt_str_len; return VTE_OSC; }  # BEL terminator
        if (b >= 0x20) { vt__str_push(b); return VTE_NONE; }                            # collect content
        return VTE_NONE;                                                                # stray control: ignore
    }

    # ---- DCS / SOS / PM / APC (consumed, discarded — M6) ----
    if (vt_state == VT_STR_IGN) {
        return VTE_NONE;   # terminated by ESC/CAN/SUB in the anywhere block above
    }

    return VTE_NONE;
}

# --- grid.cyr ---

# grid.cyr — puka cell grid: the terminal screen model.
#
# THE single source of truth for the visible screen (architecture invariant).
# terminal.cyr is the only writer — it translates parser events into the
# primitives here; the renderer is a pure read of this state.
#
# A cell is two packed i64 words behind accessors (callers never see the
# packing):
#   glyph word: codepoint (bits 0..31) | attrs (bits 32..47)
#   color word: fg (bits 0..31)        | bg (bits 32..63)
# fg/bg are opaque to the grid — terminal.cyr's SGR decides their meaning
# (see the color encoding it defines). The grid only stores and returns them.
#
# Scope (M1): visible screen only. Scrollback ring is M6 (roadmap), so rows
# that scroll off the top are discarded here.
#
# Coordinates are 0-based (row, col). VT's 1-based params are converted by
# terminal.cyr before calling in.

enum GridDim {
    GRID_MAX_COLS = 480;   # 3840 px / 8 px-cell = 4K width (was 132 = DECCOLM)
    GRID_MAX_ROWS = 144;   # 2304 px / 16 px-cell ≥ 4K height (was 64; 1080p is 67)
    GRID_DIRTY_WORDS = 3;  # ⌈144/64⌉ — per-row damage bitset spans this many u64
    SCROLLBACK_LINES = 1000; # primary-screen history ring depth (heap, lazily allocated)
}

# SGR attribute flag bits (stored in the glyph word's high half).
enum GridAttr {
    ATTR_BOLD      = 1;
    ATTR_DIM       = 2;
    ATTR_ITALIC    = 4;
    ATTR_UNDERLINE = 8;
    ATTR_BLINK     = 16;
    ATTR_REVERSE   = 32;
    ATTR_HIDDEN    = 64;
    ATTR_STRIKE    = 128;
}

# Backing store. Module-global => GRID_MAX_COLS*GRID_MAX_ROWS u64 each
# (480*144 = 69120 cells -> ~540KB per word array). Index = row*GRID_MAX_COLS + col.
var grid_g[69120];  # glyph|attr words
var grid_c[69120];  # fg|bg words
var grid_tabs[480]; # tab-stop flags, one byte per column (store8)

var grid_rows = 0;
var grid_cols = 0;
var grid_cur_row = 0;
var grid_cur_col = 0;
var grid_scroll_top = 0;   # scroll region top row (inclusive)
var grid_scroll_bot = 0;   # scroll region bottom row (inclusive)
var grid_pen_attr = 0;     # current SGR pen — applied to printed + erased cells
var grid_pen_fg = 0;       # 0 = default color
var grid_pen_bg = 0;

# Per-row damage bitset — GRID_DIRTY_WORDS u64 (bit r = row r dirty; word r/64,
# bit r%64). The grid is the single writer, so it marks rows dirty at the write
# sites; the renderer (render/fb.cyr) is a pure read that consumes + clears these
# bits each frame so it only repaints rows that changed. Single-threaded:
# pump -> mutate+mark -> render reads/paints/clears, no lock, no torn read.
var grid_dirty_rows[3];   # GRID_DIRTY_WORDS

# ---- internal cell ops -------------------------------------------------

fn grid__idx(r, c): i64 { return r * GRID_MAX_COLS + c; }

# Mark row r dirty (renderer repaints it next frame). Bounds-guarded against
# the full backing height so a stray row never corrupts the bitset.
fn grid__mark_row(r): i64 {
    if (r < 0) { return 0; }
    if (r >= GRID_MAX_ROWS) { return 0; }
    var w = r / 64;
    var bit = r % 64;
    store64(&grid_dirty_rows + w * 8, load64(&grid_dirty_rows + w * 8) | (1 << bit));
    return 0;
}

fn grid_set_cell(r, c, glyph, attr, fg, bg): i64 {
    if (r < 0) { return 0; }
    if (r >= grid_rows) { return 0; }
    if (c < 0) { return 0; }
    if (c >= grid_cols) { return 0; }
    var idx = grid__idx(r, c);
    var gw = (glyph & 0xFFFFFFFF) | (attr << 32);
    var cw = (fg & 0xFFFFFFFF) | (bg << 32);
    store64(&grid_g + idx * 8, gw);
    store64(&grid_c + idx * 8, cw);
    grid__mark_row(r);
    return 0;
}

fn grid_glyph(r, c): i64 {
    if (r < 0) { return 0x20; }
    if (r >= grid_rows) { return 0x20; }
    if (c < 0) { return 0x20; }
    if (c >= grid_cols) { return 0x20; }
    return load64(&grid_g + grid__idx(r, c) * 8) & 0xFFFFFFFF;
}

fn grid_attr(r, c): i64 {
    if (r < 0) { return 0; }
    if (r >= grid_rows) { return 0; }
    if (c < 0) { return 0; }
    if (c >= grid_cols) { return 0; }
    return (load64(&grid_g + grid__idx(r, c) * 8) >> 32) & 0xFFFF;
}

fn grid_fg(r, c): i64 {
    if (r < 0) { return 0; }
    if (r >= grid_rows) { return 0; }
    if (c < 0) { return 0; }
    if (c >= grid_cols) { return 0; }
    return load64(&grid_c + grid__idx(r, c) * 8) & 0xFFFFFFFF;
}

fn grid_bg(r, c): i64 {
    if (r < 0) { return 0; }
    if (r >= grid_rows) { return 0; }
    if (c < 0) { return 0; }
    if (c >= grid_cols) { return 0; }
    return (load64(&grid_c + grid__idx(r, c) * 8) >> 32) & 0xFFFFFFFF;
}

# Blank a cell: space glyph, no attrs, default fg, current pen bg (bce —
# erased cells take the current background color).
fn grid_blank(r, c): i64 {
    return grid_set_cell(r, c, 0x20, 0, 0, grid_pen_bg);
}

fn grid__copy_row(src, dst): i64 {
    var bs = src * GRID_MAX_COLS;
    var bd = dst * GRID_MAX_COLS;
    for (var c = 0; c < grid_cols; c = c + 1) {
        store64(&grid_g + (bd + c) * 8, load64(&grid_g + (bs + c) * 8));
        store64(&grid_c + (bd + c) * 8, load64(&grid_c + (bs + c) * 8));
    }
    grid__mark_row(dst);
    return 0;
}

fn grid__blank_row(r): i64 {
    for (var c = 0; c < grid_cols; c = c + 1) { grid_blank(r, c); }
    return 0;
}

# ---- pen ---------------------------------------------------------------

fn grid_set_pen(attr, fg, bg): i64 {
    grid_pen_attr = attr;
    grid_pen_fg = fg;
    grid_pen_bg = bg;
    return 0;
}
fn grid_pen_attr_get(): i64 { return grid_pen_attr; }
fn grid_pen_fg_get(): i64 { return grid_pen_fg; }
fn grid_pen_bg_get(): i64 { return grid_pen_bg; }

# Write a glyph at (r,c) using the current pen attrs/colors.
fn grid_put_cell(r, c, glyph): i64 {
    return grid_set_cell(r, c, glyph, grid_pen_attr, grid_pen_fg, grid_pen_bg);
}

# ---- cursor ------------------------------------------------------------

fn grid_cursor_set(r, c): i64 {
    if (r < 0) { r = 0; }
    if (r >= grid_rows) { r = grid_rows - 1; }
    if (c < 0) { c = 0; }
    if (c >= grid_cols) { c = grid_cols - 1; }
    grid__mark_row(grid_cur_row);   # old row repaints — clears the block it held
    grid_cur_row = r;
    grid_cur_col = c;
    grid__mark_row(r);              # new row repaints — draws the block
    return 0;
}
fn grid_cursor_row(): i64 { return grid_cur_row; }
fn grid_cursor_col(): i64 { return grid_cur_col; }
fn grid_get_rows(): i64 { return grid_rows; }
fn grid_get_cols(): i64 { return grid_cols; }

# ---- scroll region -----------------------------------------------------

fn grid_set_scroll(top, bot): i64 {
    if (top < 0) { top = 0; }
    if (bot >= grid_rows) { bot = grid_rows - 1; }
    if (top >= bot) { return 0; }       # invalid region: ignore (VT keeps prior)
    grid_scroll_top = top;
    grid_scroll_bot = bot;
    return 0;
}
fn grid_scroll_top_get(): i64 { return grid_scroll_top; }
fn grid_scroll_bot_get(): i64 { return grid_scroll_bot; }

# Scroll an arbitrary sub-region [top,bot] up by n lines: content rises,
# bottom n rows blank. Lines scrolled off the top are discarded (no
# scrollback in M1). This is the primitive; the verbs below specialize it.
fn grid_scroll_up_in(top, bot, n): i64 {
    if (n <= 0) { return 0; }
    if (top < 0) { top = 0; }
    if (bot >= grid_rows) { bot = grid_rows - 1; }
    if (top > bot) { return 0; }
    var span = bot - top + 1;
    if (n > span) { n = span; }
    var r = top;
    while (r + n <= bot) {
        grid__copy_row(r + n, r);
        r = r + 1;
    }
    var rb = bot - n + 1;
    while (rb <= bot) {
        grid__blank_row(rb);
        rb = rb + 1;
    }
    return 0;
}

# Scroll an arbitrary sub-region [top,bot] down by n lines: content
# descends, top n rows blank.
fn grid_scroll_down_in(top, bot, n): i64 {
    if (n <= 0) { return 0; }
    if (top < 0) { top = 0; }
    if (bot >= grid_rows) { bot = grid_rows - 1; }
    if (top > bot) { return 0; }
    var span = bot - top + 1;
    if (n > span) { n = span; }
    var r = bot;
    while (r >= top + n) {
        grid__copy_row(r - n, r);
        r = r - 1;
    }
    var rt = top;
    while (rt < top + n) {
        grid__blank_row(rt);
        rt = rt + 1;
    }
    return 0;
}

# Scroll the active scroll-region up / down (SU/SD, LF/RI at the margin).
fn grid_scroll_up(n): i64 {
    # Capture lines leaving the TOP of the screen into scrollback — only when the
    # region starts at row 0 (real screen top) and we're on the primary screen.
    if (grid_scroll_top == 0) { if (grid_alt_active == 0) {
        var cap = grid_scroll_bot + 1;               # lines available above the bottom margin
        var k = n;
        if (k > cap) { k = cap; }
        var i = 0;
        while (i < k) { grid__sb_push(i); i = i + 1; }
    } }
    return grid_scroll_up_in(grid_scroll_top, grid_scroll_bot, n);
}
fn grid_scroll_down(n): i64 {
    return grid_scroll_down_in(grid_scroll_top, grid_scroll_bot, n);
}

# ---- erase -------------------------------------------------------------

# Erase cols [c0, c1] inclusive on row r (to blank cells).
fn grid_erase_cells(r, c0, c1): i64 {
    if (c0 < 0) { c0 = 0; }
    if (c1 >= grid_cols) { c1 = grid_cols - 1; }
    var c = c0;
    while (c <= c1) {
        grid_blank(r, c);
        c = c + 1;
    }
    return 0;
}

# Erase whole rows [r0, r1] inclusive.
fn grid_erase_rows(r0, r1): i64 {
    var r = r0;
    while (r <= r1) {
        grid__blank_row(r);
        r = r + 1;
    }
    return 0;
}

# Insert n blank cells at (r,c): cells from c rightward shift right by n,
# cells pushed past the right margin are lost (ICH).
fn grid_insert_cells(r, c, n): i64 {
    if (n <= 0) { return 0; }
    if (c < 0) { return 0; }
    if (c >= grid_cols) { return 0; }
    if (n > grid_cols - c) { n = grid_cols - c; }
    var base = r * GRID_MAX_COLS;
    var dst = grid_cols - 1;
    while (dst >= c + n) {
        store64(&grid_g + (base + dst) * 8, load64(&grid_g + (base + dst - n) * 8));
        store64(&grid_c + (base + dst) * 8, load64(&grid_c + (base + dst - n) * 8));
        dst = dst - 1;
    }
    grid__mark_row(r);
    grid_erase_cells(r, c, c + n - 1);
    return 0;
}

# Delete n cells at (r,c): cells from c+n leftward shift to c, the tail is
# blanked (DCH).
fn grid_delete_cells(r, c, n): i64 {
    if (n <= 0) { return 0; }
    if (c < 0) { return 0; }
    if (c >= grid_cols) { return 0; }
    if (n > grid_cols - c) { n = grid_cols - c; }
    var base = r * GRID_MAX_COLS;
    var src = c + n;
    while (src < grid_cols) {
        store64(&grid_g + (base + src - n) * 8, load64(&grid_g + (base + src) * 8));
        store64(&grid_c + (base + src - n) * 8, load64(&grid_c + (base + src) * 8));
        src = src + 1;
    }
    grid__mark_row(r);
    grid_erase_cells(r, grid_cols - n, grid_cols - 1);
    return 0;
}

# ---- damage (per-row dirty bits; consumed by the renderer) -------------

# 1 if row r is dirty (changed since the last clear), else 0.
fn grid_row_dirty(r): i64 {
    if (r < 0) { return 0; }
    if (r >= GRID_MAX_ROWS) { return 0; }
    var w = r / 64;
    var bit = r % 64;
    return (load64(&grid_dirty_rows + w * 8) >> bit) & 1;
}

# Clear row r's dirty bit (the renderer calls this right after painting it).
fn grid_clear_row_dirty(r): i64 {
    if (r < 0) { return 0; }
    if (r >= GRID_MAX_ROWS) { return 0; }
    var w = r / 64;
    var bit = r % 64;
    store64(&grid_dirty_rows + w * 8, load64(&grid_dirty_rows + w * 8) & ((0 - 1) ^ (1 << bit)));
    return 0;
}

# Mark a single row dirty (public). Used by terminal.cyr for state changes
# that alter a row's appearance without writing a cell — e.g. cursor
# show/hide (DECTCEM), which must repaint the cursor's row.
fn grid_mark_row_dirty(r): i64 { return grid__mark_row(r); }

# Mark every active row dirty (forces a full repaint — init / resize).
fn grid_mark_all_dirty(): i64 {
    var r = 0;
    while (r < grid_rows) { grid__mark_row(r); r = r + 1; }
    return 0;
}

# ---- tab stops ---------------------------------------------------------

fn grid_tab_set(col): i64 {
    if (col < 0) { return 0; }
    if (col >= GRID_MAX_COLS) { return 0; }
    store8(&grid_tabs + col, 1);
    return 0;
}
fn grid_tab_clear(col): i64 {
    if (col < 0) { return 0; }
    if (col >= GRID_MAX_COLS) { return 0; }
    store8(&grid_tabs + col, 0);
    return 0;
}
fn grid_tab_clear_all(): i64 {
    for (var c = 0; c < GRID_MAX_COLS; c = c + 1) { store8(&grid_tabs + c, 0); }
    return 0;
}
fn grid_tabs_default(): i64 {
    grid_tab_clear_all();
    var c = 8;
    while (c < GRID_MAX_COLS) {
        store8(&grid_tabs + c, 1);
        c = c + 8;
    }
    return 0;
}
# Next tab stop strictly after `col`, clamped to the last column.
fn grid_next_tab(col): i64 {
    var c = col + 1;
    while (c < grid_cols) {
        if (load8(&grid_tabs + c) == 1) { return c; }
        c = c + 1;
    }
    return grid_cols - 1;
}

# ---- lifecycle ---------------------------------------------------------

fn grid_clear_all(): i64 {
    for (var r = 0; r < grid_rows; r = r + 1) { grid__blank_row(r); }
    return 0;
}

# Resize the logical screen (SIGWINCH / TIOCSWINSZ). The backing store is
# fixed at GRID_MAX_*, so this is a dimension change, not a reallocation:
# newly-exposed cells are blanked, the scroll region resets to full, and the
# cursor is clamped. Content is not reflowed (matches xterm/VT resize).
fn grid_resize(rows, cols): i64 {
    if (rows > GRID_MAX_ROWS) { rows = GRID_MAX_ROWS; }
    if (cols > GRID_MAX_COLS) { cols = GRID_MAX_COLS; }
    if (rows < 1) { rows = 1; }
    if (cols < 1) { cols = 1; }
    var oldr = grid_rows;
    var oldc = grid_cols;
    grid_rows = rows;
    grid_cols = cols;
    if (cols > oldc) {
        var r = 0;
        while (r < oldr) {
            if (r < rows) { grid_erase_cells(r, oldc, cols - 1); }
            r = r + 1;
        }
    }
    if (rows > oldr) {
        var rr = oldr;
        while (rr < rows) { grid__blank_row(rr); rr = rr + 1; }
    }
    grid_scroll_top = 0;
    grid_scroll_bot = rows - 1;
    if (grid_cur_row >= rows) { grid_cur_row = rows - 1; }
    if (grid_cur_col >= cols) { grid_cur_col = cols - 1; }
    grid_mark_all_dirty();   # dimensions changed — the whole frame repaints
    return 0;
}

# ---- alternate screen buffer (DEC 1049 / 1047 / 47) --------------------
# Full-screen apps (vim / less / htop / tmux) draw on a separate buffer so the
# primary screen is restored intact on exit. The inactive screen lives in a
# lazily heap-allocated backup; switching SWAPS active<->backup. Heap, not a
# second static array — costs nothing until alt-screen is first used.
var grid_alt_active = 0;
var grid_alt_g = 0;        # heap backup of the inactive buffer's glyph words
var grid_alt_c = 0;        # heap backup of the inactive buffer's fg|bg words

fn grid_in_alt(): i64 { return grid_alt_active; }

# Switch to (enter=1) / from (enter=0) the alternate screen: swap the active cell
# buffer with the heap backup (preserving the inactive screen), mark all dirty.
# No-op if already in that state. Cursor save + clear-on-enter are the caller's
# job (mode-1049 semantics live in terminal.cyr). Returns 0, or -1 on OOM.
fn grid_alt_screen(enter): i64 {
    if (enter == grid_alt_active) { return 0; }
    var n = GRID_MAX_COLS * GRID_MAX_ROWS;
    if (grid_alt_g == 0) {
        grid_alt_g = alloc(n * 8);
        grid_alt_c = alloc(n * 8);
        if (grid_alt_g == 0) { return 0 - 1; }
        if (grid_alt_c == 0) { return 0 - 1; }
        var z = 0;                                  # alloc may reuse a chunk → zero it
        while (z < n) { store64(grid_alt_g + z * 8, 0); store64(grid_alt_c + z * 8, 0); z = z + 1; }
    }
    var i = 0;
    while (i < n) {
        var tg = load64(&grid_g + i * 8);
        store64(&grid_g + i * 8, load64(grid_alt_g + i * 8));
        store64(grid_alt_g + i * 8, tg);
        var tc = load64(&grid_c + i * 8);
        store64(&grid_c + i * 8, load64(grid_alt_c + i * 8));
        store64(grid_alt_c + i * 8, tc);
        i = i + 1;
    }
    grid_alt_active = enter;
    grid_mark_all_dirty();
    return 0;
}

# ---- scrollback ring + viewport (primary screen only) ------------------
# Lines that scroll off the TOP of the screen (full-screen scroll-up, primary
# screen) are retained in a lazily heap-allocated ring of SCROLLBACK_LINES rows
# (full-width: glyph|attr + fg|bg words per cell, same layout as grid_g/grid_c).
# A viewport offset lets the renderer show history: grid_view_off lines scrolled
# back from the live bottom (0 = live). The alt screen has no scrollback.
var grid_sb_g = 0;          # heap ring of glyph|attr words (SCROLLBACK_LINES * GRID_MAX_COLS)
var grid_sb_c = 0;          # heap ring of fg|bg words
var grid_sb_count = 0;      # lines currently retained (0..SCROLLBACK_LINES)
var grid_sb_head = 0;       # next write slot (ring)
var grid_view_off = 0;      # viewport scrollback offset (0 = live bottom)

# Push live grid row `srcrow` into the ring (called as it scrolls off the top).
fn grid__sb_push(srcrow): i64 {
    if (grid_sb_g == 0) {                            # lazy alloc on first scroll-off
        grid_sb_g = alloc(SCROLLBACK_LINES * GRID_MAX_COLS * 8);
        grid_sb_c = alloc(SCROLLBACK_LINES * GRID_MAX_COLS * 8);
        if (grid_sb_g == 0) { return 0 - 1; }
        if (grid_sb_c == 0) { return 0 - 1; }
    }
    var dbase = grid_sb_head * GRID_MAX_COLS;
    var sbase = srcrow * GRID_MAX_COLS;
    var c = 0;
    while (c < GRID_MAX_COLS) {
        store64(grid_sb_g + (dbase + c) * 8, load64(&grid_g + (sbase + c) * 8));
        store64(grid_sb_c + (dbase + c) * 8, load64(&grid_c + (sbase + c) * 8));
        c = c + 1;
    }
    grid_sb_head = (grid_sb_head + 1) % SCROLLBACK_LINES;
    if (grid_sb_count < SCROLLBACK_LINES) { grid_sb_count = grid_sb_count + 1; }
    # If scrolled back, advance the offset so the view stays anchored on the same
    # history lines as new ones push in below.
    if (grid_view_off > 0) { if (grid_view_off < grid_sb_count) { grid_view_off = grid_view_off + 1; } }
    return 0;
}

# Move the viewport: delta>0 scrolls back into history, <0 toward the live bottom.
fn grid_scroll_view(delta): i64 {
    var no = grid_view_off + delta;
    if (no < 0) { no = 0; }
    if (no > grid_sb_count) { no = grid_sb_count; }
    if (no != grid_view_off) { grid_view_off = no; grid_mark_all_dirty(); }
    return 0;
}
fn grid_view_reset(): i64 {                          # snap to the live bottom (on user input)
    if (grid_view_off != 0) { grid_view_off = 0; grid_mark_all_dirty(); }
    return 0;
}
fn grid_view_off_get(): i64 { return grid_view_off; }
fn grid_sb_count_get(): i64 { return grid_sb_count; }

# Viewport cell access for the renderer: display row vr (0..rows-1) → the raw word
# from scrollback history (if scrolled back) or the live grid. At view_off=0 this
# is exactly the live grid row vr (renderer behaviour unchanged at the bottom).
fn grid__view_gword(vr, c): i64 {
    var idx = grid_sb_count - grid_view_off + vr;    # combined-buffer line index
    if (idx >= grid_sb_count) { return load64(&grid_g + ((idx - grid_sb_count) * GRID_MAX_COLS + c) * 8); }
    var slot = (grid_sb_head - grid_sb_count + idx + SCROLLBACK_LINES) % SCROLLBACK_LINES;
    return load64(grid_sb_g + (slot * GRID_MAX_COLS + c) * 8);
}
fn grid__view_cword(vr, c): i64 {
    var idx = grid_sb_count - grid_view_off + vr;
    if (idx >= grid_sb_count) { return load64(&grid_c + ((idx - grid_sb_count) * GRID_MAX_COLS + c) * 8); }
    var slot = (grid_sb_head - grid_sb_count + idx + SCROLLBACK_LINES) % SCROLLBACK_LINES;
    return load64(grid_sb_c + (slot * GRID_MAX_COLS + c) * 8);
}
fn grid_vglyph(vr, c): i64 { return grid__view_gword(vr, c) & 0xFFFFFFFF; }
fn grid_vattr(vr, c): i64 { return (grid__view_gword(vr, c) >> 32) & 0xFFFF; }
fn grid_vfg(vr, c): i64 { return grid__view_cword(vr, c) & 0xFFFFFFFF; }
fn grid_vbg(vr, c): i64 { return (grid__view_cword(vr, c) >> 32) & 0xFFFFFFFF; }

fn grid_init(rows, cols): i64 {
    grid_alt_active = 0;                             # always boot on the primary screen
    grid_sb_count = 0; grid_sb_head = 0; grid_view_off = 0;   # clear scrollback history
    if (rows > GRID_MAX_ROWS) { rows = GRID_MAX_ROWS; }
    if (cols > GRID_MAX_COLS) { cols = GRID_MAX_COLS; }
    if (rows < 1) { rows = 1; }
    if (cols < 1) { cols = 1; }
    grid_rows = rows;
    grid_cols = cols;
    grid_cur_row = 0;
    grid_cur_col = 0;
    grid_scroll_top = 0;
    grid_scroll_bot = rows - 1;
    grid_pen_attr = 0;
    grid_pen_fg = 0;
    grid_pen_bg = 0;
    var dw = 0;
    while (dw < GRID_DIRTY_WORDS) { store64(&grid_dirty_rows + dw * 8, 0); dw = dw + 1; }
    grid_clear_all();
    grid_tabs_default();
    grid_mark_all_dirty();   # fresh screen — first frame paints everything
    return 0;
}

# --- unicode.cyr ---

# unicode.cyr — UTF-8 decode/encode + character cell width for puka.
#
# The parser (parser.cyr) emits one PRINT event per byte. terminal.cyr feeds
# those bytes here to assemble codepoints, then asks char_width() how many
# cells the codepoint occupies. The renderer uses utf8_encode() to turn grid
# codepoints back into UTF-8 bytes for output.
#
# Sources:
#  - UTF-8: RFC 3629 (well-formed byte sequences; overlong + surrogate +
#    > U+10FFFF rejected -> U+FFFD replacement).
#  - Width: Unicode Standard Annex #11 "East Asian Width" (W/F => 2 cells);
#    combining/zero-width modeled on Markus Kuhn's wcwidth reference
#    (https://www.cl.cam.ac.uk/~mgk25/ucs/wcwidth.c).
#  NOTE (M1 scope): the combining and wide tables here are the high-impact
#  ranges (Latin combining, CJK, Hangul, fullwidth forms, main emoji), not
#  the exhaustive UAX#11 / Mn+Me set. The authoritative full tables should be
#  generated (cf. cyrius `programs/gen_unicode_data.cyr`) and folded in at M6.

enum Utf8Const {
    UTF8_MORE    = 0x7FFFFFFF;   # not a valid codepoint: "need more bytes"
    UC_REPLACE   = 0xFFFD;       # U+FFFD REPLACEMENT CHARACTER (decode error)
    UC_MAX       = 0x10FFFF;     # highest valid Unicode scalar value
}

# Incremental decoder state.
var utf8_cp = 0;     # codepoint accumulator
var utf8_need = 0;   # remaining continuation bytes expected
var utf8_min = 0;    # minimum legal codepoint for this length (overlong guard)

fn utf8_reset(): i64 {
    utf8_cp = 0;
    utf8_need = 0;
    utf8_min = 0;
    return 0;
}

# Feed one byte. Returns a codepoint (0..0x10FFFF), UC_REPLACE on a decode
# error, or UTF8_MORE if more continuation bytes are required.
fn utf8_feed(b): i64 {
    b = b & 255;

    if (utf8_need == 0) {
        # expecting a lead (or single) byte
        if (b < 0x80) { return b; }                       # ASCII
        if (b >= 0xc2) {
            if (b <= 0xdf) { utf8_cp = b & 0x1f; utf8_need = 1; utf8_min = 0x80; return UTF8_MORE; }
        }
        if (b >= 0xe0) {
            if (b <= 0xef) { utf8_cp = b & 0x0f; utf8_need = 2; utf8_min = 0x800; return UTF8_MORE; }
        }
        if (b >= 0xf0) {
            if (b <= 0xf4) { utf8_cp = b & 0x07; utf8_need = 3; utf8_min = 0x10000; return UTF8_MORE; }
        }
        return UC_REPLACE;   # stray continuation (0x80-0xBF), 0xC0/0xC1, 0xF5-0xFF
    }

    # expecting a continuation byte (0x80-0xBF)
    if (b < 0x80) { utf8_reset(); return UC_REPLACE; }     # truncated sequence (offending byte dropped)
    if (b > 0xbf) { utf8_reset(); return UC_REPLACE; }
    utf8_cp = (utf8_cp << 6) | (b & 0x3f);
    utf8_need = utf8_need - 1;
    if (utf8_need > 0) { return UTF8_MORE; }

    # sequence complete — validate
    var cp = utf8_cp;
    var lo = utf8_min;
    utf8_reset();
    if (cp < lo) { return UC_REPLACE; }                    # overlong
    if (cp > UC_MAX) { return UC_REPLACE; }                # beyond Unicode
    if (cp >= 0xd800) {
        if (cp <= 0xdfff) { return UC_REPLACE; }           # UTF-16 surrogate
    }
    return cp;
}

# Encode a codepoint as UTF-8 into buf (byte pointer). Returns bytes written.
# Invalid input is encoded as U+FFFD.
fn utf8_encode(cp, buf): i64 {
    if (cp < 0) { cp = UC_REPLACE; }
    if (cp > UC_MAX) { cp = UC_REPLACE; }
    if (cp >= 0xd800) {
        if (cp <= 0xdfff) { cp = UC_REPLACE; }
    }
    if (cp < 0x80) {
        store8(buf, cp);
        return 1;
    }
    if (cp < 0x800) {
        store8(buf, 0xc0 | (cp >> 6));
        store8(buf + 1, 0x80 | (cp & 0x3f));
        return 2;
    }
    if (cp < 0x10000) {
        store8(buf, 0xe0 | (cp >> 12));
        store8(buf + 1, 0x80 | ((cp >> 6) & 0x3f));
        store8(buf + 2, 0x80 | (cp & 0x3f));
        return 3;
    }
    store8(buf, 0xf0 | (cp >> 18));
    store8(buf + 1, 0x80 | ((cp >> 12) & 0x3f));
    store8(buf + 2, 0x80 | ((cp >> 6) & 0x3f));
    store8(buf + 3, 0x80 | (cp & 0x3f));
    return 4;
}

# ---- width -------------------------------------------------------------

fn uc__in(cp, lo, hi): i64 {
    if (cp < lo) { return 0; }
    if (cp > hi) { return 0; }
    return 1;
}

# Zero-width: combining marks + explicit zero-width / format chars (subset).
fn uc__zero_width(cp): i64 {
    if (cp == 0) { return 1; }                       # NUL
    if (uc__in(cp, 0x0300, 0x036f) == 1) { return 1; }  # combining diacritical
    if (uc__in(cp, 0x0483, 0x0489) == 1) { return 1; }
    if (uc__in(cp, 0x0591, 0x05bd) == 1) { return 1; }
    if (uc__in(cp, 0x0610, 0x061a) == 1) { return 1; }
    if (uc__in(cp, 0x064b, 0x065f) == 1) { return 1; }
    if (uc__in(cp, 0x06d6, 0x06dc) == 1) { return 1; }
    if (uc__in(cp, 0x0e31, 0x0e3a) == 1) { return 1; }  # Thai
    if (uc__in(cp, 0x1ab0, 0x1aff) == 1) { return 1; }  # combining ext
    if (uc__in(cp, 0x1dc0, 0x1dff) == 1) { return 1; }  # combining supplement
    if (uc__in(cp, 0x200b, 0x200f) == 1) { return 1; }  # zero-width space/joiners/marks
    if (uc__in(cp, 0x202a, 0x202e) == 1) { return 1; }  # bidi format
    if (uc__in(cp, 0x2060, 0x2064) == 1) { return 1; }  # word joiner etc.
    if (uc__in(cp, 0xfe00, 0xfe0f) == 1) { return 1; }  # variation selectors
    if (uc__in(cp, 0xfe20, 0xfe2f) == 1) { return 1; }  # combining half marks
    if (cp == 0xfeff) { return 1; }                  # ZWNBSP / BOM
    return 0;
}

# Wide (2 cells): East Asian Wide/Fullwidth + main emoji (subset of UAX#11).
fn uc__wide(cp): i64 {
    if (uc__in(cp, 0x1100, 0x115f) == 1) { return 1; }  # Hangul Jamo
    if (uc__in(cp, 0x2329, 0x232a) == 1) { return 1; }  # angle brackets
    if (uc__in(cp, 0x2e80, 0x303e) == 1) { return 1; }  # CJK radicals .. Kangxi
    if (uc__in(cp, 0x3041, 0x33ff) == 1) { return 1; }  # Hiragana .. CJK compat
    if (uc__in(cp, 0x3400, 0x4dbf) == 1) { return 1; }  # CJK Ext A
    if (uc__in(cp, 0x4e00, 0x9fff) == 1) { return 1; }  # CJK Unified
    if (uc__in(cp, 0xa000, 0xa4cf) == 1) { return 1; }  # Yi
    if (uc__in(cp, 0xac00, 0xd7a3) == 1) { return 1; }  # Hangul syllables
    if (uc__in(cp, 0xf900, 0xfaff) == 1) { return 1; }  # CJK compat ideographs
    if (uc__in(cp, 0xfe10, 0xfe19) == 1) { return 1; }  # vertical forms
    if (uc__in(cp, 0xfe30, 0xfe6f) == 1) { return 1; }  # CJK compat forms
    if (uc__in(cp, 0xff00, 0xff60) == 1) { return 1; }  # fullwidth forms
    if (uc__in(cp, 0xffe0, 0xffe6) == 1) { return 1; }  # fullwidth signs
    if (uc__in(cp, 0x1f300, 0x1faff) == 1) { return 1; } # main emoji blocks
    if (uc__in(cp, 0x1f1e6, 0x1f1ff) == 1) { return 1; } # regional indicators
    if (uc__in(cp, 0x20000, 0x3fffd) == 1) { return 1; } # CJK Ext B+
    return 0;
}

# Display width of a codepoint in cells: 0 (combining/zero-width),
# 2 (East Asian wide / emoji), or 1 (everything else).
fn char_width(cp): i64 {
    if (uc__zero_width(cp) == 1) { return 0; }
    if (uc__wide(cp) == 1) { return 2; }
    return 1;
}

# --- terminal.cyr ---

# terminal.cyr — puka terminal: VT semantics over the grid.
#
# The driver. term_feed(byte) pumps one byte through the parser (parser.cyr),
# switches on the event, and applies the semantics to the grid (grid.cyr).
# Printable bytes are assembled into codepoints via the UTF-8 decoder
# (unicode.cyr) and placed with the correct cell width. This module is the
# ONLY writer of the grid.
#
# Co-compiled with parser.cyr + grid.cyr + unicode.cyr (the consumer — main
# or a test — includes all four; this file includes none, to avoid double
# includes).
#
# Color encoding (terminal owns the meaning; grid stores it opaquely):
#   0                      = default fg/bg
#   1 .. 256               = palette color (value-1 => index 0..255)
#   0x1000000 | (r<<16|g<<8|b) = 24-bit truecolor
# Ranges are disjoint, so a stored color is self-describing for the renderer.

enum TermColor {
    COLOR_DEFAULT = 0;
    COLOR_TRUE    = 0x1000000;   # truecolor tag bit (bit 24)
    ATTR_ALL      = 0xFFFF;      # mask for clearing attribute bits via XOR
}

var term_autowrap = 1;     # DECAWM
var term_pending_wrap = 0; # pending wrap: at last col, wrap on next print
var term_origin = 0;       # DECOM (cursor addressing relative to scroll region)
var term_insert = 0;       # IRM (insert mode)
var term_cursor_vis = 1;   # DECTCEM (display only; tracked for the renderer)
var term_app_cursor = 0;   # DECCKM (cursor-key mode; consumed by the input encoder)
var term_bracket_paste = 0; # DEC mode 2004 (bracketed paste; read by input.cyr)
var term_attr = 0;         # current SGR pen
var term_fg = 0;
var term_bg = 0;
var term_saved_row = 0;    # DECSC / ANSI.SYS save-cursor
var term_saved_col = 0;
var term_alt_saved_row = 0; # mode-1049 cursor save (separate from DECSC)
var term_alt_saved_col = 0;

# ---- color helpers -----------------------------------------------------
fn color_palette(idx): i64 { return idx + 1; }
fn color_rgb(r, g, b): i64 { return COLOR_TRUE | ((r & 255) << 16) | ((g & 255) << 8) | (b & 255); }

fn term__sync_pen(): i64 { return grid_set_pen(term_attr, term_fg, term_bg); }

# Cursor visibility (DECTCEM) for the renderer — read through this accessor,
# never the global. 1 = visible, 0 = hidden.
fn term_cursor_visible(): i64 { return term_cursor_vis; }

# Terminal modes the input encoder (input.cyr) reads — through accessors, never
# the globals. DECCKM (application cursor keys) and bracketed paste (mode 2004).
fn term_app_cursor_get(): i64 { return term_app_cursor; }
fn term_bracket_paste_get(): i64 { return term_bracket_paste; }

# ---- lifecycle ---------------------------------------------------------
fn term_init(rows, cols): i64 {
    grid_init(rows, cols);
    vt_reset();
    utf8_reset();
    term_autowrap = 1;
    term_pending_wrap = 0;
    term_origin = 0;
    term_insert = 0;
    term_cursor_vis = 1;
    term_app_cursor = 0;
    term_bracket_paste = 0;
    term_attr = 0;
    term_fg = 0;
    term_bg = 0;
    term_saved_row = 0;
    term_saved_col = 0;
    term_alt_saved_row = 0;
    term_alt_saved_col = 0;
    term__sync_pen();
    return 0;
}

# Resize the terminal (e.g. on SIGWINCH). Delegates to the grid and clears
# the pending-wrap latch. The caller (the PTY owner) is responsible for
# pushing the new size to the child via pty_set_winsize — terminal.cyr does
# not depend on the PTY layer.
fn term_resize(rows, cols): i64 {
    grid_resize(rows, cols);
    term_pending_wrap = 0;
    return 0;
}

# ---- vertical movement -------------------------------------------------

# IND / LF: move down one line, scrolling the region up at the bottom margin.
fn term_index(): i64 {
    if (grid_cursor_row() == grid_scroll_bot_get()) {
        grid_scroll_up(1);
    } else {
        grid_cursor_set(grid_cursor_row() + 1, grid_cursor_col());
    }
    return 0;
}

# RI: move up one line, scrolling the region down at the top margin.
fn term_reverse_index(): i64 {
    if (grid_cursor_row() == grid_scroll_top_get()) {
        grid_scroll_down(1);
    } else {
        grid_cursor_set(grid_cursor_row() - 1, grid_cursor_col());
    }
    return 0;
}

fn term_carriage_return(): i64 {
    grid_cursor_set(grid_cursor_row(), 0);
    term_pending_wrap = 0;
    return 0;
}

# CR + LF, used for the pending autowrap.
fn term_newline(): i64 {
    term_carriage_return();
    term_index();
    return 0;
}

# ---- printing ----------------------------------------------------------

fn term_print(cp): i64 {
    var w = char_width(cp);
    if (w == 0) { return 0; }   # combining/zero-width: not separately placed in M1

    # resolve a pending wrap from the previous glyph at the right margin
    if (term_pending_wrap == 1) {
        if (term_autowrap == 1) { term_newline(); }
        term_pending_wrap = 0;
    }

    var row = grid_cursor_row();
    var col = grid_cursor_col();

    # wrap if a wide glyph would straddle the right margin
    if (col + w > grid_get_cols()) {
        if (term_autowrap == 1) {
            term_newline();
            row = grid_cursor_row();
            col = 0;
        } else {
            col = grid_get_cols() - w;     # clamp so it fits on the line
            if (col < 0) { col = 0; }
        }
    }

    if (term_insert == 1) { grid_insert_cells(row, col, w); }

    grid_put_cell(row, col, cp);
    if (w == 2) { grid_set_cell(row, col + 1, 0, term_attr, term_fg, term_bg); }  # wide spacer

    var nextc = col + w;
    if (nextc >= grid_get_cols()) {
        grid_cursor_set(row, grid_get_cols() - 1);   # stay at last col
        term_pending_wrap = 1;                       # wrap pending until next print
    } else {
        grid_cursor_set(row, nextc);
        term_pending_wrap = 0;
    }
    return 0;
}

# ---- C0 control bytes --------------------------------------------------
fn term_c0(b): i64 {
    if (b == 0x08) {                         # BS
        if (grid_cursor_col() > 0) { grid_cursor_set(grid_cursor_row(), grid_cursor_col() - 1); }
        term_pending_wrap = 0;
        return 0;
    }
    if (b == 0x09) {                         # HT
        grid_cursor_set(grid_cursor_row(), grid_next_tab(grid_cursor_col()));
        term_pending_wrap = 0;
        return 0;
    }
    if (b == 0x0a) { term_index(); term_pending_wrap = 0; return 0; }   # LF
    if (b == 0x0b) { term_index(); term_pending_wrap = 0; return 0; }   # VT
    if (b == 0x0c) { term_index(); term_pending_wrap = 0; return 0; }   # FF
    if (b == 0x0d) { term_carriage_return(); return 0; }               # CR
    # BEL (0x07) and the rest: no display effect in M1
    return 0;
}

# ---- SGR ---------------------------------------------------------------
fn term__attr_clear(mask): i64 { term_attr = term_attr & (ATTR_ALL ^ mask); return 0; }

fn term_sgr(): i64 {
    var count = vt_param_count();
    if (count == 0) {
        term_attr = 0; term_fg = 0; term_bg = 0;
        term__sync_pen();
        return 0;
    }
    var i = 0;
    while (i < count) {
        var p = vt_param(i);
        if (p == 0) { term_attr = 0; term_fg = 0; term_bg = 0; }
        elif (p == 1) { term_attr = term_attr | ATTR_BOLD; }
        elif (p == 2) { term_attr = term_attr | ATTR_DIM; }
        elif (p == 3) { term_attr = term_attr | ATTR_ITALIC; }
        elif (p == 4) { term_attr = term_attr | ATTR_UNDERLINE; }
        elif (p == 5) { term_attr = term_attr | ATTR_BLINK; }
        elif (p == 7) { term_attr = term_attr | ATTR_REVERSE; }
        elif (p == 8) { term_attr = term_attr | ATTR_HIDDEN; }
        elif (p == 9) { term_attr = term_attr | ATTR_STRIKE; }
        elif (p == 22) { term__attr_clear(ATTR_BOLD | ATTR_DIM); }
        elif (p == 23) { term__attr_clear(ATTR_ITALIC); }
        elif (p == 24) { term__attr_clear(ATTR_UNDERLINE); }
        elif (p == 25) { term__attr_clear(ATTR_BLINK); }
        elif (p == 27) { term__attr_clear(ATTR_REVERSE); }
        elif (p == 28) { term__attr_clear(ATTR_HIDDEN); }
        elif (p == 29) { term__attr_clear(ATTR_STRIKE); }
        elif (p == 39) { term_fg = 0; }
        elif (p == 49) { term_bg = 0; }
        elif (p == 38) { i = term__ext_color(i, 1); }
        elif (p == 48) { i = term__ext_color(i, 0); }
        else {
            if (p >= 30) {
                if (p <= 37) { term_fg = color_palette(p - 30); }
            }
            if (p >= 40) {
                if (p <= 47) { term_bg = color_palette(p - 40); }
            }
            if (p >= 90) {
                if (p <= 97) { term_fg = color_palette(p - 90 + 8); }
            }
            if (p >= 100) {
                if (p <= 107) { term_bg = color_palette(p - 100 + 8); }
            }
        }
        i = i + 1;
    }
    term__sync_pen();
    return 0;
}

# Extended color starting at param index i (the 38/48 selector). is_fg=1 for
# foreground. Returns the new index to continue from (the last param consumed).
# Handles both 5;<idx> (256-color) and 2;<r>;<g>;<b> (truecolor) — colon and
# semicolon forms arrive identically (parser flattens ':' into params).
fn term__ext_color(i, is_fg): i64 {
    var mode = vt_param(i + 1);
    var col = 0;
    var consumed = i;
    if (mode == 5) {
        col = color_palette(vt_param(i + 2));
        consumed = i + 2;
    }
    if (mode == 2) {
        col = color_rgb(vt_param(i + 2), vt_param(i + 3), vt_param(i + 4));
        consumed = i + 4;
    }
    if (is_fg == 1) { term_fg = col; } else { term_bg = col; }
    return consumed;
}

# ---- CSI dispatch ------------------------------------------------------
fn term_csi(final): i64 {
    var prefix = vt_prefix();

    # private (DEC) modes: CSI ? Pm h / l
    if (prefix == 0x3f) {
        if (final == 0x68) { return term__dec_mode(1); }   # 'h' set
        if (final == 0x6c) { return term__dec_mode(0); }   # 'l' reset
        return 0;                                          # other private CSIs: ignore in M1
    }
    if (prefix != 0) { return 0; }                         # other prefixes ('<','=','>'): ignore

    var p1 = vt_param_or(0, 1);
    var row = grid_cursor_row();
    var col = grid_cursor_col();

    if (final == 0x41) { grid_cursor_set(row - p1, col); term_pending_wrap = 0; return 0; }      # CUU
    if (final == 0x42) { grid_cursor_set(row + p1, col); term_pending_wrap = 0; return 0; }      # CUD
    if (final == 0x43) { grid_cursor_set(row, col + p1); term_pending_wrap = 0; return 0; }      # CUF
    if (final == 0x44) { grid_cursor_set(row, col - p1); term_pending_wrap = 0; return 0; }      # CUB
    if (final == 0x45) { grid_cursor_set(row + p1, 0); term_pending_wrap = 0; return 0; }        # CNL
    if (final == 0x46) { grid_cursor_set(row - p1, 0); term_pending_wrap = 0; return 0; }        # CPL
    if (final == 0x47) { grid_cursor_set(row, p1 - 1); term_pending_wrap = 0; return 0; }        # CHA
    if (final == 0x64) { grid_cursor_set(p1 - 1, col); term_pending_wrap = 0; return 0; }        # VPA
    if (final == 0x48) { return term__cup(); }                                                   # CUP
    if (final == 0x66) { return term__cup(); }                                                   # HVP (= CUP)
    if (final == 0x4a) { return term__erase_display(vt_param(0)); }                              # ED
    if (final == 0x4b) { return term__erase_line(vt_param(0)); }                                 # EL
    if (final == 0x4c) { grid_scroll_down_in(row, grid_scroll_bot_get(), p1); return 0; }        # IL
    if (final == 0x4d) { grid_scroll_up_in(row, grid_scroll_bot_get(), p1); return 0; }          # DL
    if (final == 0x40) { grid_insert_cells(row, col, p1); return 0; }                            # ICH
    if (final == 0x50) { grid_delete_cells(row, col, p1); return 0; }                            # DCH
    if (final == 0x58) { grid_erase_cells(row, col, col + p1 - 1); return 0; }                   # ECH
    if (final == 0x53) { grid_scroll_up(p1); return 0; }                                         # SU
    if (final == 0x54) { grid_scroll_down(p1); return 0; }                                       # SD
    if (final == 0x72) { return term__decstbm(); }                                               # DECSTBM
    if (final == 0x6d) { return term_sgr(); }                                                    # SGR
    if (final == 0x67) { return term__tbc(vt_param(0)); }                                        # TBC
    if (final == 0x68) { return term__ansi_mode(1); }                                            # SM (IRM)
    if (final == 0x6c) { return term__ansi_mode(0); }                                            # RM
    if (final == 0x73) { term_saved_row = row; term_saved_col = col; return 0; }                 # SCP (save)
    if (final == 0x75) { grid_cursor_set(term_saved_row, term_saved_col); return 0; }            # RCP (restore)
    # DA ('c') / DSR ('n') need a host writer — deferred to M7 conformance (roadmap).
    return 0;
}

fn term__cup(): i64 {
    var r = vt_param_or(0, 1) - 1;
    var c = vt_param_or(1, 1) - 1;
    if (term_origin == 1) { r = r + grid_scroll_top_get(); }
    grid_cursor_set(r, c);
    term_pending_wrap = 0;
    return 0;
}

fn term__erase_display(mode): i64 {
    var row = grid_cursor_row();
    var col = grid_cursor_col();
    var last = grid_get_rows() - 1;
    if (mode == 1) {                                   # start .. cursor
        if (row > 0) { grid_erase_rows(0, row - 1); }
        grid_erase_cells(row, 0, col);
    } elif (mode == 2) {                               # whole display
        grid_erase_rows(0, last);
    } elif (mode == 3) {                               # display + scrollback (none in M1)
        grid_erase_rows(0, last);
    } else {                                           # cursor .. end
        grid_erase_cells(row, col, grid_get_cols() - 1);
        if (row < last) { grid_erase_rows(row + 1, last); }
    }
    return 0;
}

fn term__erase_line(mode): i64 {
    var row = grid_cursor_row();
    var col = grid_cursor_col();
    var last = grid_get_cols() - 1;
    if (mode == 1) { grid_erase_cells(row, 0, col); }          # start .. cursor
    elif (mode == 2) { grid_erase_cells(row, 0, last); }       # whole line
    else { grid_erase_cells(row, col, last); }                 # cursor .. end
    return 0;
}

fn term__decstbm(): i64 {
    var top = vt_param_or(0, 1) - 1;
    var bot = vt_param_or(1, grid_get_rows()) - 1;
    grid_set_scroll(top, bot);
    # DECSTBM homes the cursor (origin-relative).
    if (term_origin == 1) { grid_cursor_set(grid_scroll_top_get(), 0); }
    else { grid_cursor_set(0, 0); }
    term_pending_wrap = 0;
    return 0;
}

fn term__tbc(mode): i64 {
    if (mode == 3) { grid_tab_clear_all(); return 0; }   # clear all
    grid_tab_clear(grid_cursor_col());                   # clear at cursor (mode 0)
    return 0;
}

# ANSI (non-private) modes. M1 handles IRM (4).
fn term__ansi_mode(set): i64 {
    if (vt_param(0) == 4) { term_insert = set; }
    return 0;
}

# DEC private modes (CSI ? Pn h/l). M1 handles DECCKM/DECOM/DECAWM/DECTCEM.
fn term__dec_mode(set): i64 {
    var m = vt_param(0);
    if (m == 1) { term_app_cursor = set; }                 # DECCKM
    if (m == 6) {                                          # DECOM (origin)
        term_origin = set;
        if (set == 1) { grid_cursor_set(grid_scroll_top_get(), 0); }
        else { grid_cursor_set(0, 0); }
    }
    if (m == 7) { term_autowrap = set; }                   # DECAWM
    if (m == 25) {                                         # DECTCEM (cursor show/hide)
        if (set != term_cursor_vis) {
            term_cursor_vis = set;
            # The renderer is damage-driven and draws the cursor block purely
            # from visibility; toggling it writes no cell, so dirty the cursor
            # row or the block ghosts (hide) / fails to reappear (show).
            grid_mark_row_dirty(grid_cursor_row());
        }
    }
    if (m == 2004) { term_bracket_paste = set; }           # bracketed paste (input.cyr)
    if (m == 1049) { term__alt_screen(set); }              # alt-screen + save cursor + clear
    if (m == 47) { grid_alt_screen(set); }                 # legacy alt-screen (buffer only)
    if (m == 1047) {                                        # alt-screen, clear on enter
        grid_alt_screen(set);
        if (set == 1) { grid_clear_all(); grid_cursor_set(0, 0); }
    }
    # mouse (1000..1006): deferred to M7 conformance (roadmap)
    return 0;
}

# DEC 1049: the full-screen-app idiom (vim/less/htop/tmux). Enter saves the
# cursor, switches to the alt buffer, and clears it; exit switches back and
# restores the cursor. Guarded so a repeated set/reset is a no-op (no double
# save/restore). The buffer swap preserves the primary screen (grid.cyr).
fn term__alt_screen(set): i64 {
    if (set == 1) {
        if (grid_in_alt() == 0) {
            term_alt_saved_row = grid_cursor_row();
            term_alt_saved_col = grid_cursor_col();
            grid_alt_screen(1);
            grid_clear_all();
            grid_cursor_set(0, 0);
            term_pending_wrap = 0;
        }
    } else {
        if (grid_in_alt() == 1) {
            grid_alt_screen(0);
            grid_cursor_set(term_alt_saved_row, term_alt_saved_col);
            term_pending_wrap = 0;
        }
    }
    return 0;
}

# ---- ESC dispatch ------------------------------------------------------
fn term_esc(final): i64 {
    if (vt_inter_count() > 0) { return 0; }   # charset designators (ESC ( B): deferred to M7 conformance (roadmap)
    if (final == 0x44) { term_index(); return 0; }            # IND (ESC D)
    if (final == 0x4d) { term_reverse_index(); return 0; }    # RI  (ESC M)
    if (final == 0x45) { term_newline(); return 0; }          # NEL (ESC E)
    if (final == 0x37) {                                      # DECSC (ESC 7) save cursor
        term_saved_row = grid_cursor_row();
        term_saved_col = grid_cursor_col();
        return 0;
    }
    if (final == 0x38) {                                      # DECRC (ESC 8) restore cursor
        grid_cursor_set(term_saved_row, term_saved_col);
        return 0;
    }
    if (final == 0x63) { return term_init(grid_get_rows(), grid_get_cols()); }   # RIS (ESC c) full reset
    if (final == 0x48) { grid_tab_set(grid_cursor_col()); return 0; }            # HTS (ESC H) set tab stop
    return 0;
}

# ---- the pump ----------------------------------------------------------
fn term_feed(b): i64 {
    var ev = vt_feed(b);
    if (ev == VTE_PRINT) {
        var cp = utf8_feed(vt_event_char());
        if (cp != UTF8_MORE) { term_print(cp); }
        return 0;
    }
    if (ev == VTE_EXECUTE) { return term_c0(vt_event_char()); }
    if (ev == VTE_CSI) { return term_csi(vt_event_char()); }
    if (ev == VTE_ESC) { return term_esc(vt_event_char()); }
    # VTE_OSC: titles etc. — captured by the parser; no grid effect in M1.
    return 0;
}

fn term_feed_str(s): i64 {
    var n = strlen(s);
    for (var i = 0; i < n; i = i + 1) { term_feed(load8(s + i)); }
    return 0;
}

# ---- headless renderer (grid -> UTF-8 text) ----------------------------
# Write row r's glyphs as UTF-8 into buf (cap bytes). Wide-spacer cells
# (glyph 0) are skipped. Returns bytes written. Trailing blanks are kept
# (callers that want a trimmed compare can stop at the logical end).
fn term_render_row(r, buf, cap): i64 {
    var n = 0;
    var c = 0;
    var cols = grid_get_cols();
    while (c < cols) {
        var g = grid_glyph(r, c);
        if (g != 0) {
            if (n + 4 <= cap) { n = n + utf8_encode(g, buf + n); }
        }
        c = c + 1;
    }
    return n;
}

# Like term_render_row but drops trailing spaces (0x20) — handy for tests.
fn term_render_row_trim(r, buf, cap): i64 {
    var n = term_render_row(r, buf, cap);
    while (n > 0) {
        if (load8(buf + n - 1) != 0x20) { return n; }
        n = n - 1;
    }
    return n;
}

# --- pixfmt.cyr ---

# pixfmt.cyr — RGB → XRGB8888 packing for the Wayland present path (wl_shm/dmabuf).
#
# The surviving, device-neutral core of the retired fbdev backend: fb.cyr renders
# the grid into a W*H*3 packed-RGB buffer; the compositor wants 32-bit XRGB8888
# (memory bytes B,G,R,0x00 on little-endian — exactly what store32(R<<16|G<<8|B)
# produces). This module is the one place that conversion lives, reused by the
# wl_shm software path now and the mabda-GPU swizzle later. Includes nothing.

# Pack one (r,g,b) into an XRGB8888 word (store32 -> B,G,R,0 on little-endian).
fn pix_rgb_to_xrgb(r, g, b): i64 { return (r << 16) | (g << 8) | b; }

# Blit pixel rows [py0, py1) of a W*H*3 packed-RGB source into an XRGB8888
# destination whose rows are `dst_stride_px` pixels apart. Damage-aware: the
# event loop blits only the rows the renderer touched (a full blit is py0=0,
# py1=sh), so a one-line keystroke echo copies ~16 rows, not the whole screen.
fn pix_blit_region(src_rgb, sw, py0, py1, dst, dst_stride_px): i64 {
    var y = py0;
    while (y < py1) {
        var srow = y * sw;
        var drow = y * dst_stride_px;
        var x = 0;
        while (x < sw) {
            var sp = (srow + x) * 3;
            store32(dst + (drow + x) * 4,
                    (load8(src_rgb + sp) << 16) | (load8(src_rgb + sp + 1) << 8) | load8(src_rgb + sp + 2));
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

# --- atlas.cyr ---

# atlas.cyr — kashi glyph atlas for GPU sampling (M6 bite 8).
#
# Packs kashi's 256 CP437 glyphs (VGA 8x16) into a 16x16 grid → a 128x256 RGBA8
# coverage texture the GPU shader samples. Glyph g lives at cell (g%16, g/16);
# a pixel is opaque white (0xFFFFFFFF) where the glyph bitmap bit is set and
# transparent (0x00000000) elsewhere. The shader samples this coverage and
# multiplies by the per-cell foreground colour (so one atlas serves every colour).
#
# Pure CPU + a pure READ of kashi's freestanding font core (same `kashi_glyph_row`
# the CPU renderer uses) — no mabda, no GPU. The texture upload + sampling shader
# are the next steps; this is the data they consume. Co-compiled after
# lib/kashi_font_data.cyr; includes nothing.

enum AtlasDim {
    ATLAS_COLS    = 16;        # glyphs per atlas row
    ATLAS_GLYPH_W = 8;         # VGA cell width
    ATLAS_GLYPH_H = 16;        # VGA cell height
    ATLAS_W       = 128;       # ATLAS_COLS * ATLAS_GLYPH_W
    ATLAS_H       = 256;       # (256/ATLAS_COLS) * ATLAS_GLYPH_H = 16 * 16
}

# Fill `out` (ATLAS_W*ATLAS_H*4 = 131072 bytes, 128 KiB → 64 KiB-aligned) with the
# RGBA8 atlas for kashi font `font_id` (0 = VGA 8x16). store32 writes LE bytes, so
# 0xFFFFFFFF = white opaque and 0 = transparent black; the coverage lives in any
# channel the shader reads. Returns 0.
fn atlas_build_kashi(out, font_id): i64 {
    var n = ATLAS_W * ATLAS_H;
    var i = 0;
    while (i < n) { store32(out + i * 4, 0); i = i + 1; }       # clear to transparent
    var g = 0;
    while (g < 256) {
        var cx = (g % ATLAS_COLS) * ATLAS_GLYPH_W;              # cell origin (px)
        var cy = (g / ATLAS_COLS) * ATLAS_GLYPH_H;
        var row = 0;
        while (row < ATLAS_GLYPH_H) {
            var bits = kashi_glyph_row(font_id, g, row);        # bit7 = leftmost px
            if (bits != 0) {
                var col = 0;
                while (col < ATLAS_GLYPH_W) {
                    if ((bits & (1 << (7 - col))) != 0) {
                        var px = (cy + row) * ATLAS_W + (cx + col);
                        store32(out + px * 4, 0xFFFFFFFF);
                    }
                    col = col + 1;
                }
            }
            row = row + 1;
        }
        g = g + 1;
    }
    return 0;
}

# Atlas geometry (for the texture create + the shader's UV math).
fn atlas_w(): i64 { return ATLAS_W; }
fn atlas_h(): i64 { return ATLAS_H; }
fn atlas_bytes(): i64 { return ATLAS_W * ATLAS_H * 4; }
fn atlas_cols(): i64 { return ATLAS_COLS; }
fn atlas_glyph_w(): i64 { return ATLAS_GLYPH_W; }
fn atlas_glyph_h(): i64 { return ATLAS_GLYPH_H; }

# Top-left pixel of glyph cp within the atlas (for UV / readback math).
fn atlas_cell_x(cp): i64 { return (cp % ATLAS_COLS) * ATLAS_GLYPH_W; }
fn atlas_cell_y(cp): i64 { return (cp / ATLAS_COLS) * ATLAS_GLYPH_H; }

# --- fb.cyr ---

# fb.cyr — puka framebuffer renderer (the first VISIBLE surface).
#
# A pure READ of the grid (architecture invariant: grid is the single source
# of truth; terminal.cyr is the only writer; the renderer never mutates).
# It paints each cell's background rectangle in resolved RGB, blits the cell's
# glyph foreground via kashi's freestanding bitmap-font core, draws the cursor
# block (reverse-under-cursor), and serializes the pixel buffer to a PPM (P6)
# image so the output is headlessly verifiable with pixel-asserting tests —
# the same headless discipline as terminal.cyr's text renderer.
#
# Integer-only (no floats); all colour math is i64 with byte masks. The pixel
# buffer is heap-allocated (alloc) — never a module-global `var buf[N]` (which
# at module scope is N*u64, the wrong size).
#
# Co-compiled: the consumer (main / a test / a program) includes, in order,
# parser.cyr, grid.cyr, unicode.cyr, terminal.cyr, lib/kashi_font_data.cyr,
# then this file. fb.cyr itself includes nothing (mirrors terminal.cyr) to
# avoid double includes. fb_init() calls kashi_font_init() so callers don't
# have to remember to (it is idempotent).
#
# Colour input is terminal.cyr's self-describing encoding (ranges disjoint):
#   0                     = default fg / bg
#   1..256                = palette colour, index = value-1 (16 ANSI + 6x6x6
#                           cube + grayscale ramp)
#   0x1000000 | rgb       = 24-bit truecolor (bit 24 set)
#
# Backend note: this renders into an in-memory RGB buffer + PPM (the Linux dev
# / CI path, fully testable). Pushing the buffer to a real display — Linux
# KMS/DRM or the AGNOS `blit`#39 framebuffer — is a thin later backend over
# the same buffer, not this module's concern.

# Cursor styles (only block is wired; the rest are reserved for a DECSCUSR bite).
enum FbCursorStyle {
    FB_CURSOR_BLOCK     = 0;
    FB_CURSOR_UNDERLINE = 1;
    FB_CURSOR_BAR       = 2;
}

# ---- module state ------------------------------------------------------
var fb_buf_ptr = 0;        # heap base of the W*H*3 RGB buffer (0 = uninitialized)
var fb_cap     = 0;        # allocated bytes (high-water; fb_resize grows, never shrinks)
var fb_cell_w  = 8;        # cell width  in px (default VGA 8x16)
var fb_cell_h  = 16;       # cell height in px
var fb_w       = 0;        # framebuffer width  = cols * fb_cell_w
var fb_h       = 0;        # framebuffer height = rows * fb_cell_h
var fb_def_fg  = 0xC0C0C0; # default foreground RGB (xterm light grey)
var fb_def_bg  = 0x000000; # default background RGB (black)
var fb_cursor_style = 0;   # FB_CURSOR_BLOCK
var fb_font_id = 0;        # KASHI_FONT_VGA_8X16

# ---- palette / colour resolution (pure) --------------------------------

# One 6x6x6-cube channel level for a digit 0..5 (xterm: 0,95,135,175,215,255).
fn fb__level(d): i64 {
    if (d == 0) { return 0; }
    return d * 40 + 55;
}

# Palette index 0..255 -> packed 0xRRGGBB. Closed-form (no materialized table);
# idx is clamped first since it derives from untrusted cell data.
fn fb__palette_rgb(idx): i64 {
    if (idx < 0) { idx = 0; }
    if (idx > 255) { idx = 255; }
    # 0..15 — the standard ANSI/VGA 16 (xterm values).
    if (idx == 0)  { return 0x000000; }
    if (idx == 1)  { return 0x800000; }
    if (idx == 2)  { return 0x008000; }
    if (idx == 3)  { return 0x808000; }
    if (idx == 4)  { return 0x000080; }
    if (idx == 5)  { return 0x800080; }
    if (idx == 6)  { return 0x008080; }
    if (idx == 7)  { return 0xC0C0C0; }
    if (idx == 8)  { return 0x808080; }
    if (idx == 9)  { return 0xFF0000; }
    if (idx == 10) { return 0x00FF00; }
    if (idx == 11) { return 0xFFFF00; }
    if (idx == 12) { return 0x0000FF; }
    if (idx == 13) { return 0xFF00FF; }
    if (idx == 14) { return 0x00FFFF; }
    if (idx == 15) { return 0xFFFFFF; }
    if (idx < 232) {
        # 16..231 — 6x6x6 colour cube.
        var n = idx - 16;
        var ri = n / 36;
        var gi = (n / 6) % 6;
        var bi = n % 6;
        return (fb__level(ri) << 16) | (fb__level(gi) << 8) | fb__level(bi);
    }
    # 232..255 — 24-step grayscale ramp (8, 18, .. 238).
    var g = 8 + (idx - 232) * 10;
    return (g << 16) | (g << 8) | g;
}

# Decode one stored colour token -> 0xRRGGBB. is_fg picks the default.
fn fb__decode(val, is_fg): i64 {
    if (val == 0) {
        if (is_fg != 0) { return fb_def_fg; }
        return fb_def_bg;
    }
    if ((val & 0x1000000) != 0) { return val & 0xFFFFFF; }   # truecolor, verbatim
    return fb__palette_rgb(val - 1);                          # palette 1..256
}

# Resolve cell (r,c) to a final (fg_rgb, bg_rgb) pair, writing fg -> out[0..7]
# and bg -> out[8..15] (caller passes a >=16-byte scratch buffer). The order is
# load-bearing: bold-brighten token -> decode -> dim -> reverse -> hidden ->
# cursor (cursor reuses the reverse swap, so SGR-reverse under the cursor
# double-swaps back to normal — matching xterm).
fn fb__resolve(r, c, is_cursor, out): i64 {
    var fgv = grid_vfg(r, c);                # viewport-aware (history when scrolled back,
    var bgv = grid_vbg(r, c);                # live grid at the bottom)
    var at  = grid_vattr(r, c);
    # BOLD = bright: standard palette fg tokens 1..8 (index 0..7) -> 9..16.
    if ((at & ATTR_BOLD) != 0) {
        if (fgv >= 1) { if (fgv <= 8) { fgv = fgv + 8; } }
    }
    var fg = fb__decode(fgv, 1);
    var bg = fb__decode(bgv, 0);
    if ((at & ATTR_DIM) != 0) { fg = (fg >> 1) & 0x7F7F7F; }      # halve each channel
    if ((at & ATTR_REVERSE) != 0) { var t = fg; fg = bg; bg = t; }
    if ((at & ATTR_HIDDEN) != 0) { fg = bg; }                     # conceal glyph
    if (is_cursor != 0) { var u = fg; fg = bg; bg = u; }
    store64(out, fg);
    store64(out + 8, bg);
    return 0;
}

# ---- pixel buffer ------------------------------------------------------

# Plot one pixel (the single bounds-clamped write path). PTY/grid data is
# untrusted, so every coordinate is checked.
fn fb__plot(x, y, rgb): i64 {
    if (fb_buf_ptr == 0) { return 0; }
    if (x < 0) { return 0; }
    if (x >= fb_w) { return 0; }
    if (y < 0) { return 0; }
    if (y >= fb_h) { return 0; }
    var off = (y * fb_w + x) * 3;
    store8(fb_buf_ptr + off, (rgb >> 16) & 255);
    store8(fb_buf_ptr + off + 1, (rgb >> 8) & 255);
    store8(fb_buf_ptr + off + 2, rgb & 255);
    return 0;
}

fn fb__fill_rect(x, y, w, h, rgb): i64 {
    var dy = 0;
    while (dy < h) {
        var dx = 0;
        while (dx < w) {
            fb__plot(x + dx, y + dy, rgb);
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    return 0;
}

# Initialize: seed cell metrics, (re)allocate the W*H*3 RGB buffer, zero it
# (alloc does not), ensure kashi's built-in fonts are loaded, and mark every
# row dirty so the first fb_render() paints the whole screen. Call after
# grid_init/term_init (so cols/rows are known) and after alloc_init().
# Returns 0 on success, -1 on bad size / OOM.
fn fb_init(cell_w, cell_h): i64 {
    kashi_font_init();                       # idempotent — built-in fonts ready
    if (cell_w < 1) { cell_w = 1; }
    if (cell_h < 1) { cell_h = 1; }
    # Bound cell metrics so W*H*3 cannot wrap i64 (no real console cell exceeds
    # this). With cols<=132 / rows<=64 already bounded by the grid, this keeps
    # fb_w/fb_h small-positive; a genuinely-too-large request then fails cleanly
    # at alloc() instead of wrapping sz into a tiny, undersized buffer.
    if (cell_w > 256) { cell_w = 256; }
    if (cell_h > 256) { cell_h = 256; }
    fb_cell_w = cell_w;
    fb_cell_h = cell_h;
    fb_w = grid_get_cols() * cell_w;
    fb_h = grid_get_rows() * cell_h;
    if (fb_w <= 0) { return 0 - 1; }
    if (fb_h <= 0) { return 0 - 1; }
    var sz = fb_w * fb_h * 3;
    if (sz <= 0) { return 0 - 1; }
    if (sz / 3 != fb_w * fb_h) { return 0 - 1; }   # overflow backstop (defensive)
    fb_buf_ptr = alloc(sz);
    if (fb_buf_ptr == 0) { return 0 - 1; }
    fb_cap = sz;
    # zero exactly sz bytes: word sweep then byte tail (no over-write assumption)
    var nwords = sz / 8;
    var i = 0;
    while (i < nwords) { store64(fb_buf_ptr + i * 8, 0); i = i + 1; }
    var j = nwords * 8;
    while (j < sz) { store8(fb_buf_ptr + j, 0); j = j + 1; }
    grid_mark_all_dirty();
    return 0;
}

# Re-fit the pixel buffer to the CURRENT grid dims after a window resize (the
# grid was already grid_resize'd). Grow-only: the buffer is reallocated to a new
# high-water size (rare — the allocator has no free, so per-drag realloc would
# leak; growth converges as the user finds their max window), otherwise the
# existing buffer is reused with a tighter stride (fb__plot strides by fb_w). No
# zeroing: fb_render repaints every cell of every (now all-dirty) row, and the
# present blits only the grid region. Returns 0, or -1 on bad size / OOM.
fn fb_resize(): i64 {
    var nw = grid_get_cols() * fb_cell_w;
    var nh = grid_get_rows() * fb_cell_h;
    if (nw <= 0) { return 0 - 1; }
    if (nh <= 0) { return 0 - 1; }
    var sz = nw * nh * 3;
    if (sz <= 0) { return 0 - 1; }
    if (sz / 3 != nw * nh) { return 0 - 1; }       # overflow backstop
    if (sz > fb_cap) {                              # grow to a new high-water (rare)
        var p = alloc(sz);
        if (p == 0) { return 0 - 1; }
        fb_buf_ptr = p;
        fb_cap = sz;
    }
    fb_w = nw;
    fb_h = nh;
    grid_mark_all_dirty();                          # full repaint at the new size
    return 0;
}

# Re-seed cell metrics + re-allocate (e.g. adopting a new font's glyph size).
fn fb_set_cell_size(cell_w, cell_h): i64 { return fb_init(cell_w, cell_h); }

fn fb_set_default_colors(fg_rgb, bg_rgb): i64 {
    fb_def_fg = fg_rgb;
    fb_def_bg = bg_rgb;
    return 0;
}

fn fb_set_cursor_style(style): i64 { fb_cursor_style = style; return 0; }

# ---- glyph foreground (kashi seam) -------------------------------------

# Blit codepoint cp's bitmap at cell pixel origin (x_px,y_px) in fg_rgb, set
# bits only (unset bits leave the already-painted background). Sourced from
# kashi's freestanding font core: kashi_glyph_row returns one row byte,
# bit 7 = leftmost pixel. Codepoints with no glyph (control / CJK / combining,
# outside CP437 0x20..0xFF) yield 0 rows -> nothing drawn. Clamped to the cell
# box so an oversized glyph never bleeds into a neighbour.
fn fb__glyph_draw(cp, x_px, y_px, fg_rgb): i64 {
    var fw = kashi_font_width(fb_font_id);
    var fh = kashi_font_height(fb_font_id);
    if (fw <= 0) { return 0; }
    if (fh <= 0) { return 0; }
    if (fw > 8) { fw = 8; }                  # one row byte = 8 px (built-ins)
    if (fw > fb_cell_w) { fw = fb_cell_w; }
    if (fh > fb_cell_h) { fh = fb_cell_h; }
    var row = 0;
    while (row < fh) {
        var bits = kashi_glyph_row(fb_font_id, cp, row);
        if (bits != 0) {
            var col = 0;
            while (col < fw) {
                if ((bits & (1 << (7 - col))) != 0) {
                    fb__plot(x_px + col, y_px + row, fg_rgb);
                }
                col = col + 1;
            }
        }
        row = row + 1;
    }
    return 0;
}

# ---- frame -------------------------------------------------------------

# 1 iff the cursor is visible AND lands on cell (r,c) within the active grid.
fn fb__is_cursor(r, c): i64 {
    if (grid_view_off_get() != 0) { return 0; }       # no cursor while scrolled into history
    if (term_cursor_visible() == 0) { return 0; }
    if (r != grid_cursor_row()) { return 0; }
    if (c != grid_cursor_col()) { return 0; }
    if (r < 0) { return 0; }
    if (r >= grid_get_rows()) { return 0; }
    if (c < 0) { return 0; }
    if (c >= grid_get_cols()) { return 0; }
    return 1;
}

# Paint every dirty row (background + glyph + cursor), clearing each row's
# dirty bit right after — frame-atomic, single-threaded. Returns the number
# of rows repainted.
fn fb_render(): i64 {
    if (fb_buf_ptr == 0) { return 0; }
    var rows = grid_get_rows();
    var cols = grid_get_cols();
    var out[16];                             # 16 BYTES function-local scratch
    var painted = 0;
    var r = 0;
    while (r < rows) {
        if (grid_row_dirty(r) != 0) {
            var py = r * fb_cell_h;
            var c = 0;
            while (c < cols) {
                var px = c * fb_cell_w;
                fb__resolve(r, c, fb__is_cursor(r, c), &out);
                var fg = load64(&out);
                var bg = load64(&out + 8);
                fb__fill_rect(px, py, fb_cell_w, fb_cell_h, bg);
                var cp = grid_vglyph(r, c);
                if (cp != 0) {                                    # skip wide spacer
                    if ((grid_vattr(r, c) & ATTR_HIDDEN) == 0) {
                        fb__glyph_draw(cp, px, py, fg);
                    }
                }
                c = c + 1;
            }
            grid_clear_row_dirty(r);
            painted = painted + 1;
        }
        r = r + 1;
    }
    return painted;
}

# Force a full repaint (resize / first frame / backend reattach).
fn fb_render_full(): i64 {
    grid_mark_all_dirty();
    return fb_render();
}

# ---- PPM (P6) serialization -------------------------------------------

# Write n as ASCII decimal to fd (PPM header has no in-buffer int formatter).
fn fb__emit_uint(fd, n): i64 {
    if (n == 0) { return file_write(fd, "0", 1); }
    var d[24];
    var k = 0;
    while (n > 0) { store8(&d + k, 48 + n % 10); n = n / 10; k = k + 1; }
    var o[24];
    var j = 0;
    while (j < k) { store8(&o + j, load8(&d + k - 1 - j)); j = j + 1; }
    return file_write(fd, &o, k);
}

# Serialize the painted buffer to a PPM P6 file: "P6\n<w> <h>\n255\n" then
# raw RGB bytes. Returns bytes of pixel data written, or negative on error.
# (Only serializes — never touches the grid; the pixel-test verification seam.)
fn fb_dump_ppm(path): i64 {
    if (fb_buf_ptr == 0) { return 0 - 1; }
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    if (fd < 0) { return fd; }
    file_write(fd, "P6\n", 3);
    fb__emit_uint(fd, fb_w);
    file_write(fd, " ", 1);
    fb__emit_uint(fd, fb_h);
    file_write(fd, "\n255\n", 5);
    var total = fb_w * fb_h * 3;
    var done = 0;
    while (done < total) {
        var n = file_write(fd, fb_buf_ptr + done, total - done);
        if (n <= 0) { file_close(fd); return 0 - 1; }
        done = done + n;
    }
    file_close(fd);
    return done;
}

# ---- accessors (for tests / a future display backend) ------------------
fn fb_buf(): i64 { return fb_buf_ptr; }
fn fb_width(): i64 { return fb_w; }
fn fb_height(): i64 { return fb_h; }
