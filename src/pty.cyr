# pty.cyr — pseudo-terminal + child-process plumbing (Linux backend).
#
# Allocates a PTY pair, forks a child wired to the slave as its controlling
# terminal, execs a program, and pumps the master's output into term_feed()
# (terminal.cyr). This is the I/O edge that turns the headless core into a
# real terminal hosting a real process.
#
# Linux-only (devpts ABI: TIOCSPTLCK / TIOCGPTN). The AGNOS-native PTY
# surface is a kernel gap scheduled for M5; on non-Linux targets the calls
# are stubs that report "unsupported". PTY-master setup mirrors the proven
# sequence in darshana/tests/pty.tcyr; the fork/execve/argv build mirrors
# the cyrius stdlib process.cyr `_exec3`.
#
# Child spawn uses explicit argv (never a shell string) — no command
# injection surface (SECURITY.md / CLAUDE rule).

#ifdef CYRIUS_TARGET_LINUX

enum PtyAbi {
    PTY_SYS_IOCTL     = 16;          # x86_64 SYS_ioctl
    PTY_SYS_NANOSLEEP = 35;          # x86_64 SYS_nanosleep
    PTY_O_RDWR        = 2;
    PTY_O_NOCTTY      = 0x100;       # O_NOCTTY — don't acquire a controlling tty on open
    PTY_O_NONBLOCK    = 0x800;
    PTY_TIOCSPTLCK    = 0x40045431;  # _IOW('T',0x31,int)  — (un)lock slave
    PTY_TIOCGPTN      = 0x80045430;  # _IOR('T',0x30,uint) — slave number
    PTY_TIOCSWINSZ    = 0x5414;      # set window size
    PTY_TIOCSCTTY     = 0x540e;      # set controlling tty
}

var pty_master = 0;          # master fd (0 = unset; valid fds are >0 after stdio)
var pty_child_pid = 0;
var pty_slave_path[32];      # "/dev/pts/<n>\0" — module-global (256 bytes; first ~16 used)

# argv[0] override: if non-zero, the child execs with this as argv[0] instead of
# `path`. A terminal sets it to "-zsh" (leading dash) to spawn a LOGIN shell so
# the user's full startup chain (.zprofile → .zshrc → starship) sources. Default
# 0 = argv[0] is `path` (non-interactive demos/tests keep their behaviour).
var pty_login_argv0 = 0;

# Child environment, inherited from the parent (/proc/self/environ) with TERM
# overridden to what puka advertises. pty_env_buf holds the raw NUL-separated
# KEY=VALUE block (1024 u64 = 8192 bytes); pty_env_ptrs is the execve char**
# (128 u64 = 128 slots: ~126 inherited vars + our TERM + the NULL terminator).
var pty_env_buf[1024];
var pty_env_ptrs[128];

fn pty__nap(): i64 {
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 1000000);       # 0 s, 1e6 ns = 1 ms
    syscall(PTY_SYS_NANOSLEEP, &ts, 0);
    return 0;
}

# Build "/dev/pts/<n>\0" into pty_slave_path.
fn pty__build_slave_path(n): i64 {
    var pfx = "/dev/pts/";
    var i = 0;
    while (i < 9) { store8(&pty_slave_path + i, load8(pfx + i)); i = i + 1; }
    var pos = 9;
    if (n == 0) {
        store8(&pty_slave_path + pos, 0x30);
        pos = pos + 1;
    } else {
        var tmp[16];
        var ti = 0;
        var v = n;
        while (v > 0) {
            store8(&tmp + ti, 0x30 + (v - (v / 10) * 10));
            ti = ti + 1;
            v = v / 10;
        }
        var k = ti - 1;
        while (k >= 0) {
            store8(&pty_slave_path + pos, load8(&tmp + k));
            pos = pos + 1;
            k = k - 1;
        }
    }
    store8(&pty_slave_path + pos, 0);
    return 0;
}

# struct winsize { u16 ws_row, ws_col, ws_xpixel, ws_ypixel; } — set on fd.
fn pty_set_winsize(fd, rows, cols): i64 {
    var ws[8];
    store8(&ws + 0, rows & 0xff); store8(&ws + 1, (rows >> 8) & 0xff);
    store8(&ws + 2, cols & 0xff); store8(&ws + 3, (cols >> 8) & 0xff);
    store8(&ws + 4, 0); store8(&ws + 5, 0);
    store8(&ws + 6, 0); store8(&ws + 7, 0);
    return syscall(PTY_SYS_IOCTL, fd, PTY_TIOCSWINSZ, &ws);
}

# Open the PTY master and resolve the slave path. Returns the master fd, or
# a negative value on failure (sandbox / no devpts).
fn pty_open(): i64 {
    var m = sys_open("/dev/ptmx", PTY_O_RDWR | PTY_O_NOCTTY | PTY_O_NONBLOCK, 0);
    if (m < 0) { return 0 - 1; }

    var lockarg[4];
    store8(&lockarg + 0, 0); store8(&lockarg + 1, 0);
    store8(&lockarg + 2, 0); store8(&lockarg + 3, 0);
    if (syscall(PTY_SYS_IOCTL, m, PTY_TIOCSPTLCK, &lockarg) < 0) { sys_close(m); return 0 - 1; }

    var ptnbuf[4];
    store8(&ptnbuf + 0, 0); store8(&ptnbuf + 1, 0);
    store8(&ptnbuf + 2, 0); store8(&ptnbuf + 3, 0);
    if (syscall(PTY_SYS_IOCTL, m, PTY_TIOCGPTN, &ptnbuf) < 0) { sys_close(m); return 0 - 1; }

    pty__build_slave_path(load32(&ptnbuf));
    pty_master = m;
    pty_child_pid = 0;
    return m;
}

# Build the child's envp from the parent environment, inheriting every variable
# EXCEPT TERM (which puka owns — it advertises xterm-256color, not whatever
# launched puka). Reads /proc/self/environ (NUL-separated KEY=VALUE) into
# pty_env_buf, records an in-place pointer per entry into pty_env_ptrs, appends
# our TERM, NULL-terminates, and returns &pty_env_ptrs for execve. Called in the
# child after fork (its /proc/self/environ is the inherited parent env). Linux.
# A child with no HOME/PATH/SHELL is why .zshrc/starship never loaded.
fn pty__build_child_env(): i64 {
    var fd = sys_open("/proc/self/environ", 0, 0);     # O_RDONLY
    var n = 0;
    if (fd >= 0) { n = file_read(fd, &pty_env_buf, 8191); sys_close(fd); }
    if (n < 0) { n = 0; }
    store8(&pty_env_buf + n, 0);                        # hard NUL backstop
    var np = 0;
    var pos = 0;
    while (pos < n) {
        # Each entry starts at `pos` and is NUL-terminated by /proc. Drop TERM=.
        var is_term = 0;
        if (load8(&pty_env_buf + pos) == 0x54 && load8(&pty_env_buf + pos + 1) == 0x45 &&
        load8(&pty_env_buf + pos + 2) == 0x52 && load8(&pty_env_buf + pos + 3) == 0x4D &&
        load8(&pty_env_buf + pos + 4) == 0x3D) { is_term = 1; }
        if (is_term == 0) {
            if (np < 125) {                            # leave room for TERM + NULL
                store64(&pty_env_ptrs + np * 8, &pty_env_buf + pos);
                np = np + 1;
            }
        }
        var go = 1;                                    # advance past this entry's NUL
        while (go == 1) {
            if (pos >= n) { go = 0; }
            else { if (load8(&pty_env_buf + pos) == 0) { go = 0; } else { pos = pos + 1; } }
        }
        pos = pos + 1;
    }
    store64(&pty_env_ptrs + np * 8, "TERM=xterm-256color"); np = np + 1;
    store64(&pty_env_ptrs + np * 8, 0);
    return &pty_env_ptrs;
}

# Fork a child wired to the slave (setsid + TIOCSCTTY + dup2 → 0,1,2) and
# execve(path, [argv0, arg1?, arg2?], inherited-env). argv0 is `path` unless
# pty_login_argv0 is set (login shell). Returns child pid, or negative on
# failure. Must call pty_open() first.
fn pty_spawn(path, arg1, arg2, rows, cols): i64 {
    if (pty_master <= 0) { return 0 - 1; }
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        # ---- child ----
        sys_setsid();
        var s = sys_open(&pty_slave_path, PTY_O_RDWR, 0);
        if (s < 0) { sys_exit(127); }
        syscall(PTY_SYS_IOCTL, s, PTY_TIOCSCTTY, 0);
        pty_set_winsize(s, rows, cols);
        sys_dup2(s, 0);
        sys_dup2(s, 1);
        sys_dup2(s, 2);
        if (s > 2) { sys_close(s); }
        sys_close(pty_master);
        var argv[40];
        var a0 = path;
        if (pty_login_argv0 != 0) { a0 = pty_login_argv0; }   # "-zsh" → login shell
        store64(&argv, a0);
        var ai = 1;
        if (arg1 != 0) { store64(&argv + ai * 8, arg1); ai = ai + 1; }
        if (arg2 != 0) { store64(&argv + ai * 8, arg2); ai = ai + 1; }
        store64(&argv + ai * 8, 0);
        var env = pty__build_child_env();                     # inherit HOME/PATH/…, our TERM
        sys_execve(path, &argv, env);
        sys_exit(127);            # execve failed
    }
    pty_child_pid = pid;
    return pid;
}

# Pump the master into the terminal: read available bytes, feed each through
# term_feed(). Bounded — stops at EOF, or after `max_idle` consecutive empty
# (EAGAIN) polls (each ~1ms), so it can never hang. Returns bytes consumed.
fn pty_pump(max_idle): i64 {
    if (pty_master <= 0) { return 0; }
    var buf[1024];
    var total = 0;
    var idle = 0;
    var go = 1;
    while (go == 1) {
        var n = file_read(pty_master, &buf, 1024);
        if (n > 0) {
            var i = 0;
            while (i < n) { term_feed(load8(&buf + i)); i = i + 1; }
            total = total + n;
            idle = 0;
        } else {
            if (n == 0) {
                go = 0;                       # EOF: slave fully closed
            } else {
                idle = idle + 1;
                if (idle >= max_idle) { go = 0; }
                pty__nap();
            }
        }
    }
    return total;
}

# Write bytes to the child (keyboard input path; used in M4). Returns count.
fn pty_write(buf, len): i64 {
    if (pty_master <= 0) { return 0 - 1; }
    return file_write(pty_master, buf, len);
}

# Reap the child; returns its raw wait status (or 0 if none).
fn pty_wait(): i64 {
    if (pty_child_pid <= 0) { return 0; }
    var st[1];
    sys_waitpid(pty_child_pid, &st, 0);
    pty_child_pid = 0;
    return load32(&st);
}

fn pty_close(): i64 {
    if (pty_master > 0) { sys_close(pty_master); pty_master = 0; }
    return 0;
}

#endif

#ifdef CYRIUS_TARGET_AGNOS
# ============================================================================
# AGNOS-NATIVE PTY — the `#97` channel band (agnos >= 1.56.40, ipc bite 9)
# ============================================================================
# ⭐ THE KERNEL GAP THE STUBS BELOW REFERRED TO IS CLOSED. A PTY decomposes into (i) a bidirectional
# local channel, (ii) an end handed to a child at spawn, and (iii) a line discipline — only (iii) is
# terminal-specific (agnos `planning/ipc.md` §1). agnos supplies (i) and (ii) directly:
#
#   pty_open   -> `sys_chan_mint`            — no devpts, no TIOCGPTN, no slave path to build
#   pty_spawn  -> `CH_ENDOW` in PTY mode + `sys_spawn_path` — no fork, no setsid, no TIOCSCTTY
#   pty_pump   -> `sys_chan_recv`
#   pty_write  -> `sys_chan_send`
#   pty_close  -> `sys_chan_close`
#
# ⛔ THERE IS NO fork() ON agnos, AND THAT IS WHY THIS IS NOT A PORT OF THE LINUX ARM. The Linux path
# forks, opens the slave, makes it the controlling terminal, dup2's it onto 0/1/2 and execs. Here the
# KERNEL installs the endowed endpoint at the child's 0/1/2 at spawn time, so the child is *born*
# holding its terminal. The child never learns it has one: `/bin/agnsh` reads fd 0 with a plain
# `sys_read`, and that is the whole point — a channel every program must be rewritten for would be an
# API, not a PTY.
#
# ⚠ NO WINDOW SIZE. There is no TIOCSWINSZ equivalent; `rows`/`cols` are accepted and ignored so the
# call sites stay identical across targets. A resize-aware protocol is a separate piece of work, and
# faking it here would let a caller believe the child was told.

var pty_master = 0;          # our end of the channel (0 = unset; fds are > 0 after stdio)
var pty_child_pid = 0;
var pty_child_fd = 0 - 1;    # the fd index the child will hold, as returned by CH_ENDOW
var pty_login_argv0 = 0;     # accepted for source compatibility; agnos spawn takes no argv[0] override

# ⛔ a4 SENTINEL, NOT A BOOLEAN. `ksyscall_a4` doubles as a record LENGTH for SEND/RECV and is not
# cleared between ops, so PTY mode is keyed to a value no legal length can take. Must match
# `CH_ENDOW_STDIO` in agnos `kernel/core/syscall.cyr`.
var PTY_CH_ENDOW_STDIO = 1000;

# ⚠ THE RAW SYSCALL NUMBER AND OP, MIRRORED LOCALLY. The stdlib's `sys_chan_endow(fd)` takes no mode
# argument, so PTY mode needs the raw form — and the stdlib's `SYS_CHAN_OP` / `CH_ENDOW` enum members
# do not resolve from a consumer here. Values mirror cyrius `lib/syscalls_x86_64_agnos.cyr:147,174`;
# keep them in lockstep with that file, which is canonical.
# ⭐ The right fix is upstream: a `sys_chan_endow_stdio(fd)` wrapper, so no consumer hand-rolls this.
var PTY_SYS_CHAN_OP = 97;
var PTY_CH_ENDOW    = 5;

fn pty_set_winsize(fd, rows, cols): i64 { return 0; }   # see the NO WINDOW SIZE note above

fn pty_open(): i64 {
    var fds = alloc(32);
    if (sys_chan_mint(fds) != 0) { return 0 - 1; }
    pty_master = load64(fds);            # we keep this end
    pty_child_fd = load64(fds + 8);      # the end the child will be given
    return pty_master;
}

# Spawn `path` with its stdin/stdout/stderr installed on our channel's far end.
# ⚠ `arg1`/`arg2` are accepted for source compatibility and NOT passed: agnos `spawn_path #43` takes a
# path, not an argv vector. Silently dropping them would be worse than refusing, so a caller that
# supplies one gets an error rather than a child that quietly ran without its arguments.
fn pty_spawn(path, arg1, arg2, rows, cols): i64 {
    if (pty_master <= 0) { return 0 - 1; }
    if (pty_child_fd < 0) { return 0 - 1; }
    if (arg1 != 0) { return 0 - 2; }     # unsupported here — see above
    if (arg2 != 0) { return 0 - 2; }
    # PTY mode: install this endpoint at the child's fd 0, 1 AND 2. The stdlib's `sys_chan_endow`
    # takes no mode argument, so the raw form is used — a4 is the fifth argument to `syscall`,
    # matching `sys_chan_send`'s (fd, buf, len) shape.
    var cfd = syscall(PTY_SYS_CHAN_OP, PTY_CH_ENDOW, pty_child_fd, 0, PTY_CH_ENDOW_STDIO);
    if (cfd < 0) { return 0 - 1; }
    var pid = sys_spawn_path(path, strlen(path));
    if (pid < 0) { return 0 - 1; }
    pty_child_pid = pid;
    return pid;
}

# Pump the child's output into the terminal. Bounded by IDLE rounds so a slow child is tolerated but a
# dead one cannot hang the caller — same contract as the Linux arm. Returns bytes consumed.
#
# ⛔ THE IDLE WAIT IS A PREEMPTIBLE SPIN, NOT `sys_sleep_ms` AND NOT `sched_yield`. agnos
# `planning/ipc.md` §9.4: sleep_ms is `preempt_disable; sti; hlt` — it would starve the very child
# this call is waiting for — and sched_yield is a documented silent no-op under a foreground run. The
# kernel never blocks on a channel (one SYSCALL stack per CPU), so waiting is userland's job and has
# to stay preemptible or the peer never runs.
fn pty_pump(max_idle): i64 {
    if (pty_master <= 0) { return 0; }
    var buf = alloc(128);
    var total = 0;
    var idle = 0;
    var go = 1;
    while (go == 1) {
        var n = sys_chan_recv(pty_master, buf, 128);
        if (n > 0) {
            # ⭐⭐ ONLCR ON THE WAY IN FROM THE CHILD — the OUTPUT half of the line discipline.
            # agnsh (and every agnos program) emits a bare LF, because the kernel console treats LF as
            # newline AND carriage return. puka's engine is a correct VT100 where LF only moves DOWN, so
            # without this every line starts where the previous one ended: a staircase that then wraps
            # mid-word at the right edge and reads as a "wrapping" bug. Found by the 2026-08-07 iron burn.
            # Rule and full reasoning: `ld_out_needs_cr` in src/line_discipline.cyr.
            # ⚠ Gated on LD_OWNED_HERE, not on the target: on Linux devpts already applies ONLCR, and
            # doing it twice would emit a redundant CR for every line.
            var i = 0;
            while (i < n) {
                var ob = load8(buf + i);
                if (LD_OWNED_HERE == 1) { ld_out_feed(ob); }
                if (LD_OWNED_HERE == 0) { term_feed(ob); }
                i = i + 1;
            }
            total = total + n;
            idle = 0;
        }
        else {
            # ⛔ PEER_GONE IS EOF; WOULD_BLOCK IS "NOT YET". Collapsing them would either hang on a
            # dead child or abandon a live one — they are RESULTS to act on, not errors (§9.4).
            if (n == 0 - CH_E_PEERGONE) { go = 0; }
            else {
                idle = idle + 1;
                if (idle >= max_idle) { go = 0; }
                var spin = 0;
                while (spin < 20000) { spin = spin + 1; }
            }
        }
    }
    return total;
}

# ⚠ ONE RECORD PER CALL, <= 64 BYTES. The band is a RECORD transport: a longer write is an error, not
# something to split, because splitting would reintroduce message boundaries in userland — the exact
# problem the band was chosen to delete. Keystrokes are single bytes, so this bites nothing real today.
fn pty_write(buf, len): i64 {
    if (pty_master <= 0) { return 0 - 1; }
    if (len > 64) { return 0 - 1; }
    var w = sys_chan_send(pty_master, buf, len);
    if (w < 0) { return 0 - 1; }
    return w;
}

fn pty_wait(): i64 {
    if (pty_child_pid <= 0) { return 0; }
    var st = sys_waitpid(pty_child_pid);
    pty_child_pid = 0;
    return st;
}

fn pty_close(): i64 {
    if (pty_master > 0) { sys_chan_close(pty_master); pty_master = 0; }
    pty_child_fd = 0 - 1;
    return 0;
}
#endif

#ifndef CYRIUS_TARGET_LINUX
#ifndef CYRIUS_TARGET_AGNOS
# Stubs for every other target (macOS, Windows, EFI): no PTY surface.
fn pty_open(): i64 { return 0 - 1; }
fn pty_spawn(path, arg1, arg2, rows, cols): i64 { return 0 - 1; }
fn pty_pump(max_idle): i64 { return 0; }
fn pty_write(buf, len): i64 { return 0 - 1; }
fn pty_wait(): i64 { return 0; }
fn pty_close(): i64 { return 0; }
fn pty_set_winsize(fd, rows, cols): i64 { return 0 - 1; }
#endif
#endif
