# puka — terminal emulator entry point.
#
# M1 is the headless core (parser + grid + unicode + terminal). Until the
# PTY backend lands (M2) and the framebuffer renderer (M3), this entry is a
# demo: it drives a canned byte stream through the full pipe and prints the
# rendered grid to stdout — proving parse -> grid -> render end to end.

include "src/parser.cyr"
include "src/grid.cyr"
include "src/unicode.cyr"
include "src/terminal.cyr"
include "src/input.cyr"
include "src/input/evdev.cyr"
include "src/input/keymap.cyr"
include "src/line_discipline.cyr"
include "src/render/pixfmt.cyr"
include "src/render/atlas.cyr"
include "src/render/fb.cyr"
include "src/platform/setu/window_setu.cyr"
include "src/pty.cyr"

var demo_buf[256];

fn puka__say(s, n): i64 { return syscall(1, 1, s, n); }

# First-occurrence latch for the "a line reached the shell" marker. ⚠ puka's own fd 1 is the CONSOLE
# (the compositor's inherited stdio); only the CHILD's stdio rides the channel, which is why these land
# in the serial log rather than inside the terminal window.
var puka_line_marked = 0;

# kashi's built-in VGA cell is 8x16; the grid is the classic 80x24. PUKA_FRAMES = 0 means run until
# the child exits — a positive value bounds the loop for harnesses that must not hang.
var PUKA_CELL_W = 8;
var PUKA_CELL_H = 16;
var PUKA_ROWS   = 24;
var PUKA_COLS   = 80;
var PUKA_FRAMES = 0;
var PUKA_SHELL  = "/bin/agnsh";

# ⚠ Who owns the line discipline is `LD_OWNED_HERE`, declared with the discipline itself in
# `src/line_discipline.cyr` — 1 on agnos (a channel fd has none), 0 on Linux (devpts already cooks and
# echoes, so running ours would double-echo). It is a variable, not an `#ifdef` here, so both paths
# compile on both targets and the cooked path is reachable from the host test.

fn puka_demo(): i64 {
    term_init(24, 80);
    # bold-green word via SGR (stripped by the text renderer), a UTF-8
    # check mark (U+2713), CR/LF, then a CJK glyph (width 2) and cursor moves.
    term_feed_str("puka \x1b[1;32mterminal\x1b[0m \xe2\x9c\x93\r\n");
    term_feed_str("VT parser + cell grid + UTF-8 \xe4\xb8\xad, sovereign Cyrius.\r\n");
    term_feed_str("\x1b[5Cindented via CUF.\r\n");

    var r = 0;
    while (r < grid_get_rows()) {
        var n = term_render_row_trim(r, &demo_buf, 256);
        if (n > 0) {
            syscall(1, 1, &demo_buf, n);
            syscall(1, 1, "\n", 1);
        }
        r = r + 1;
    }
    return 0;
}

# Send a completed line to the child, in records the band will accept.
#
# ⚠ `pty_write` is ONE RECORD PER CALL, <= 64 BYTES — the band is a record transport and a longer send is
# a framing error, not something it splits for you. A typed line can exceed that (the grid is 80 columns),
# so the line is handed over in <= 64-byte pieces. ⭐ That is not a carve-out invented here: the kernel
# already rules on it for exactly this case, at `agnos/kernel/core/syscall.cyr:7257-7266` — "write(2) IS A
# BYTE STREAM; CH_SEND IS A RECORD. THE DIFFERENCE IS DELIBERATE … a stream writer's bytes arrive as
# several records — which is exactly what a tty does", added because agnsh's own banner exceeds 64 bytes in
# one write. Record boundaries still hold; a PTY's stdin simply is not a message stream, and agnsh's
# `read_line` accumulates across reads by design.
#
# ⛔ A REFUSED WRITE STOPS THE LINE, IT DOES NOT RETRY. `pty_write` <= 0 means the peer is gone or the
# record was rejected; spinning would burn the frame loop against a dead shell. Returns bytes delivered.
fn puka__send_line(p, n): i64 {
    var off = 0;
    while (off < n) {
        var chunk = n - off;
        if (chunk > 64) { chunk = 64; }
        var w = pty_write(p + off, chunk);
        if (w <= 0) { return off; }
        off = off + w;
    }
    return off;
}

# Deliver one encoded keypress to the child, through the line discipline when we own it.
#
# ⛔ ECHO IS THIS FUNCTION'S JOB AND NOTHING ELSE'S. agnsh does not echo — deliberately, because on the
# console "the kernel now owns echo + line discipline" (`agnoshi/src/agnsh.cyr:274`) — and a channel fd
# has no kernel echo. That is the second half of why the panel's glyph count never moved: even a byte
# that arrived perfectly was invisible. `term_feed` is the same entry `pty_pump` uses for child output,
# so an echoed character and a shell-printed one land in the grid by one path.
fn puka_input_deliver(kb, kn): i64 {
    if (LD_OWNED_HERE == 0) { return pty_write(kb, kn); }
    var i = 0;
    while (i < kn) {
        var act = ld_feed(load8(kb + i));
        if (act == LD_ECHO) {
            term_feed(ld_echo());
        }
        if (act == LD_ERASE) { term_feed(0x08); term_feed(0x20); term_feed(0x08); }
        # ⚠ A REFUSAL IS REPORTED, ALWAYS. `puka-terminal-test.py` counts these, and a byte the
        # discipline declines is the one case where the screen and the child legitimately differ from
        # what was typed — so it must never be inferred from silence.
        if (act == LD_DROP) { puka__say("puka: byte refused by the line discipline\n", 42); }
        if (act == LD_LINE) {
            # ⭐ THE MARKER THAT SEPARATES TWO DIFFERENT BUGS. Its presence means a CR arrived and a
            # line was handed to the child; its absence with keys missing means Enter never arrived at
            # all. `puka-terminal-test.py` reads exactly this to decide which layer to blame.
            if (puka_line_marked == 0) { puka_line_marked = 1; puka__say("puka: line sent to the shell\n", 29); }
            # The child is sent LF alone; the GRID gets CR+LF, because the cursor has to come back to
            # column 0 as well as move down — a bare LF would stair-step every line to the right.
            term_feed(0x0D);
            term_feed(0x0A);
            puka__send_line(ld_line(), ld_line_len());
        }
        i = i + 1;
    }
    return kn;
}

# ⭐⭐ THE TERMINAL. Window + PTY + engine + renderer, wired end to end — a real shell hosted in a
# composited window. This is what M1's demo was a placeholder for, and on agnos it is the remaining
# half of ipc bite 9 ("a live agnsh prompt in a composited window").
#
# The loop is deliberately small, because every hard part already lives behind a seam:
#   pty_pump   -> reads the child and feeds term_feed  (src/pty.cyr; on agnos, the #97 channel band)
#   fb_render  -> paints the cell grid into an RGB buffer
#   pix_blit   -> RGB -> the backend's XRGB8888 present buffer
#   win_*      -> setu (src/platform/setu/window_setu.cyr)
#
# Returns 0 on a clean exit, or -1 when no window/PTY is available so the caller can fall back.
fn puka_terminal(rows, cols, frames): i64 {
    term_init(rows, cols);
    fb_init(PUKA_CELL_W, PUKA_CELL_H);
    ld_init();
    # ⚠ SAY WHICH STEP FAILED. All three failures below look identical from outside — a blank window,
    # or no window at all — and on agnos three processes share one console, so a numeric code printed
    # here lands mid-line inside another proc's output. Distinct ASCII lines survive interleaving.
    if (win_open("puka", 4, cols, rows, PUKA_CELL_W, PUKA_CELL_H, 0) == 0) {
        puka__say("puka: no display -- win_open failed (falling back to the demo)\n", 63);
        return 0 - 1;
    }
    if (pty_open() < 0) {
        puka__say("puka: no pty -- pty_open failed\n", 32);
        win_close(0); return 0 - 1;
    }
    # ⚠ Spawned with NO argv. `pty_spawn` refuses arg1/arg2 on agnos rather than dropping them
    # silently, because `spawn_path #43` takes a path and not an argv vector — a shell that quietly
    # ignored its flags would be worse than one that refuses to start.
    if (pty_spawn(PUKA_SHELL, 0, 0, rows, cols) < 0) {
        puka__say("puka: shell would not spawn\n", 28);
        pty_close(); win_close(0); return 0 - 1;
    }
    puka__say("puka: terminal up -- 80x24, shell on a pty\n", 43);

    var f = 0;
    var live = 1;
    while (live == 1) {
        # ⚠ A SMALL IDLE BUDGET, NOT A BLOCKING READ. `pty_pump` returns once the child has been
        # quiet for `max_idle` rounds, so a silent shell costs one cheap poll per frame instead of
        # stalling the frame loop — the same "the batch IS the poll" shape the channel band is built
        # around (agnos planning/ipc.md §9.4).
        pty_pump(2);

        fb_render();
        var dst = win_present_begin(0);
        if (dst != 0) {
            pix_blit_region(fb_buf(), fb_width(), 0, fb_height(), dst, fb_width());
            var prc = win_present_commit(0, 0, 0, fb_width(), fb_height());
            if (f == 0) {
                if (prc == 0) { puka__say("puka: first present ok\n", 23); }
                else { puka__say("puka: first present REFUSED\n", 28); }
            }
        }
        else { if (f == 0) { puka__say("puka: no present buffer\n", 24); } }

        # ⭐ INPUT: compositor -> engine -> child. `win_poll_events` latches one key per frame and
        # `win_next_key` hands it over as [evdev keycode, mods, state] — the SAME shape the Wayland
        # backend produces, so `input_from_keycode` (the shared keycode->child-bytes bridge) does the
        # encoding for both. That is why arrows and named keys come out as proper CSI sequences here
        # instead of a hand-rolled byte: the encode discipline already existed and is not duplicated.
        # ⚠ CALLED ONCE, RESULT CAPTURED. `win_poll_events` CONSUMES a message per call, so testing its
        # return value twice would drop every other event — which is why this is a variable and not two
        # calls.
        var wev = win_poll_events(0);
        # ⛔⛔ THE COMPOSITOR CLOSED OUR WINDOW (setu `SETU_CLOSE`, or a dead wayland connection). Leave
        # the loop so `pty_close` + `win_close` below run: that teardown, and the process exit after it,
        # is what releases the `#97` channel end and the `#86` GPU-visible shm slot back to the kernel.
        # ⚠ Until this landed, aethersafha's F4 removed the window and told nobody, so puka kept running
        # forever — on the 2026-08-08 iron burn the terminal was left orphaned ALIVE holding one of only
        # 16 system-wide shm slots for the rest of the boot. "Not closing properly", exactly as reported.
        # ⚠ TESTED AS A BIT, NOT FOR EQUALITY. `WIN_EV_*` are powers of two and the wayland backend ORs
        # them together (src/platform/window.cyr:100-108), so `CLOSE | FRAME` is a value this can really
        # carry. The setu backend returns one event at a time, so equality happens to work there — which
        # is exactly the kind of accident that holds until the other backend is used.
        if ((wev & WIN_EV_CLOSE) != 0) {
            puka__say("puka: compositor closed the window -- exiting\n", 46);
            live = 0;
        }
        # ⚠ LEFT AS EQUALITY, DELIBERATELY, and it is mask-fragile: on the wayland path a frame that
        # carries both a key and a frame-done reports `KEY | FRAME` and this test misses the key. That is
        # a latent host-build defect, not an agnos one (the setu backend returns single events), and
        # fixing it changes behaviour on a path this change does not exercise. Recorded, not silently
        # altered — see the note above for why the CLOSE test above does use a bit test.
        if (wev == WIN_EV_KEY) {
            var kev = alloc(32);
            if (win_next_key(0, kev) == 1) {
                # ⭐ ONE LINE PER KEY, ON PURPOSE — this is a COUNT, not a first-occurrence latch.
                # `puka-terminal-test.py` counts these against the number it typed, so a run that loses
                # keystrokes says so instead of looking like a line-discipline failure. The two have
                # different causes in different layers: keys are produced by the xHCI HID ring and are
                # only drained inside `kbscan #42`'s bounded sti window (agnos
                # `kernel/core/syscall.cyr:8746-8757`), so a slow compositor frame can miss one.
                # Measured: 1 run in 3 lost several keys INCLUDING Enter, which presents as "the shell
                # never answered" while every byte that did arrive was handled correctly.
                puka__say("puka: key received\n", 19);
                var kb = alloc(32);
                var kn = input_from_keycode(load64(kev), load64(kev + 8), kb);
                if (kn > 0) { puka_input_deliver(kb, kn); }
            }
        }

        f = f + 1;
        if (frames > 0) { if (f >= frames) { live = 0; } }
    }

    pty_close();
    win_close(0);
    return 0;
}

fn main(): i64 {
    alloc_init();
    args_init();
    # ⛔ THE DEMO IS THE FALLBACK, NOT THE DEFAULT-BY-ACCIDENT. puka tries to be a terminal first and
    # only prints the M1 canned stream when there is no compositor to host it — so a missing display
    # server degrades to something visible instead of an empty screen, and CI (which has no
    # compositor) still exercises the parse -> grid -> render path exactly as it did before.
    # ⛔ SKIP THE DASHES BEFORE COMPARING. This read `load8(argv(1)) == 100` ('d') against the FIRST
    # byte, which for `--demo` is '-' (45) — so the flag never matched and `--demo` reached the demo
    # only by falling through the terminal path and failing. It printed two failure lines on the way,
    # which is exactly what an explicitly-requested mode must not do.
    if (argc() > 1) {
        var a = argv(1);
        var di = 0;
        while (load8(a + di) == 45) { di = di + 1; }              # skip leading '-'
        if (load8(a + di) == 100) { puka_demo(); return 0; }      # 'd' -> -d / --demo
    }
    if (puka_terminal(PUKA_ROWS, PUKA_COLS, PUKA_FRAMES) == 0) { return 0; }
    puka_demo();
    return 0;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
