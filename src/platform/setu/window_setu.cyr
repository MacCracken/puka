# window_setu.cyr — puka's win_* window backend over the setu native display
# protocol (setu_client_*, [deps.setu]).
#
# Fills the SAME win_* contract as the Wayland backend (src/platform/window.cyr,
# ADR-0002) so the terminal engine + puka__paint run UNCHANGED — this is the
# "AGNOS backend fills the identical contract, a MOVE not a rewrite" the seam was
# designed for. Include this INSTEAD OF the wayland backend files
# (wire/client/shm/window); the two define the same win_* names, so exactly one
# backend compiles into any program.
#
# The client renders its cell grid into a CPU XRGB8888 buffer (via puka's
# pix_blit_region — bytes [B,G,R,X] == setu fmt 1) and presents the whole surface
# each frame over setu (ATTACH + inline pixels + COMMIT). Input over setu is a
# later bite (gated on the compositor's real key-forwarding); win_poll_events /
# win_next_key are present-parity stubs for now. Linux-first (setu AF_UNIX);
# agnos when the agnos transport (item 3b, native-display-protocol.md) lands.
#
# ⛔ ITEM 3b LANDED AS TCP-ON-LOOPBACK AND HAS BEEN RETIRED (2026-08-03) — as the WRONG
# PRIMITIVE for a local display protocol (nothing to route, nothing to checksum, no window to
# negotiate, no business owning a port), NOT because it never worked. Scope the history:
# BEFORE `net_src_for` (agnos 1.56.34) it could not complete a compositor↔client handshake on
# an ordinary boot, and the only test that passed in that era did so because the
# `AETHERSAFHA_SETU_SELFTEST` kernel hook assigned `net_ip = 0x7F000001`, making a loopback
# SYN's source and destination agree by accident — hook and smoke are deleted, and claims
# resting on them are FALSE GREENS. AFTER `net_src_for` it did work un-rigged: on 2026-08-02
# the hook-scanning harness `aethersafha-clients-test.py` reached "connected: 2, presented: 2"
# with setu's `present_probe` (staged as `/bin/puka`) as one of the two clients (QEMU,
# `-smp 1`; never on iron, `-smp 4` fault-kills). The replacement transport is the agnos socket
# (`anu`) — agnos `docs/development/planning/ipc.md` §9/§10. This win_* backend is unaffected
# in shape; only what `setu_client_connect` dials changes.
# ⛔ CORRECTED 2026-08-12: this said the path was "ADVISORY and always was — setu ignores it". FALSE
# since setu 0.8.4 — `setu_un_path` honours it — and since 0.8.5 setu also resolves `$SETU_SOCKET`.
#
# Co-compiled after [deps.setu]'s dist (setu_client_*); includes nothing.

enum WinAbi {
    WIN_EV_NONE   = 0;
    WIN_EV_RESIZE = 1;
    WIN_EV_KEY    = 2;
    WIN_EV_CLOSE  = 4;
    WIN_EV_FRAME  = 8;
    WIN_CAP_SHM   = 0;     # win_present_begin returns a CPU pixel buffer
    WIN_CAP_GPU   = 1;
}

var win_w = 0;
var win_h = 0;
var setuwin_client = 0;   # *SetuClient (setu_client_connect)
var setuwin_buf    = 0;   # persistent XRGB8888 present buffer (win_w*win_h*4)

fn win_backend_select(): i64 { return 1; }   # 1 = setu (0 = wayland)

# Connect to the compositor's setu socket ($SETU_SOCKET or the default), size the
# surface to the grid (cols*cell_w x rows*cell_h), and allocate the persistent
# present buffer. Returns an opaque handle (1) or 0 on connect failure. gpu_ctx
# is ignored (CPU present path).
fn win_open(title, tlen, cols, rows, cell_w, cell_h, gpu_ctx): i64 {
    # 0 = ask setu, which resolves `$SETU_SOCKET` then `SETU_UNIX_PATH` since 0.8.5. ⭐ puka's own
    # getenv is GONE, not because it was wrong — it was the only one of three clients that got the
    # override right — but because one implementation in setu makes all three agree by construction.
    var path = 0;
    # ⭐ THROUGH dhancha (2026-08-16). `dh_client_connect` is a one-line delegation to this same setu
    # entry point, so behaviour is identical; what changes is that the transport seam is now the shared
    # toolkit's. When the wire moves again — it has twice, TCP -> AF_UNIX -> the agnos `#97` channel band
    # — consumers routed through dhancha follow, and ones that are not get left behind silently. dhancha
    # itself was left behind exactly that way (pinned setu 0.7.4 across the cutover, fixed in 0.9.4).
    var c = dh_client_connect(path);
    # ⚠ SAY IT. A silent 0 here is indistinguishable from "no compositor running", and the cause is
    # usually neither: a client built against a pre-cutover setu has no agnos arm at all and fails
    # with none of setu's own refusal messages. (Measured: puka pinned setu 0.7.4 and did exactly
    # that.) The floor is setu >= 0.8.0 on agnos.
    if (c == 0) { syscall(1, 1, "setuwin: setu connect refused\n", 30); return 0; }
    setuwin_client = c;
    win_w = cols * cell_w;
    win_h = rows * cell_h;
    var nbytes = win_w * win_h * 4;
    setuwin_buf = alloc(nbytes);
    if (setuwin_buf == 0) { syscall(1, 1, "setuwin: present-buffer alloc FAILED\n", 37); return 0; }
    memset(setuwin_buf, 0, nbytes);
    return 1;
}

fn win_caps(win): i64 { return WIN_CAP_SHM; }
fn win_fd(win): i64 { return dh_client_fd(setuwin_client); }
fn win_size_px(win, out16): i64 { store64(out16, win_w); store64(out16 + 8, win_h); return 0; }

# CPU path: the XRGB8888 buffer puka blits into. It persists across frames so the
# damage-aware row blits accumulate — setu presents the WHOLE surface each COMMIT.
fn win_present_begin(win): i64 { return setuwin_buf; }

# Present the whole surface over setu (first present lazily CREATEs it, then
# ATTACH + inline pixels + COMMIT). The (x,y,w,h) damage rect is accepted for
# win_* parity but setu has no partial-damage present yet, so the full buffer
# ships each frame. Returns 0 or setu_client_present's negative code.
fn win_present_commit(win, x, y, w, h): i64 {
    return setu_client_present(setuwin_client, setuwin_buf, win_w, win_h);
}

# ⭐ INPUT. The compositor forwards SETU_INPUT_KEY with the **HID usage code** (`bhumi_key_usage`),
# not a codepoint and not an evdev keycode — so the seam has to translate before handing anything to
# the engine, which speaks evdev like the Wayland backend does.
#
# ⭐ HID usage -> evdev keycode IS the PS/2 set-1 make code for the main block, because Linux derived
# its keycodes from set-1: Esc 1, digits 2..11, A 30, Enter 28, Backspace 14, Tab 15, Space 57. The
# agnos kernel carries the same mapping for its own console (`hid_usage_to_ps2`,
# `arch/x86_64/usb/hid_translate.cyr`) — this is that table's shape, not a second invention.
#
# ⛔ RETURNS 0 FOR AN UNMAPPED USAGE, and the caller must drop it rather than send a byte. Emitting a
# wrong keycode is worse than emitting none: it would type a plausible character the user did not press.
fn setuwin__hid_to_evdev(u): i64 {
    if (u >= 0x04) { if (u <= 0x1D) {                    # a..z
        # a..m then n..z, split only to stay inside the 120-column lint.
        var la = "\x1E\x30\x2E\x20\x12\x21\x22\x23\x17\x24\x25\x26\x32";
        var lb = "\x31\x18\x19\x10\x13\x1F\x14\x16\x2F\x11\x2D\x15\x2C";
        if (u <= 0x10) { return load8(la + (u - 0x04)); }
        return load8(lb + (u - 0x11));
    } }
    if (u >= 0x1E) { if (u <= 0x26) { return 2 + (u - 0x1E); } }   # 1..9 -> 2..10
    if (u == 0x27) { return 11; }                                   # 0
    if (u == 0x28) { return 28; }                                   # Enter
    if (u == 0x29) { return 1; }                                    # Esc
    if (u == 0x2A) { return 14; }                                   # Backspace
    if (u == 0x2B) { return 15; }                                   # Tab
    if (u == 0x2C) { return 57; }                                   # Space
    if (u == 0x2D) { return 12; }                                   # -
    if (u == 0x2E) { return 13; }                                   # =
    if (u == 0x2F) { return 26; }                                   # [
    if (u == 0x30) { return 27; }                                   # ]
    if (u == 0x31) { return 43; }                                   # backslash
    if (u == 0x33) { return 39; }                                   # ;
    if (u == 0x34) { return 40; }                                   # '
    if (u == 0x35) { return 41; }                                   # `
    if (u == 0x36) { return 51; }                                   # ,
    if (u == 0x37) { return 52; }                                   # .
    if (u == 0x38) { return 53; }                                   # /
    if (u == 0x4F) { return 106; }                                  # Right
    if (u == 0x50) { return 105; }                                  # Left
    if (u == 0x51) { return 108; }                                  # Down
    if (u == 0x52) { return 103; }                                  # Up
    return 0;                                                       # unmapped — caller drops it
}

# Poll the compositor for one inbound message. Returns WIN_EV_KEY when a key was latched,
# else WIN_EV_NONE. One message per call: `setu_client_poll_input` hands out one frame at a time.
var setuwin_key_code = 0;
var setuwin_key_mods = 0;
var setuwin_key_have = 0;

fn win_poll_events(win): i64 {
    if (setuwin_client == 0) { return WIN_EV_NONE; }
    var m = setu_msg_new();
    if (setu_client_poll_input(setuwin_client, m) != 1) { return WIN_EV_NONE; }
    # ⛔⛔ THE COMPOSITOR CLOSED OUR WINDOW. Report it as `WIN_EV_CLOSE` — the platform layer already
    # has that event because the wayland backend raises it (src/platform/window.cyr:18, :101), so the
    # engine above needs no new vocabulary, only this wire.
    # ⚠ Until this landed, aethersafha's F4 removed the window from its own list and told nobody, so
    # puka kept running: on the 2026-08-08 iron burn the terminal was left **orphaned alive** with its
    # `#97` channel end and its `#86` GPU-visible shm slot held for the rest of the boot — and there
    # are only 16 of those slots system-wide. Our EXIT is what releases them.
    # ⚠ `SETU_CLOSE` (kind 7) has always been in the protocol; it was never sent and never handled.
    if (setu_msg_kind(m) == SETU_CLOSE) { return WIN_EV_CLOSE; }
    if (setu_msg_kind(m) != SETU_INPUT_KEY) { return WIN_EV_NONE; }
    var code = setuwin__hid_to_evdev(setu_msg_arg(m, 1));
    if (code == 0) { return WIN_EV_NONE; }               # unmapped usage — drop, never guess
    setuwin_key_code = code;
    # ⚠ MODS ARE ALWAYS 0 HERE, DELIBERATELY. A press-only surface (the default, and what a terminal
    # wants — FULL_KEYS would double-type every character) carries no modifier state in this message,
    # and the compositor does not forward the HID modifier byte as a usage. So Shift-ed characters are
    # NOT yet reachable: the engine sees an unshifted keycode. Stated rather than faked, because
    # inventing a mods value here would silently produce the wrong glyph.
    setuwin_key_mods = 0;
    setuwin_key_have = 1;
    return WIN_EV_KEY;
}

fn win_resize_apply(win): i64 { return 0; }              # setu: no compositor-driven resize yet

# Hand out the latched key as [evdev keycode, mods, state=press]. Returns 1 when one was waiting.
fn win_next_key(win, out24): i64 {
    if (setuwin_key_have == 0) { return 0; }
    setuwin_key_have = 0;
    store64(out24, setuwin_key_code);
    store64(out24 + 8, setuwin_key_mods);
    store64(out24 + 16, 1);
    return 1;
}
fn win_close(win): i64 { dh_client_close(setuwin_client); return 0; }
