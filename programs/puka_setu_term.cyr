# puka_setu_term.cyr — puka's REAL terminal (PTY + $SHELL) rendering over setu.
#
# The first resident's core: spawns the user's shell on a PTY and renders its
# LIVE output through the setu window backend (window_setu.cyr) to the aethersafha
# compositor — the whole stack, PTY → parser → grid → fb → setu → compositor,
# with a real shell (not the hand-fed text of puka_setu_probe).
#
# Interactive KEYBOARD input over setu is the next gate: it needs the compositor's
# real key-forwarding (aethersafha currently sends a demo key) plus a live
# keyboard source (the headless Linux compositor has none; that path is agnos +
# item 3b). So to show live output here without interactive input, a scripted
# command is written to the shell, its output drained until it settles, then the
# final frame is presented over setu. The loop structure is the real terminal's;
# only the key source is stubbed.
#
# Build: cyrius build programs/puka_setu_term.cyr build/puka_setu_term
# Run  : (aethersafha's setu_demo_probe listening) ./build/puka_setu_term

include "src/parser.cyr"
include "src/grid.cyr"
include "src/unicode.cyr"
include "src/terminal.cyr"
include "lib/kashi_font_data.cyr"
include "src/render/fb.cyr"
include "src/render/pixfmt.cyr"
include "src/pty.cyr"
include "src/platform/setu/window_setu.cyr"

enum PstLoop { SYS_POLL = 7; POLLIN = 1; }

# Drain all currently-available child output (non-blocking) into the grid.
fn pst_drain(): i64 {
    var buf[2048];
    var total = 0;
    var go = 1;
    while (go == 1) {
        var n = file_read(pty_master, &buf, 2048);
        if (n <= 0) { go = 0; }
        else {
            var i = 0;
            while (i < n) { term_feed(load8(&buf + i)); i = i + 1; }
            total = total + n;
        }
    }
    return total;
}

# Render the grid into puka's RGB fb, convert to the XRGB present buffer, present
# once over setu (CREATE on first present + ATTACH + pixels + COMMIT).
fn pst_paint(win): i64 {
    fb_render();
    var dst = win_present_begin(win);
    if (dst == 0) { return 0; }
    pix_blit_region(fb_buf(), fb_width(), 0, fb_height(), dst, win_w);
    return win_present_commit(win, 0, 0, win_w, fb_height());
}

fn main(): i64 {
    alloc_init();
    var win = win_open("puka", 4, 40, 12, 8, 16, 0);
    if (win == 0) {
        var e = "puka_setu_term: setu connect failed (is aethersafha listening?)\n";
        syscall(SYS_WRITE, 2, e, strlen(e));
        return 1;
    }
    term_init(12, 40);
    fb_init(8, 16);

    var shell = getenv("SHELL");
    if (shell == 0) { shell = "/bin/sh"; }
    pty_login_argv0 = 0;                              # non-login shell (proof)
    if (pty_open() < 0) {
        syscall(SYS_WRITE, 2, "puka_setu_term: pty_open failed\n", 31); win_close(win); return 1;
    }
    if (pty_spawn(shell, 0, 0, 12, 40) < 0) {
        syscall(SYS_WRITE, 2, "puka_setu_term: shell spawn failed\n", 35); pty_close(); win_close(win); return 1;
    }

    # Scripted input (keyboard-over-setu is the next gate). Short lines fit 40 cols.
    var cmd = "echo first resident from puka; uname -sm\n";
    pty_write(cmd, strlen(cmd));

    # Drain the shell's output until it settles (3 consecutive quiet 200ms polls),
    # capped so a hung child can't wedge the proof. Then present the final frame.
    var pfds[16];
    var idle = 0;
    var cyc = 0;
    while (idle < 3) {
        if (cyc >= 40) { idle = 3; }
        else {
            store32(&pfds, pty_master); store32(&pfds + 4, POLLIN);
            var pr = syscall(SYS_POLL, &pfds, 1, 200);
            if (pr > 0) { if (pst_drain() > 0) { idle = 0; } else { idle = idle + 1; } }
            else { idle = idle + 1; }
            cyc = cyc + 1;
        }
    }

    var rc = pst_paint(win);
    win_close(win);
    pty_close();

    if (rc < 0) {
        var e2 = "puka_setu_term: present failed\n";
        syscall(SYS_WRITE, 2, e2, strlen(e2));
        return 1;
    }
    var ok = "puka_setu_term: live shell output presented over setu.\n";
    syscall(SYS_WRITE, 1, ok, strlen(ok));
    return 0;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
