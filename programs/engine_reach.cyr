# engine_reach.cyr — dist/puka.cyr as a consumer gets it, and CI's gate on the bundle.
#
# Built with `--no-deps`, so nothing is in scope but the two includes below and what the bundle's
# requires block pulls in. kashi is the one dependency a consumer declares itself. A bundle with no
# requires block, or a short one, does not compile here. Every stdlib call the engine makes is reached:
# `alloc` through term_init and fb_init, `strlen` through term_feed_str, and the `io` calls and `O_*`
# flags through fb_dump_ppm. See docs/architecture/001-dependencies.md.

include "lib/kashi_font_data.cyr"
include "dist/puka.cyr"

fn main(): i64 {
    alloc_init();
    kashi_font_init();
    term_init(4, 20);
    fb_init(8, 16);
    term_feed_str("hi");
    fb_render_full();
    if (fb_dump_ppm("build/engine_reach.ppm") <= 0) { return 1; }
    return 0;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
