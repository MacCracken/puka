# pty.tcyr — PTY plumbing integration test (Bite 5 / M2).
#
# Spawns a REAL child process through a pseudo-terminal and asserts its
# output lands in the grid via the full pipe (pty -> term_feed -> parser ->
# grid). Linux-only and skip-clean: if a sandbox/seccomp policy blocks
# /dev/ptmx or fork, it prints a SKIP marker and passes trivially rather
# than faking a result (matching darshana/tests/pty.tcyr discipline).

include "src/parser.cyr"
include "src/grid.cyr"
include "src/unicode.cyr"
include "src/terminal.cyr"
# ⚠ line_discipline.cyr is required because pty.cyr's agnos `pty_pump` applies ONLCR through it
# (`LD_OWNED_HERE` + `ld_out_needs_cr`). It is PURE — no syscalls, no deps, includes nothing — so adding
# it to a unit costs nothing. ⛔ A cyrius VARIABLE forward-reference does not resolve and an undefined
# FUNCTION is a hard error, so a cross-module reference added to pty.cyr breaks every test unit that
# compiles pty.cyr without this line, while `cyrius build src/main.cyr` stays green. Run `cyrius test`.
include "src/line_discipline.cyr"
include "src/pty.cyr"

var prow[256];

fn row_eq(r, expected): i64 {
    var n = term_render_row_trim(r, &prow, 256);
    var m = strlen(expected);
    if (n != m) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(&prow + i) != load8(expected + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn skip(reason) {
    syscall(1, 1, "SKIP pty: ", 10);
    syscall(1, 1, reason, strlen(reason));
    syscall(1, 1, "\n", 1);
    return 0;
}

fn main() {
    alloc_init();

    test_group("pty: spawn echo, capture output in grid");

#ifdef CYRIUS_TARGET_LINUX
    term_init(24, 80);
    var m = pty_open();
    if (m < 0) {
        skip("/dev/ptmx unavailable (sandbox)");
        assert(1, "skipped: no pty");
    } else {
        var pid = pty_spawn("/bin/echo", "hello world", 0, 24, 80);
        if (pid < 0) {
            skip("fork/spawn blocked");
            pty_close();
            assert(1, "skipped: no spawn");
        } else {
            # ⛔⛔ WAIT FOR THE END STATE, NOT FOR A QUIET PERIOD. This was a single
            # `pty_pump(200)`, and `pty_pump` returns after N CONSECUTIVE EMPTY READS — which is not
            # the same fact as "the child is done". `/bin/echo` writes "hello world\n" and the pts
            # expands it to "hello world\r\n"; when a loaded runner splits that across two reads,
            # the idle budget can expire between them, leaving row 0 correct and the cursor still on
            # row 0. CI 2026-08-19 failed exactly that way — `cursor advanced past the echoed line
            # (got 0, expected 1)` with the row assertion passing — while it passed 6/6 locally.
            # ⇒ Pump until the terminal reaches the state under test, with a BOUNDED total so a
            # child that never writes still fails (and fails for the right reason) instead of
            # hanging. Each round is a full idle budget, so a slow child gets ~40x the old wait.
            var rounds = 0;
            while (rounds < 40) {
                pty_pump(20);
                if (grid_cursor_row() > 0) { rounds = 40; }
                if (grid_cursor_row() == 0) { rounds = rounds + 1; }
            }
            pty_wait();
            pty_close();
            # /bin/echo writes "hello world\n"; the pts maps \n -> \r\n, so
            # the grid shows "hello world" on row 0 and the cursor drops to row 1.
            assert(row_eq(0, "hello world"), "row 0 == 'hello world' from real child");
            assert_eq(grid_cursor_row(), 1, "cursor advanced past the echoed line");
        }
    }
#endif

#ifndef CYRIUS_TARGET_LINUX
    skip("pty backend is Linux-only (agnos PTY is M5)");
    assert(1, "skipped: non-linux target");
#endif

    return assert_summary();
}

fn _entry(): i64 { var rc = main(); syscall(SYS_EXIT, rc); return 0; }
_entry();
